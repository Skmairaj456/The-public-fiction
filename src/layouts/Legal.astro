---
import Base from './Base.astro';
import SplitHeading from '@/components/SplitHeading.astro';
import SectionHead from '@/components/SectionHead.astro';
import { site } from '@/config/site';

interface Props {
  title: string;
  description: string;
  lines: string[];
}
const { title, description, lines } = Astro.props;
---

<Base title={title} description={description}>
  <section class="page-intro">
    <div class="wrap">
      <SectionHead label={title} aside={`Last updated ${site.legal.lastUpdated}`} />
      <SplitHeading as="h1" class="stack" lines={lines} />
    </div>
  </section>
  <section class="wrap legal">
    <div class="prose card legal__card">
      <slot />
    </div>
  </section>
</Base>

<style>
  .legal {
    padding-bottom: var(--section);
  }
  .legal__card {
    max-width: 880px;
    margin-left: auto;
    padding: clamp(24px, 4vw, 56px);
  }
</style>
