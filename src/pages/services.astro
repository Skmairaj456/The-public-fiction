---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SplitHeading from '@/components/SplitHeading.astro';
import SectionHead from '@/components/SectionHead.astro';
import Process from '@/components/Process.astro';
import Button from '@/components/Button.astro';
import Sticker from '@/components/Sticker.astro';
import type { StickerName } from '@/lib/stickers';
import { services } from '@/data/services';
import PriceFrom from '@/components/PriceFrom.astro';
import { breadcrumbs } from '@/lib/seo';
import { site } from '@/config/site';

const icons: StickerName[] = ['star', 'megaphone', 'bubble', 'camera', 'clapper', 'smiley', 'bolt'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${site.name} services`,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title,
      url: new URL(`/services/${s.slug}/`, site.url).href,
    })),
  },
  breadcrumbs([{ name: 'Services', path: '/services/' }]),
];
---

<Base
  title="Services: Branding, Social Media Marketing, Reels & Video Production"
  description="Branding and identity, social media marketing, Reels and short-form video, photography and video production, advertising, events and web design in one team."
  schema={schema}
>
  <section class="page-intro">
    <div class="wrap">
      <SectionHead label="What we do" aside={`${services.length} disciplines`} />
      <h1 class="sv-mega" data-split aria-label="Services">
        <span class="lm" aria-hidden="true"><span class="mega" data-fit>Services</span></span>
      </h1>
      <div class="sv-intro">
        <SplitHeading as="p" class="stack" lines={['~Seven disciplines.', '>One team.']} />
        <p class="lede" data-reveal>
          Branding, social media marketing, Reels, photography, video production, advertising and design under one roof, so the
          idea that wins the room is the same idea that reaches the audience.
        </p>
      </div>
      <nav class="sv-jump" aria-label="Jump to a service" data-reveal>
        {
          services.map((s) => (
            <a class="chip" href={`#${s.slug}`}>
              {s.number} · {s.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <div class="wrap sv-list">
    {
      services.map((s, i) => (
        <section class:list={['sv-item', i % 2 === 1 && 'sv-item--flip']} id={s.slug} aria-labelledby={`${s.slug}-title`}>
          <div class="sv-item__media media" data-reveal-img>
            <Picture src={s.image} alt={s.imageAlt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 55vw" formats={['avif', 'webp']} />
            <span class="sv-item__over mega" aria-hidden="true">
              {s.title}
            </span>
          </div>
          <div class="sv-item__body card">
            <div class="sv-item__top">
              <span class="sv-item__n">/{s.number}</span>
              <Sticker name={icons[i % icons.length]} class="sv-item__stk" />
            </div>
            <h2 id={`${s.slug}-title`} class="h-m">
              <a class="sv-item__link" href={`/services/${s.slug}/`}>{s.title}</a>
            </h2>
            <p class="sv-item__line">{s.line}</p>
            <p class="muted">{s.description}</p>
            <PriceFrom slug={s.slug} />
            <ul class="sv-item__list" aria-label={`${s.title} includes`}>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="sv-item__ctas">
              <Button href={`/contact/?service=${s.slug}`} variant="lime">
                Start a project like this
              </Button>
              <Button href={`/services/${s.slug}/`} variant="ghost">
                More about {s.title}
              </Button>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section class="section" aria-labelledby="process-title">
    <div class="wrap">
      <SectionHead label="How it works" aside="Five stages" />
      <SplitHeading id="process-title" class="stack sv-process" lines={["~Good work doesn't", '>happen by', '>>accident.']} />
      <Process />
    </div>
  </section>

  <section class="section theme-dark sv-cta">
    <div class="wrap">
      <SplitHeading class="mega mega--m lime" lines={['Not sure which', 'one you need?']} />
      <div class="sv-cta__foot" data-reveal>
        <p class="lede muted">Most projects use more than one. Tell us the problem and we’ll suggest the shape of the answer.</p>
        <Button href="/contact/" variant="lime">Talk it through</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .sv-mega .mega {
    display: block;
    font-size: 20vw;
    line-height: 0.8;
  }
  .sv-intro {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 24px var(--gutter);
    align-items: end;
    margin-top: clamp(24px, 3vw, 44px);
  }
  .sv-jump {
    margin-top: clamp(28px, 3vw, 44px);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sv-jump .chip {
    min-height: 38px;
    transition: background 0.3s;
  }
  .sv-jump .chip:hover {
    background: var(--lime);
  }
  .sv-list {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    padding-bottom: var(--section);
  }
  .sv-item {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 10px;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .sv-item--flip {
    grid-template-columns: 5fr 7fr;
  }
  .sv-item--flip .sv-item__media {
    order: 2;
  }
  .sv-item__media {
    min-height: clamp(380px, 44vw, 640px);
  }
  .sv-item__media :global(img) {
    position: absolute;
    inset: 0;
  }
  .sv-item__over {
    position: absolute;
    left: clamp(16px, 2vw, 32px);
    right: 16px;
    bottom: clamp(10px, 1.6vw, 24px);
    white-space: normal;
    color: var(--white);
    font-size: clamp(3.2rem, 7vw, 7.5rem);
    line-height: 0.85;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }
  .sv-item__body {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
    padding: clamp(22px, 2.8vw, 40px);
  }
  .sv-item__top {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: start;
  }
  .sv-item__n {
    font-family: var(--f-mega);
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.8;
  }
  .sv-item__body :global(.sv-item__stk) {
    width: clamp(60px, 6vw, 90px);
    transform: rotate(10deg);
  }
  .sv-item__body .h-m {
    text-transform: none;
    letter-spacing: -0.045em;
  }
  .sv-item__link {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .sv-item__link:hover {
    background-size: 100% 2px;
  }
  .sv-item__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .sv-item__line {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .sv-item__list {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
    margin-block: 6px 10px;
  }
  .sv-item__list li {
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .sv-process {
    margin-bottom: clamp(36px, 4.5vw, 72px);
  }
  .sv-cta {
    border-radius: var(--radius-l) var(--radius-l) 0 0;
  }
  .sv-cta__foot {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .sv-cta__foot p {
    max-width: 44ch;
  }
  @media (max-width: 900px) {
    .sv-intro,
    .sv-item,
    .sv-item--flip {
      grid-template-columns: 1fr;
    }
    .sv-item--flip .sv-item__media {
      order: 0;
    }
    .sv-item__media {
      min-height: 320px;
    }
  }
  @media (max-width: 480px) {
    .sv-item__list {
      grid-template-columns: 1fr;
    }
  }
</style>
