---
import Base from '@/layouts/Base.astro';
import Sticker from '@/components/Sticker.astro';
import type { StickerName } from '@/lib/stickers';
import Ticker from '@/components/Ticker.astro';
import WordTunnel from '@/components/WordTunnel.astro';
import Reel from '@/components/Reel.astro';
import WorkShowcase from '@/components/WorkShowcase.astro';
import Experience from '@/components/Experience.astro';
import SplitHeading from '@/components/SplitHeading.astro';
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import ServicesShowcase from '@/components/ServicesShowcase.astro';
import Process from '@/components/Process.astro';
import Clients from '@/components/Clients.astro';
import Testimonials from '@/components/Testimonials.astro';
import JournalCard from '@/components/JournalCard.astro';
import Faq from '@/components/Faq.astro';
import Playground from '@/components/Playground.astro';
import ContactSection from '@/components/ContactSection.astro';
import { services } from '@/data/services';
import { process } from '@/data/studio';
import { site } from '@/config/site';
import { faqs } from '@/data/studio';
import { website, faqPage } from '@/lib/seo';
import { getProjects, getPosts } from '@/lib/content';

import reel1 from '@/assets/img/camera-dark.jpg';
import reel2 from '@/assets/img/studio-lights.jpg';
import reel3 from '@/assets/img/fashion-yellow.jpg';
import reel4 from '@/assets/img/concert-lasers.jpg';
import reel5 from '@/assets/img/eye-stripes.jpg';
import reel6 from '@/assets/img/photographer.jpg';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 6);
const showcase = featured.length ? featured : projects.slice(0, 6);
const posts = (await getPosts()).slice(0, 3);

const tickerItems = ['Brand strategy', 'Identity', 'Advertising', 'Photography', 'Film', 'Social media', 'Events', 'Digital'] as const;

const tunnelWords = [
  'Brand vision',
  'Creative direction',
  'Campaign strategy',
  'Visual identity',
  'Art direction',
  'Commercial photography',
  'Brand film',
  'Social media marketing',
  'Social content',
  'Paid media',
  'Event coverage',
  'Motion graphics',
  'Web design',
  'Scriptwriting',
  'Post-production',
  'Naming',
  'Packaging',
];

const reelFrames = [
  { src: reel1, alt: 'A silver film camera lit in pink and blue against black' },
  { src: reel2, alt: 'A photo studio set up with softboxes and lights' },
  { src: reel3, alt: 'A model in a bright yellow tracksuit on an empty beach' },
  { src: reel4, alt: 'Green and blue lasers over a festival crowd' },
  { src: reel5, alt: 'An eye framed by bold stripes of coloured light' },
  { src: reel6, alt: 'A photographer framing a shot on a busy street' },
];

// Hero doodles: position (% of the hero), size and rotation.
// Extra doodles that only join the falling pile; the static layout keeps the nine above.
// `desk` ones are skipped on phones so the pile fits.
const heroExtras: { name: StickerName; desk?: boolean }[] = [
  { name: 'bulb' },
  { name: 'heart' },
  { name: 'bubble', desk: true },
  { name: 'pencil', desk: true },
  { name: 'smiley', desk: true },
  { name: 'sparkle', desk: true },
  { name: 'star', desk: true },
];

const heroStickers: { name: StickerName; x: number; y: number; s: number; r: number }[] = [
  { name: 'megaphone', x: 3, y: 64, s: 9, r: -14 },
  { name: 'star', x: 17, y: 12, s: 6, r: 10 },
  { name: 'camera', x: 30, y: 58, s: 8.5, r: 8 },
  { name: 'bolt', x: 45, y: 6, s: 5.5, r: -8 },
  { name: 'smiley', x: 53, y: 62, s: 8, r: -6 },
  { name: 'clapper', x: 66, y: 14, s: 7.5, r: 12 },
  { name: 'eye', x: 76, y: 60, s: 8.5, r: -4 },
  { name: 'rocket', x: 90, y: 8, s: 6.5, r: 18 },
  { name: 'sparkle', x: 92, y: 62, s: 5, r: 0 },
];

const schema = [website(), faqPage(faqs)];
---

<Base
  intro
  rawTitle
  title="The Public Fiction: Brand Agency for Social Media, Reels & Video"
  description={site.description}
  schema={schema}
>
  <!-- HERO ------------------------------------------------------------- -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__in">
      <h1 id="hero-title" class="hero__title" data-split aria-label={`${site.name}: creative and brand agency`}>
        <span class="lm" aria-hidden="true"><span class="mega hero__line" style="--i:0" data-fit data-fit-vh="30">The Public</span></span>
        <span class="lm" aria-hidden="true"><span class="mega hero__line" style="--i:1" data-fit data-fit-vh="30">Fiction!</span></span>
      </h1>
    </div>

    <div class="hero__stickers" aria-hidden="true" data-hero-stickers data-lenis-prevent>
      {
        heroStickers.map((st, i) => (
          <span class="hero__stk" style={`--x:${st.x}%;--y:${st.y}%;--s:${st.s};--r:${st.r}deg;--d:${600 + i * 70};--k:${(i % 3) + 1}`}>
            <Sticker name={st.name} />
          </span>
        ))
      }
      {
        heroExtras.map((st, i) => (
          <span class:list={['hero__stk hero__stk--extra', st.desk && 'hero__stk--desk']} style={`--r:${i % 2 ? 12 : -10}deg;--k:${(i % 3) + 1}`}>
            <Sticker name={st.name} />
          </span>
        ))
      }
    </div>

    <a class="hero__scroll label label--caps" href="#about" aria-label="Scroll to the introduction">[ Scroll ]</a>
  </section>

  <Ticker items={tickerItems} variant="white" speed={38} label="What we do" />

  <!-- INTRO ------------------------------------------------------------ -->
  <section class="section intro theme-dark" id="about" aria-labelledby="intro-title">
    <div class="wrap intro__in">
      {/*
        Intro heading options (replacing the placeholder "Just an intro"):
          1. "Hello, we’re the plot twist."  ← in use: plays on "Fiction", confident, sets up the story.
          2. "The short version."             dry nod to the short paragraph that follows.
          3. "Brands, made public."           plays on the name; echoes the Studio page.
      */}
      <SplitHeading id="intro-title" class="mega lime intro__title" lines={['Hello, we’re', 'the plot twist.']} />
      <p class="intro__copy" data-reveal>
        The Public Fiction is an independent creative and brand agency. We build brands, run social media marketing,
        produce Reels, photography and film, and create campaigns that make people stop, look and remember.
      </p>
      <div data-reveal style="--d:120"><a class="intro__cta" href="/contact/">Let’s talk</a></div>
    </div>
  </section>

  <WordTunnel words={tunnelWords} />

  <Reel frames={reelFrames} />

  <!-- WORK ------------------------------------------------------------- -->
  <section class="section work" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 id="work-title" class="work__mega" data-split aria-label="Work">
        <span class="lm" aria-hidden="true"><span class="mega" data-fit>Work</span></span>
      </h2>
      <div class="work__intro">
        <SplitHeading class="stack work__stack" lines={['~Ideas are good.', '>Execution is', '>>everything.']} />
        <div class="work__aside" data-reveal>
          <p class="muted">Campaigns, identities, shoots, films and events — a cross-section of what we make and how we think.</p>
          <Button href="/work/">View all work</Button>
        </div>
      </div>
      <WorkShowcase projects={showcase} />
    </div>
  </section>

  <!-- EXPERIENCE ------------------------------------------------------- -->
  <Experience
    facts={[
      { value: services.length, label: 'Disciplines' },
      { value: 1, label: 'Team' },
      { value: process.length, label: 'Stages, start to launch' },
    ]}
  />

  <!-- SERVICES --------------------------------------------------------- -->
  <section class="section theme-dark services" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead label="What we do" aside="Seven disciplines, one team" />
      <SplitHeading id="services-title" class="stack services__title" lines={['~From the first idea', '>to the final', '>>impression.']} />
      <ServicesShowcase />
    </div>
  </section>

  <Ticker items={['Discover', 'Think', 'Create', 'Launch', 'Evolve']} variant="ink" reverse speed={26} tilt={1.5} label="How we work, in five stages" />

  <!-- APPROACH --------------------------------------------------------- -->
  <section class="section approach" aria-labelledby="approach-title">
    <div class="wrap">
      <SectionHead label="Our approach" aside="Five stages, no mystery" />
      <SplitHeading id="approach-title" class="stack approach__title" lines={["~Good work doesn't", '>happen by', '>>accident.']} />
      <Process />
    </div>
  </section>

  <Clients />

  <Testimonials />

  <!-- JOURNAL ---------------------------------------------------------- -->
  <section class="section journal theme-white" aria-labelledby="journal-title">
    <div class="wrap">
      <SectionHead label="Journal" aside="Thoughts & observations" />
      <div class="journal__head">
        <SplitHeading id="journal-title" class="stack" lines={['~Thoughts,', '>observations &', '>>other good ideas.']} />
        <div data-reveal><Button href="/journal/" variant="ghost">Read the journal</Button></div>
      </div>
      {
        posts.length > 0 ? (
          <div class="journal__grid">
            {posts.map((p) => (
              <JournalCard post={p} />
            ))}
          </div>
        ) : (
          <p class="empty">New writing is on its way.</p>
        )
      }
    </div>
  </section>

  <Faq />

  <Playground />

  <ContactSection />
</Base>

<style>
  /* Hero: full screen, the giant name, a pile of doodles and a scroll cue. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: var(--header-h);
    overflow: hidden;
    background: var(--paper);
  }
  .hero__in {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 14vh;
  }
  .hero__title {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .hero__line {
    display: block;
    font-size: 22.5vw;
    line-height: 0.8;
  }
  .hero__title .lm {
    padding-top: 0.04em;
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 22px;
    z-index: 1;
    translate: -50% 0;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .hero__stickers {
    position: absolute;
    inset: var(--header-h) var(--gutter) 0;
    z-index: 2;
    pointer-events: none;
  }
  .hero__stk {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: block;
    width: calc(var(--s) * 1vw);
    min-width: 46px;
  }
  .hero__stk :global(.stk) {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(var(--r));
    animation: bob calc(3.4s + var(--k) * 0.6s) ease-in-out infinite;
    animation-delay: calc(var(--k) * -1.1s);
    filter: drop-shadow(4px 5px 0 rgba(14, 15, 17, 0.12));
    transition:
      scale 0.35s var(--spring),
      filter 0.35s;
  }
  /* Grabbable: the doodles can be dragged and thrown around the hero. */
  :global(html:not(.reduce-motion)) .hero__stk {
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  @media (hover: hover) {
    :global(html:not(.reduce-motion)) .hero__stk:hover :global(.stk) {
      scale: 1.08;
    }
  }
  /* Once someone grabs one, physics takes over positioning. */
  /* With JS + motion the doodles wait off-stage, then fall into a pile. */
  .hero__stk--extra {
    display: none;
  }
  :global(html.js:not(.reduce-motion)) .hero__stk--extra {
    display: block;
  }
  :global(html.js:not(.reduce-motion)) .hero__stk {
    opacity: 0;
  }
  .hero__stickers.is-live .hero__stk.is-dropped {
    opacity: 1;
  }
  .hero__stickers.is-live .hero__stk {
    --u: min(clamp(84px, 10.5vw, 190px), 21vh);
    width: calc(var(--u) * (0.86 + var(--k) * 0.1));
    min-width: 0;
    left: 0;
    top: 0;
    translate: none !important;
    transition: none !important;
    will-change: transform;
  }
  .hero__stickers.is-live .hero__stk :global(.stk) {
    animation: none;
    transform: none;
  }
  .hero__stk.is-grabbed {
    z-index: 3;
    cursor: grabbing;
  }
  .hero__stk.is-grabbed :global(.stk) {
    scale: 1.14;
    filter: drop-shadow(8px 12px 0 rgba(14, 15, 17, 0.16));
  }
  @media (max-width: 1000px) {
    .hero__stickers.is-live .hero__stk {
      --u: min(16vw, 22vh);
    }
    .hero__in {
      padding-bottom: 4vh;
    }
  }
  @media (max-width: 700px) {
    .hero__stickers.is-live .hero__stk {
      --u: min(21vw, 13vh);
    }
  }
  /* Intro: short, centred, black. */
  .intro__in {
    display: grid;
    justify-items: center;
    gap: clamp(20px, 2.4vw, 34px);
    text-align: center;
    padding-block: clamp(40px, 8vw, 120px);
  }
  .intro__title {
    font-size: clamp(3.6rem, 7.4vw, 8rem);
    line-height: 0.86;
  }
  .intro__copy {
    max-width: 30ch;
    font-weight: 600;
    font-size: clamp(1.15rem, 1.7vw, 1.6rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--paper);
  }
  .intro__copy sup {
    font-size: 0.55em;
  }
  .intro__cta {
    display: inline-flex;
    align-items: center;
    min-height: 54px;
    padding: 0 30px;
    border: 2px solid var(--lime);
    border-radius: 999px;
    color: var(--lime);
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    font-weight: 600;
    text-transform: uppercase;
    transition:
      background 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .intro__cta:hover {
    background: var(--lime);
    color: var(--ink);
  }

  /* Work */
  .work__mega .mega {
    display: block;
    font-size: 40vw;
    line-height: 0.8;
    text-align: center;
  }
  .work__intro {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 32px var(--gutter);
    align-items: end;
    margin: clamp(32px, 4vw, 64px) 0 clamp(36px, 4vw, 64px);
  }
  .work__aside {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  /* Services + approach + journal headings */
  .services__title,
  .approach__title {
    margin-bottom: clamp(36px, 4.5vw, 72px);
  }
  .journal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: clamp(36px, 4.5vw, 72px);
  }
  .journal__head :global(.stack) {
    flex: 1 1 560px;
  }
  .journal__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px var(--gutter);
  }

  @media (max-width: 1000px) {
    .work__intro {
      grid-template-columns: 1fr;
    }
    .journal__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 700px) {
    .hero__stk {
      width: calc(var(--s) * 1.8vw);
      min-width: 38px;
    }
    .hero__in {
      padding-bottom: 2vh;
    }
    .journal__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /*
   * Hero doodles. After the intro they drop in one by one under real
   * gravity and pile up across the bottom of the full-screen hero, partly
   * over the big title. Visitors can grab, drag
   * and throw them; a tap makes one hop. Without JS or with reduced motion
   * the art-directed static layout is shown instead.
   */
  import Matter from 'matter-js';

  const { Engine, Bodies, Body, Composite, Sleeping } = Matter;
  const box = document.querySelector<HTMLElement>('[data-hero-stickers]');
  const hero = box?.closest<HTMLElement>('.hero');

  if (box && hero && !document.documentElement.classList.contains('reduce-motion')) {
    const items = Array.from(box.children) as HTMLElement[];
    let live = false;

    const engine = Engine.create({
      gravity: { x: 0, y: 1.1 },
      enableSleeping: true,
      positionIterations: 10,
      velocityIterations: 8,
    });
    const world = engine.world;
    type Thing = { el: HTMLElement; body: Matter.Body; w: number; h: number };
    let things: Thing[] = [];
    let walls: Matter.Body[] = [];

    // Play area in the doodle layer's own coordinates: the whole hero, below
    // the fixed header and above the headline copy and buttons.
    const area = () => {
      const b = box.getBoundingClientRect();
      const h = hero.getBoundingClientRect();
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
      return { left: h.left - b.left, right: h.right - b.left, top: h.top - b.top + header, bottom: h.bottom - b.top - 6 };
    };

    const buildWalls = () => {
      Composite.remove(world, walls);
      const { left, right, top, bottom } = area();
      const t = 400;
      const w = right - left;
      const hh = bottom - top;
      const opts = { isStatic: true, restitution: 0.8 };
      walls = [
        // Ceiling well above the hero: doodles fall in from above, thrown ones come back down.
        Bodies.rectangle(left + w / 2, top - 900 - t / 2, w + t * 2, t, opts),
        Bodies.rectangle(left + w / 2, bottom + t / 2, w + t * 2, t, opts),
        Bodies.rectangle(left - t / 2, top + hh / 2 - 450, t, hh + 900 + t * 2, opts),
        Bodies.rectangle(right + t / 2, top + hh / 2 - 450, t, hh + 900 + t * 2, opts),
      ];
      Composite.add(world, walls);
    };

    const render = () => {
      for (const t of things) {
        const { x, y } = t.body.position;
        t.el.style.transform = `translate3d(${(x - t.w / 2).toFixed(2)}px, ${(y - t.h / 2).toFixed(2)}px, 0) rotate(${t.body.angle.toFixed(4)}rad)`;
      }
    };

    // Only run the simulation while something is moving.
    let grab: {
      thing: Thing;
      id: number;
      sx: number;
      sy: number;
      moved: boolean;
      ox: number;
      oy: number;
      px: number;
      py: number;
    } | null = null;
    let raf = 0;
    let last = 0;
    let idle = 0;
    let acc = 0;
    const STEP = 1000 / 120;
    const MAX_SPEED = 45;
    const follow = () => {
      if (!grab) return;
      const b = grab.thing.body;
      const tx = grab.px - grab.ox;
      const ty = grab.py - grab.oy;
      // Close most of the gap every step: tight to the finger, never jerky.
      let vx = (tx - b.position.x) * 0.72;
      let vy = (ty - b.position.y) * 0.72;
      const sp = Math.hypot(vx, vy);
      if (sp > MAX_SPEED) {
        vx = (vx / sp) * MAX_SPEED;
        vy = (vy / sp) * MAX_SPEED;
      }
      Body.setVelocity(b, { x: vx, y: vy });
      Body.setAngularVelocity(b, b.angularVelocity * 0.9);
    };
    // Pause the simulation while the hero is off screen: it would otherwise
    // keep stepping collisions behind the scroll animations further down.
    let onScreen = true;
    const loop = (now: number) => {
      if (!onScreen) {
        raf = 0;
        return;
      }
      // At most three steps per frame: after a slow frame, catching up in full
      // would make the next frame slower still.
      acc = Math.min(acc + (last ? now - last : STEP), STEP * 3);
      last = now;
      while (acc >= STEP) {
        follow();
        Engine.update(engine, STEP);
        acc -= STEP;
      }
      render();
      const moving = grab || dropping || things.some((t) => !t.body.isSleeping);
      idle = moving ? 0 : idle + 1;
      raf = idle > 30 ? 0 : requestAnimationFrame(loop);
    };
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      if (onScreen && live) run();
    }).observe(hero);
    const run = () => {
      idle = 0;
      if (!raf && onScreen) {
        last = 0;
        acc = 0;
        raf = requestAnimationFrame(loop);
      }
    };

    // Drop the doodles in one at a time from above the hero, at random spots.
    let dropping = false;
    const drop = () => {
      live = true;
      dropping = true;
      box.classList.add('is-live');
      buildWalls();
      const { left, right, top } = area();
      const shown = items.filter((el) => getComputedStyle(el).display !== 'none');
      shown.sort(() => Math.random() - 0.5);
      shown.forEach((el, i) => {
        window.setTimeout(() => {
          const w = el.offsetWidth;
          const h = el.offsetHeight;
          const rad = Math.max(w, h) * 0.42;
          const x = left + rad + Math.random() * Math.max(1, right - left - rad * 2);
          const body = Bodies.circle(x, top - h - Math.random() * 160, rad, {
            restitution: 0.35,
            friction: 0.35,
            frictionAir: 0.012,
            density: 0.0015,
          });
          Body.setAngle(body, (Math.random() - 0.5) * 1.2);
          Body.setAngularVelocity(body, (Math.random() - 0.5) * 0.06);
          const thing = { el, body, w, h };
          things.push(thing);
          Composite.add(world, body);
          render();
          el.classList.add('is-dropped');
          if (i === shown.length - 1) dropping = false;
          run();
        }, i * 120);
      });
    };

    // Start once the brand intro has lifted and the hero is on screen.
    const introDelay = document.documentElement.classList.contains('has-intro') ? 1500 : 250;
    window.setTimeout(() => {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        drop();
      });
      io.observe(hero);
    }, introDelay);

    const local = (e: PointerEvent) => {
      const r = box.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };

    box.addEventListener('pointerdown', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.hero__stk');
      if (!el || grab) return;
      const thing = things.find((t) => t.el === el);
      if (!thing) return;
      e.preventDefault();
      Sleeping.set(thing.body, false);
      const p = local(e);
      grab = {
        thing,
        id: e.pointerId,
        sx: e.clientX,
        sy: e.clientY,
        moved: false,
        ox: p.x - thing.body.position.x,
        oy: p.y - thing.body.position.y,
        px: p.x,
        py: p.y,
      };
      el.classList.add('is-grabbed');
      el.setPointerCapture(e.pointerId);
      run();
    });

    box.addEventListener('pointermove', (e) => {
      if (!grab || e.pointerId !== grab.id) return;
      e.preventDefault();
      const p = local(e);
      grab.px = p.x;
      grab.py = p.y;
      if (Math.abs(e.clientX - grab.sx) + Math.abs(e.clientY - grab.sy) > 6) grab.moved = true;
    });

    const release = (e: PointerEvent) => {
      if (!grab || e.pointerId !== grab.id) return;
      const { thing, moved } = grab;
      thing.el.classList.remove('is-grabbed');
      // A tap (no drag) makes the doodle hop.
      if (!moved) {
        Body.setVelocity(thing.body, { x: (Math.random() - 0.5) * 6, y: -14 });
        Body.setAngularVelocity(thing.body, (Math.random() - 0.5) * 0.4);
      }
      grab = null;
      run();
    };
    box.addEventListener('pointerup', release);
    box.addEventListener('pointercancel', (e) => {
      if (grab && e.pointerId === grab.id) grab.moved = true;
      release(e);
    });

    // Keep the play area in step with the layout; nudge strays back inside.
    let rt = 0;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        if (!live) return;
        buildWalls();
        const { left, right, bottom } = area();
        for (const t of things) {
          const rad = Math.max(t.w, t.h) * 0.42;
          Body.setPosition(t.body, {
            x: Math.min(Math.max(t.body.position.x, left + rad), right - rad),
            y: Math.min(t.body.position.y, bottom - rad),
          });
        }
        run();
      }, 150);
    });
  }
</script>
