---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import SplitHeading from '@/components/SplitHeading.astro';
import Button from '@/components/Button.astro';
import Sticker from '@/components/Sticker.astro';
import type { StickerName } from '@/lib/stickers';
import Ticker from '@/components/Ticker.astro';
import WordTunnel from '@/components/WordTunnel.astro';
import Reel from '@/components/Reel.astro';
import WorkShowcase from '@/components/WorkShowcase.astro';
import BlobWord from '@/components/BlobWord.astro';
import ServicesShowcase from '@/components/ServicesShowcase.astro';
import Process from '@/components/Process.astro';
import Clients from '@/components/Clients.astro';
import Testimonials from '@/components/Testimonials.astro';
import JournalCard from '@/components/JournalCard.astro';
import Faq from '@/components/Faq.astro';
import ContactSection from '@/components/ContactSection.astro';
import Playground from '@/components/Playground.astro';
import { site } from '@/config/site';
import { approach } from '@/data/studio';
import { getProjects, getPosts } from '@/lib/content';

import reel1 from '@/assets/img/camera-dark.jpg';
import reel2 from '@/assets/img/studio-lights.jpg';
import reel3 from '@/assets/img/fashion-yellow.jpg';
import reel4 from '@/assets/img/concert-lasers.jpg';
import reel5 from '@/assets/img/eye-stripes.jpg';
import reel6 from '@/assets/img/photographer.jpg';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 6);
const showcase = featured.length ? featured : projects.slice(0, 6);
const posts = (await getPosts()).slice(0, 3);

const tickerItems = ['Brand strategy', 'Identity', 'Advertising', 'Photography', 'Film', 'Social', 'Events', 'Digital'] as const;

const tunnelWords = [
  'Brand vision',
  'Creative direction',
  'Campaign strategy',
  'Visual identity',
  'Art direction',
  'Commercial photography',
  'Brand film',
  'Social content',
  'Paid media',
  'Event coverage',
  'Motion graphics',
  'Web design',
  'Scriptwriting',
  'Post-production',
  'Naming',
  'Packaging',
];

const reelFrames = [
  { src: reel1, alt: 'A silver film camera lit in pink and blue against black' },
  { src: reel2, alt: 'A photo studio set up with softboxes and lights' },
  { src: reel3, alt: 'A model in a bright yellow tracksuit on an empty beach' },
  { src: reel4, alt: 'Green and blue lasers over a festival crowd' },
  { src: reel5, alt: 'An eye framed by bold stripes of coloured light' },
  { src: reel6, alt: 'A photographer framing a shot on a busy street' },
];

// Hero doodles: position (% of the hero), size and rotation.
const heroStickers: { name: StickerName; x: number; y: number; s: number; r: number }[] = [
  { name: 'megaphone', x: 3, y: 64, s: 9, r: -14 },
  { name: 'star', x: 17, y: 12, s: 6, r: 10 },
  { name: 'camera', x: 30, y: 58, s: 8.5, r: 8 },
  { name: 'bolt', x: 45, y: 6, s: 5.5, r: -8 },
  { name: 'smiley', x: 53, y: 62, s: 8, r: -6 },
  { name: 'clapper', x: 66, y: 14, s: 7.5, r: 12 },
  { name: 'eye', x: 76, y: 60, s: 8.5, r: -4 },
  { name: 'rocket', x: 90, y: 8, s: 6.5, r: 18 },
  { name: 'sparkle', x: 92, y: 62, s: 5, r: 0 },
];

const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url }];
---

<Base intro schema={schema}>
  <!-- HERO ------------------------------------------------------------- -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero__meta" data-reveal>
        <span class="label"><span class="hero__dot" aria-hidden="true"></span>Independent creative company</span>
        <ul class="hero__list label" aria-label="Disciplines">
          <li>Brand</li>
          <li>Campaigns</li>
          <li>Photo &amp; film</li>
          <li>Events</li>
          <li>Digital</li>
        </ul>
      </div>

      <h1 id="hero-title" class="hero__title" data-split aria-label={`${site.name} — we make brands impossible to ignore.`}>
        <span class="lm" aria-hidden="true"><span class="mega hero__line" style="--i:0" data-fit data-fit-vh="26">The Public</span></span>
        <span class="lm" aria-hidden="true"><span class="mega hero__line" style="--i:1" data-fit data-fit-vh="26">Fiction!</span></span>
      </h1>

      <div class="hero__stickers" aria-hidden="true" data-hero-stickers>
        {
          heroStickers.map((st, i) => (
            <span class="hero__stk" style={`--x:${st.x}%;--y:${st.y}%;--s:${st.s};--r:${st.r}deg;--d:${600 + i * 70};--k:${(i % 3) + 1}`} data-pop>
              <Sticker name={st.name} />
            </span>
          ))
        }
      </div>

      <div class="hero__foot">
        <p class="hero__claim h-m" data-reveal style="--d:300">We make brands <span class="mark">impossible</span> to ignore.</p>
        <p class="hero__copy muted" data-reveal style="--d:380">
          We build brands, create campaigns and produce visual experiences that make people stop, look and remember.
        </p>
        <div class="hero__ctas" data-reveal style="--d:460">
          <Button href="#work">Explore our work</Button>
          <Button href="/contact/" variant="ghost">Start a project</Button>
        </div>
      </div>
    </div>
  </section>

  <Ticker items={tickerItems} tilt={-2} />

  <!-- INTRO ------------------------------------------------------------ -->
  <section class="section intro theme-dark" id="about" aria-labelledby="intro-title">
    <div class="wrap intro__in">
      <p class="label label--caps label--muted" data-reveal>Just an intro</p>
      <SplitHeading id="intro-title" class="mega mega--s lime intro__title" lines={['Not just another', 'creative agency.']} />
      <p class="lede intro__copy" data-reveal>
        We bring strategy, creativity and production together to help brands find their voice, reach their audience and
        make an impression.
      </p>
      <ol class="intro__steps" aria-label="How we work">
        {
          approach.map((step, i) => (
            <li class="chip" data-reveal style={`--d:${i * 70}`}>
              <span class="lime">0{i + 1}</span> {step}
            </li>
          ))
        }
      </ol>
      <div data-reveal><Button href="/studio/" variant="ghost">Meet the studio</Button></div>
      <Sticker name="bulb" class="intro__stk intro__stk--a" data-pop />
      <Sticker name="heart" class="intro__stk intro__stk--b" data-pop />
    </div>
  </section>

  <WordTunnel words={tunnelWords} />

  <Reel frames={reelFrames} />

  <!-- WORK ------------------------------------------------------------- -->
  <section class="section work" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead label="Selected work" aside={`${projects.length} projects`} />
      <h2 id="work-title" class="work__mega" data-split aria-label="Work">
        <span class="lm" aria-hidden="true"><span class="mega" data-fit>Work</span></span>
      </h2>
      <div class="work__intro">
        <SplitHeading class="stack work__stack" lines={['~Ideas are good.', '>Execution is', '>>everything.']} />
        <div class="work__aside" data-reveal>
          <p class="muted">Campaigns, identities, shoots, films and events — a cross-section of what we make and how we think.</p>
          <Button href="/work/">View all work</Button>
        </div>
      </div>
      <WorkShowcase projects={showcase} />
    </div>
  </section>

  <BlobWord word="All of it." note="Strategy → Identity → Campaign → Production → Launch" />

  <!-- SERVICES --------------------------------------------------------- -->
  <section class="section theme-dark services" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead label="What we do" aside="Six disciplines, one team" />
      <SplitHeading id="services-title" class="stack services__title" lines={['~From the first idea', '>to the final', '>>impression.']} />
      <ServicesShowcase />
    </div>
  </section>

  <Ticker items={['Discover', 'Think', 'Create', 'Launch', 'Evolve']} variant="ink" reverse speed={26} tilt={1.5} />

  <!-- APPROACH --------------------------------------------------------- -->
  <section class="section approach" aria-labelledby="approach-title">
    <div class="wrap">
      <SectionHead label="Our approach" aside="Five stages, no mystery" />
      <SplitHeading id="approach-title" class="stack approach__title" lines={["~Good work doesn't", '>happen by', '>>accident.']} />
      <Process />
    </div>
  </section>

  <Clients />

  <Testimonials />

  <!-- JOURNAL ---------------------------------------------------------- -->
  <section class="section journal theme-white" aria-labelledby="journal-title">
    <div class="wrap">
      <SectionHead label="Journal" aside="Thoughts & observations" />
      <div class="journal__head">
        <SplitHeading id="journal-title" class="stack" lines={['~Thoughts,', '>observations &', '>>other good ideas.']} />
        <div data-reveal><Button href="/journal/" variant="ghost">Read the journal</Button></div>
      </div>
      {
        posts.length > 0 ? (
          <div class="journal__grid">
            {posts.map((p) => (
              <JournalCard post={p} />
            ))}
          </div>
        ) : (
          <p class="empty">New writing is on its way.</p>
        )
      }
    </div>
  </section>

  <Faq />

  <Playground />

  <ContactSection />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(20px, 3vw, 44px));
    padding-bottom: clamp(36px, 4vw, 64px);
    overflow: hidden;
  }
  .hero .wrap {
    position: relative;
  }
  .hero__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: clamp(8px, 1.5vw, 20px);
  }
  .hero__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px var(--ink);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      transform: scale(0.7);
    }
  }
  .hero__list {
    display: grid;
    justify-items: end;
    gap: 1px;
    font-weight: 700;
  }
  .hero__title {
    position: relative;
    z-index: 1;
  }
  .hero__line {
    display: block;
    font-size: 22.5vw;
    line-height: 0.8;
  }
  .hero__title .lm {
    padding-top: 0.04em;
  }
  .hero__stickers {
    position: absolute;
    inset: 40px var(--gutter) 30%;
    z-index: 2;
    pointer-events: none;
  }
  .hero__stk {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--s) * 1vw);
    min-width: 46px;
  }
  .hero__stk :global(.stk) {
    width: 100%;
    height: auto;
    transform: rotate(var(--r));
    animation: bob calc(3.4s + var(--k) * 0.6s) ease-in-out infinite;
    animation-delay: calc(var(--k) * -1.1s);
    filter: drop-shadow(4px 5px 0 rgba(14, 15, 17, 0.12));
  }
  .hero__foot {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 5fr 4fr auto;
    gap: 24px var(--gutter);
    align-items: end;
    margin-top: clamp(24px, 3vw, 44px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .hero__claim {
    text-transform: none;
    letter-spacing: -0.045em;
    max-width: 16ch;
  }
  .hero__copy {
    max-width: 40ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }

  /* Intro */
  .intro__in {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(20px, 2.4vw, 32px);
    text-align: center;
    padding-block: clamp(20px, 4vw, 60px);
  }
  .intro__title {
    font-size: clamp(3.4rem, 10vw, 11rem);
    line-height: 0.86;
  }
  .intro__copy {
    max-width: 34ch;
  }
  .intro__steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 900px;
  }
  .intro__steps .chip {
    min-height: 40px;
    gap: 8px;
    font-size: 14px;
  }
  .intro :global(.intro__stk) {
    position: absolute;
    width: clamp(70px, 9vw, 140px);
  }
  .intro :global(.intro__stk--a) {
    left: 4%;
    top: 4%;
    --r: -12deg;
  }
  .intro :global(.intro__stk--b) {
    right: 5%;
    bottom: 6%;
    --r: 10deg;
  }
  :global(html.js:not(.reduce-motion)) .intro :global(.intro__stk.is-in) {
    animation: bob 4.4s ease-in-out infinite;
  }
  @media (max-width: 640px) {
    .intro :global(.intro__stk--a) {
      top: -40px;
      width: 56px;
    }
    .intro :global(.intro__stk--b) {
      bottom: -30px;
      width: 56px;
    }
  }

  /* Work */
  .work__mega .mega {
    display: block;
    font-size: 40vw;
    line-height: 0.8;
    text-align: center;
  }
  .work__intro {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 32px var(--gutter);
    align-items: end;
    margin: clamp(32px, 4vw, 64px) 0 clamp(36px, 4vw, 64px);
  }
  .work__aside {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  /* Services + approach + journal headings */
  .services__title,
  .approach__title {
    margin-bottom: clamp(36px, 4.5vw, 72px);
  }
  .journal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: clamp(36px, 4.5vw, 72px);
  }
  .journal__head :global(.stack) {
    flex: 1 1 560px;
  }
  .journal__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px var(--gutter);
  }

  @media (max-width: 1000px) {
    .hero__foot {
      grid-template-columns: 1fr 1fr;
    }
    .hero__ctas {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
    .work__intro {
      grid-template-columns: 1fr;
    }
    .journal__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 700px) {
    .hero__list {
      display: none;
    }
    .hero__stickers {
      inset: 20px var(--gutter) 62%;
    }
    .hero__stk {
      width: calc(var(--s) * 1.8vw);
      min-width: 38px;
    }
    .hero__foot {
      grid-template-columns: 1fr;
    }
    .journal__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Hero doodles drift gently away from the pointer.
  const box = document.querySelector<HTMLElement>('[data-hero-stickers]');
  if (box && !document.documentElement.classList.contains('reduce-motion') && matchMedia('(pointer: fine)').matches) {
    const items = Array.from(box.children) as HTMLElement[];
    let raf = 0;
    addEventListener(
      'pointermove',
      (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const dx = e.clientX / innerWidth - 0.5;
          const dy = e.clientY / innerHeight - 0.5;
          items.forEach((el) => {
            const k = Number(getComputedStyle(el).getPropertyValue('--k')) || 1;
            el.style.translate = `${dx * k * -22}px ${dy * k * -22}px`;
          });
        });
      },
      { passive: true },
    );
  }
</script>
