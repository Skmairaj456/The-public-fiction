---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SplitHeading from '@/components/SplitHeading.astro';
import SectionHead from '@/components/SectionHead.astro';
import Process from '@/components/Process.astro';
import Clients from '@/components/Clients.astro';
import Testimonials from '@/components/Testimonials.astro';
import Button from '@/components/Button.astro';
import Ticker from '@/components/Ticker.astro';
import Sticker from '@/components/Sticker.astro';
import type { StickerName } from '@/lib/stickers';

import studioWide from '@/assets/img/studio-lights.jpg';
import studioA from '@/assets/img/camera.jpg';
import studioB from '@/assets/img/team-wall.jpg';

const beliefs: { title: string; text: string; icon: StickerName }[] = [
  { title: 'Clarity beats volume', text: 'One sharp idea, said well, outperforms ten said loudly. We spend real time finding the one.', icon: 'bulb' },
  { title: 'Craft is a business decision', text: 'People judge quality in milliseconds. Well-made work earns trust before anyone reads a word.', icon: 'pencil' },
  { title: 'Strategy should be visible', text: 'If you can’t see the thinking in the final picture, the thinking didn’t make it. We make sure it does.', icon: 'eye' },
  { title: 'Plain words, honest numbers', text: 'No jargon, no inflated promises. We tell you what we think, what it costs and what to expect.', icon: 'smiley' },
];
---

<Base
  title="Studio"
  description="THE PUBLIC FICTION is an independent creative and marketing company combining strategy, creative direction, production and media."
>
  <section class="page-intro">
    <div class="wrap">
      <SectionHead label="The studio" aside="About us" />
      <h1 class="st-mega" data-split aria-label="Studio">
        <span class="lm" aria-hidden="true"><span class="mega" data-fit>Studio</span></span>
      </h1>
      <div class="st-intro">
        <SplitHeading as="p" class="stack" lines={['~Every brand', '>tells a story.', '>>We make it public.']} />
        <p class="lede" data-reveal>
          THE PUBLIC FICTION is an independent creative and marketing company. We bring strategy, creativity and
          production together to help brands find their voice, reach their audience and make an impression.
        </p>
      </div>
    </div>
  </section>

  <figure class="wrap st-wide">
    <div class="media st-wide__media" data-reveal-img>
      <div class="st-wide__inner" data-parallax="-0.08">
        <Picture src={studioWide} alt="A photo studio set up with softboxes, stands and plants" widths={[800, 1400, 2000]} sizes="100vw" formats={['avif', 'webp']} loading="eager" />
      </div>
    </div>
  </figure>

  <section class="section" aria-labelledby="name-title">
    <div class="wrap st-name">
      <div>
        <SectionHead label="The name" />
        <h2 id="name-title" class="mega mega--m" data-split aria-label="Why fiction?">
          <span class="lm" aria-hidden="true"><span style="--i:0">Why</span></span>
          <span class="lm" aria-hidden="true"><span style="--i:1"><span class="mark">fiction?</span></span></span>
        </h2>
      </div>
      <div class="st-name__copy" data-reveal>
        <p class="lede">
          Every brand is a story people agree to believe — about quality, about values, about who it’s for. Our job is to
          write that story well and make it public.
        </p>
        <p class="muted">
          Not fiction as in made-up. Fiction as in crafted: a world with a point of view, built so carefully that people
          want to step into it. The work has to be true to the business. It also has to be worth watching.
        </p>
      </div>
    </div>
  </section>

  <Ticker items={['Think clearly', 'Make beautifully', 'Launch deliberately']} tilt={-1.5} />

  <section class="section" aria-labelledby="beliefs-title">
    <div class="wrap">
      <SectionHead label="What we believe" aside="Four non-negotiables" />
      <SplitHeading id="beliefs-title" class="stack st-beliefs-title" lines={['~Four things', '>we won’t', '>>compromise on.']} />
      <div class="st-bento">
        {
          beliefs.map((b, i) => (
            <article class:list={['st-belief', 'card', i === 1 && 'theme-dark', i === 2 && 'theme-lime']} data-reveal style={`--d:${i * 80}`}>
              <Sticker name={b.icon} class="st-belief__stk" />
              <span class="st-belief__n">0{i + 1}</span>
              <h3 class="h-s">{b.title}</h3>
              <p class="muted">{b.text}</p>
            </article>
          ))
        }
        <div class="st-bento__img media" data-reveal-img>
          <Picture src={studioA} alt="A compact camera on a desk beside printed photographs" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 33vw" formats={['avif', 'webp']} />
        </div>
        <div class="st-bento__img st-bento__img--wide media" data-reveal-img style="--d:120">
          <Picture src={studioB} alt="A team planning a campaign around a wall of sticky notes" widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 50vw" formats={['avif', 'webp']} />
        </div>
      </div>
    </div>
  </section>

  <section class="section theme-white" aria-labelledby="approach-title">
    <div class="wrap">
      <SectionHead label="Our approach" aside="Five stages" />
      <SplitHeading id="approach-title" class="stack st-approach-title" lines={["~Good work doesn't", '>happen by', '>>accident.']} />
      <Process />
    </div>
  </section>

  <Clients />
  <Testimonials />

  <section class="section theme-dark st-cta">
    <div class="wrap">
      <SplitHeading class="mega mega--m" lines={['We don’t just make', 'things look good.', '^We make ideas work.^']} />
      <div class="st-cta__btns" data-reveal>
        <Button href="/contact/" variant="lime">Start a project</Button>
        <Button href="/work/" variant="ghost">See the work</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .st-mega .mega {
    display: block;
    font-size: 30vw;
    line-height: 0.8;
  }
  .st-intro {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 24px var(--gutter);
    align-items: end;
    margin-top: clamp(24px, 3vw, 44px);
  }
  .st-wide__media {
    height: clamp(340px, 76vh, 900px);
  }
  .st-wide__inner {
    position: absolute;
    inset: -8% 0;
  }
  .st-wide__inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .st-name {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 32px clamp(32px, 5vw, 96px);
    align-items: end;
  }
  .st-name .mega {
    white-space: normal;
  }
  .st-name__copy {
    display: grid;
    gap: 18px;
  }
  .st-beliefs-title,
  .st-approach-title {
    margin-bottom: clamp(36px, 4.5vw, 72px);
  }
  .st-bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .st-belief {
    position: relative;
    display: grid;
    align-content: start;
    gap: 12px;
    min-height: 300px;
    padding: clamp(22px, 2.2vw, 32px);
    overflow: hidden;
  }
  .st-belief.theme-dark,
  .st-belief.theme-lime {
    border-color: transparent;
  }
  .st-belief :global(.st-belief__stk) {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 76px;
    transform: rotate(-10deg);
    transition: transform 0.6s var(--spring);
  }
  .st-belief:hover :global(.st-belief__stk) {
    transform: rotate(8deg) scale(1.1);
  }
  .st-belief__n {
    font-family: var(--f-mega);
    font-size: 3rem;
    line-height: 0.8;
  }
  .st-belief p {
    max-width: 30ch;
    padding-right: 40px;
  }
  .st-bento__img {
    grid-column: span 1;
    min-height: 320px;
  }
  .st-bento__img--wide {
    grid-column: span 3;
  }
  .st-bento__img :global(img) {
    position: absolute;
    inset: 0;
  }
  .st-cta {
    border-radius: var(--radius-l) var(--radius-l) 0 0;
  }
  .st-cta .mega {
    white-space: normal;
  }
  .st-cta__btns {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 1000px) {
    .st-bento {
      grid-template-columns: 1fr 1fr;
    }
    .st-bento__img,
    .st-bento__img--wide {
      grid-column: span 1;
    }
  }
  @media (max-width: 900px) {
    .st-intro,
    .st-name {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .st-bento {
      grid-template-columns: 1fr;
    }
  }
</style>
