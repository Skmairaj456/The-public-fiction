---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import JournalCard from '@/components/JournalCard.astro';
import Button from '@/components/Button.astro';
import { site } from '@/config/site';
import { getPosts, formatDate, readingTime, type Post } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
}

interface Props {
  post: Post;
  more: Post[];
}

const { post, more } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const og = await getImage({ src: data.cover, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.excerpt,
    datePublished: data.date.toISOString(),
    author: { '@type': 'Organization', name: data.author },
    publisher: { '@type': 'Organization', name: site.name },
    image: new URL(og.src, Astro.site ?? site.url).href,
    mainEntityOfPage: canonical,
  },
];
---

<Base title={data.title} description={data.excerpt} image={og.src} imageAlt={data.coverAlt} type="article" schema={schema}>
  <article class="ja">
    <header class="page-intro ja__head">
      <div class="wrap">
        <div class="page-intro__meta label">
          <a class="ulink" href="/journal/">← Journal</a>
          <span class="label--muted">{data.topic}</span>
        </div>
        <h1 class="ja__title" data-reveal>{data.title}</h1>
        <p class="ja__meta label label--muted" data-reveal style="--d:120">
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          <span>{readingTime(post.body)} min read</span>
          <span>By {data.author}</span>
        </p>
      </div>
    </header>

    <figure class="wrap ja__cover">
      <div class="media" data-reveal-img>
        <Picture src={data.cover} alt={data.coverAlt} widths={[800, 1400, 2000]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      </div>
    </figure>

    <div class="wrap ja__body">
      <p class="ja__excerpt">{data.excerpt}</p>
      <div class="prose">
        <Content />
      </div>
      <div class="ja__end">
        <p class="label label--muted">Have a project this made you think about?</p>
        <Button href="/contact/">Start a conversation</Button>
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section theme-paper-2" aria-labelledby="more-title">
        <div class="wrap">
          <h2 id="more-title" class="display-m ja__more-title">
            Keep <span class="serif">reading</span>
          </h2>
          <div class="ja__more">
            {more.map((p) => (
              <JournalCard post={p} variant="large" sizes="(max-width: 760px) 100vw, 50vw" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .ja__title {
    font-family: var(--f-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.92;
    font-size: clamp(2.3rem, 6.2vw, 6.6rem);
    max-width: 16ch;
  }
  .ja__meta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .ja__cover .media {
    aspect-ratio: 21 / 9;
  }
  .ja__body {
    max-width: 860px;
    padding-block: clamp(48px, 6vw, 100px) var(--section);
  }
  .ja__excerpt {
    font-family: var(--f-serif);
    font-size: clamp(1.6rem, 2.6vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .ja__end {
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .ja__more-title {
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .ja__more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px var(--gutter);
  }
  @media (max-width: 760px) {
    .ja__cover .media {
      aspect-ratio: 4 / 3;
    }
    .ja__more {
      grid-template-columns: 1fr;
    }
  }
</style>
