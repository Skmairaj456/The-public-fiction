---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import JournalCard from '@/components/JournalCard.astro';
import Button from '@/components/Button.astro';
import Arrow from '@/components/Arrow.astro';
import { site } from '@/config/site';
import { getPosts, formatDate, readingTime, type Post } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
}

interface Props {
  post: Post;
  more: Post[];
}

const { post, more } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const og = await getImage({ src: data.cover, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.excerpt,
    datePublished: data.date.toISOString(),
    author: { '@type': 'Organization', name: data.author },
    publisher: { '@type': 'Organization', name: site.name },
    image: new URL(og.src, Astro.site ?? site.url).href,
    mainEntityOfPage: canonical,
  },
];
---

<Base title={data.title} description={data.excerpt} image={og.src} imageAlt={data.coverAlt} type="article" schema={schema}>
  <article class="ja">
    <header class="page-intro">
      <div class="wrap ja__head">
        <div class="page-intro__meta">
          <a class="arrow-link ja__back" href="/journal/"><span class="btn__icon" aria-hidden="true"><Arrow class="ja__back-arrow" /></span>Journal</a>
          <span class="chip chip--lime">{data.topic}</span>
        </div>
        <h1 class="ja__title h-xl" data-reveal>{data.title}</h1>
        <p class="ja__meta" data-reveal style="--d:120">
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          <span>{readingTime(post.body)} min read</span>
          <span>By {data.author}</span>
        </p>
      </div>
    </header>

    <figure class="wrap ja__cover">
      <div class="media" data-reveal-img>
        <Picture src={data.cover} alt={data.coverAlt} widths={[800, 1400, 2000]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      </div>
    </figure>

    <div class="wrap ja__body">
      <p class="ja__excerpt">{data.excerpt}</p>
      <div class="prose">
        <Content />
      </div>
      <div class="ja__end card">
        <p class="t-title">Have a project this made you think about?</p>
        <Button href="/contact/" variant="lime">Start a conversation</Button>
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section theme-white" aria-labelledby="more-title">
        <div class="wrap">
          <h2 id="more-title" class="h-l ja__more-title">
            Keep <span class="mark">reading</span>
          </h2>
          <div class="ja__more">
            {more.map((p) => (
              <JournalCard post={p} sizes="(max-width: 760px) 100vw, 50vw" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .ja__back :global(.ja__back-arrow) {
    transform: rotate(180deg);
  }
  .ja__back:hover .btn__icon {
    transform: none;
  }
  .ja__title {
    max-width: 18ch;
  }
  .ja__meta {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-weight: 600;
    color: var(--muted);
    font-size: 14px;
  }
  .ja__cover .media {
    aspect-ratio: 21 / 9;
  }
  .ja__body {
    max-width: 860px;
    padding-block: clamp(36px, 4vw, 64px) var(--section);
  }
  .ja__excerpt {
    font-weight: 700;
    font-size: clamp(1.4rem, 2.2vw, 2.1rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: clamp(28px, 3vw, 48px);
  }
  .ja__end {
    margin-top: clamp(40px, 5vw, 72px);
    padding: 24px 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .ja__more-title {
    margin-bottom: clamp(28px, 3vw, 48px);
  }
  .ja__more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px var(--gutter);
  }
  @media (max-width: 760px) {
    .ja__cover .media {
      aspect-ratio: 4 / 3;
    }
    .ja__more {
      grid-template-columns: 1fr;
    }
  }
</style>
