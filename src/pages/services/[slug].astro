---
/**
 * One page per service, e.g. /services/social-media-marketing/. Each page leads
 * with the words people search for, answers "what is it" in plain language,
 * lists what's included and answers common questions, with matching Service,
 * FAQ and breadcrumb structured data.
 */
import { Picture, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import Arrow from '@/components/Arrow.astro';
import { services } from '@/data/services';
import { serviceSeo } from '@/data/service-seo';
import { breadcrumbs, faqPage, service as serviceSchema } from '@/lib/seo';
import { site } from '@/config/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: (typeof services)[number] };
const seo = serviceSeo[s.slug];
const others = services.filter((o) => o.slug !== s.slug);
const og = await getImage({ src: s.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site ?? site.url).href;

const schema = [
  serviceSchema(s, seo.description, ogUrl),
  faqPage(seo.faqs),
  breadcrumbs([
    { name: 'Services', path: '/services/' },
    { name: s.title, path: `/services/${s.slug}/` },
  ]),
];
---

<Base title={seo.title} description={seo.description} image={og.src} imageAlt={s.imageAlt} schema={schema}>
  <section class="page-intro sp__intro">
    <div class="wrap">
      <nav class="sp__crumbs label" aria-label="Breadcrumb">
        <a class="ulink" href="/services/">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{s.title}</span>
      </nav>
      <SectionHead label={`Service ${s.number}`} aside={`${services.length} disciplines, one team`} />
      <h1 class="sp__title mega">{s.title}</h1>
      <p class="sp__line h-s" data-reveal>{s.line}</p>
    </div>
  </section>

  <section class="wrap sp__body" aria-labelledby="sp-what">
    <div class="sp__media media" data-reveal-img>
      <Picture src={s.image} alt={s.imageAlt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 55vw" formats={['avif', 'webp']} loading="eager" />
    </div>
    <div class="sp__copy card">
      <h2 id="sp-what" class="h-s">What is {s.title.toLowerCase()}?</h2>
      <p>{seo.answer}</p>
      <p class="muted">{s.description}</p>
      <h2 class="h-s">What’s included</h2>
      <ul class="sp__list">
        {s.items.map((item) => <li>{item}</li>)}
      </ul>
      <Button href={`/contact/?service=${s.slug}`} variant="lime">Start a project like this</Button>
    </div>
  </section>

  <section class="section sp__faq" aria-labelledby="sp-faq">
    <div class="wrap">
      <SectionHead label="Questions" aside={s.title} />
      <h2 id="sp-faq" class="h-l sp__faq-title">{s.title}: common questions</h2>
      <div class="sp__qs">
        {
          seo.faqs.map((f, i) => (
            <details class="sp__q" open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <span class="sp__plus" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section theme-dark sp__more" aria-labelledby="sp-more">
    <div class="wrap">
      <h2 id="sp-more" class="h-l">More from the studio</h2>
      <ul class="sp__others">
        {
          others.map((o) => (
            <li>
              <a href={`/services/${o.slug}/`}>
                <span class="sp__on">{o.number}</span>
                <span class="sp__ot">{o.title}</span>
                <span class="btn__icon" aria-hidden="true">
                  <Arrow class="" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="sp__more-cta"><Button href="/services/" variant="ghost">All services</Button></div>
    </div>
  </section>
</Base>

<style>
  .sp__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }
  .sp__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  .sp__crumbs span {
    display: inline-flex;
    align-items: center;
  }
  .sp__title {
    display: block;
    white-space: normal;
    overflow-wrap: break-word;
    font-size: clamp(3.4rem, 11vw, 12rem);
    line-height: 0.84;
    margin-top: clamp(16px, 2vw, 28px);
  }
  .sp__line {
    margin-top: clamp(16px, 2vw, 28px);
    max-width: 28ch;
    text-transform: none;
    letter-spacing: -0.03em;
  }
  .sp__body {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 10px;
  }
  .sp__media {
    min-height: clamp(380px, 44vw, 640px);
  }
  .sp__media :global(img) {
    position: absolute;
    inset: 0;
  }
  .sp__copy {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
    padding: clamp(22px, 2.8vw, 40px);
  }
  .sp__copy .h-s {
    text-transform: none;
    letter-spacing: -0.03em;
  }
  .sp__copy .h-s + p {
    font-weight: 600;
  }
  .sp__list {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
    margin-block: 0 8px;
  }
  .sp__list li {
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .sp__faq-title {
    max-width: 18ch;
    margin-bottom: clamp(28px, 3vw, 48px);
    text-transform: none;
    letter-spacing: -0.04em;
  }
  .sp__qs {
    display: grid;
    gap: 10px;
    max-width: 900px;
  }
  .sp__q {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--card);
  }
  .sp__q summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    padding: 16px 20px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .sp__q summary::-webkit-details-marker {
    display: none;
  }
  .sp__plus {
    position: relative;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--lime);
  }
  .sp__plus::before,
  .sp__plus::after {
    content: '';
    position: absolute;
    left: 7px;
    right: 7px;
    top: 12px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }
  .sp__plus::after {
    transform: rotate(90deg);
  }
  .sp__q[open] .sp__plus::after {
    transform: rotate(0deg);
  }
  .sp__q p {
    padding: 0 20px 20px;
    max-width: 70ch;
    color: var(--muted);
  }
  .sp__more .h-l {
    margin-bottom: clamp(24px, 3vw, 40px);
    text-transform: none;
    letter-spacing: -0.04em;
  }
  .sp__others {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--gutter);
  }
  .sp__others a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    transition: color 0.3s;
  }
  .sp__others a:hover {
    color: var(--lime);
  }
  .sp__on {
    font-size: 12px;
    font-weight: 800;
    color: var(--lime);
  }
  .sp__ot {
    flex: 1;
  }
  .sp__more-cta {
    margin-top: clamp(28px, 3vw, 44px);
  }
  @media (max-width: 900px) {
    .sp__body,
    .sp__others {
      grid-template-columns: 1fr;
    }
    .sp__media {
      min-height: 320px;
    }
  }
  @media (max-width: 480px) {
    .sp__list {
      grid-template-columns: 1fr;
    }
  }
</style>
