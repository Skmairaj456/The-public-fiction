---
import Base from '@/layouts/Base.astro';
import ContactSection from '@/components/ContactSection.astro';
---

<Base
  title="Contact: Start a Branding, Social Media or Video Project"
  description="Tell THE PUBLIC FICTION about your brand, social media, Reels, photography or video production project. We read every enquiry and reply personally."
>
  <div class="ct">
    <ContactSection number="01" headingLevel="h1" />
  </div>
</Base>

<style>
  .ct :global(.contact) {
    padding-top: calc(var(--header-h) + clamp(48px, 7vw, 110px));
  }
</style>
