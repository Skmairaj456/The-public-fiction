---
import Base from '@/layouts/Base.astro';
import SplitHeading from '@/components/SplitHeading.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Button from '@/components/Button.astro';
import Sticker from '@/components/Sticker.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
const categories = [...new Set(projects.map((p) => p.data.category))];

// Two-column rhythm: wide/narrow, then narrow/wide.
const pattern = [
  { cls: 'wl--wide', ratio: '4 / 3' },
  { cls: 'wl--narrow', ratio: '4 / 5' },
  { cls: 'wl--narrow', ratio: '4 / 5' },
  { cls: 'wl--wide', ratio: '4 / 3' },
];
---

<Base
  title="Work: Branding, Campaign & Video Production Projects"
  description="Selected branding, campaign, social media, photography and video production projects by The Public Fiction, an independent creative and brand agency."
>
  <section class="page-intro wl__intro">
    <div class="wrap">
      <SectionHead label="Selected work" aside={`${projects.length} projects`} />
      <h1 class="wl__mega" data-split aria-label="Work">
        <span class="lm" aria-hidden="true"><span class="mega" data-fit>Work</span></span>
      </h1>
      <div class="page-intro__foot">
        <SplitHeading as="p" class="stack wl__stack" lines={['~Ideas, made', '>visible.']} />
        <p class="lede" data-reveal>Every project starts with a business problem and ends with something people actually notice.</p>
      </div>
      <Sticker name="star" class="wl__stk" data-pop />
    </div>
  </section>

  <section class="wl" aria-label="Projects">
    <div class="wrap">
      <div class="wl__filters" role="group" aria-label="Filter projects by category" data-filters>
        <button type="button" class="wl__filter" aria-pressed="true" data-filter="all">
          All <sup>{projects.length}</sup>
        </button>
        {
          categories.map((c) => (
            <button type="button" class="wl__filter" aria-pressed="false" data-filter={c}>
              {c} <sup>{projects.filter((p) => p.data.category === c).length}</sup>
            </button>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>

      {
        projects.length > 0 ? (
          <div class="wl__grid grid" data-grid>
            {projects.map((p, i) => {
              const slot = pattern[i % pattern.length];
              return (
                <ProjectCard
                  project={p}
                  index={i}
                  ratio={slot.ratio}
                  class={`wl__item ${slot.cls}`}
                  sizes={slot.cls === 'wl--wide' ? '(max-width: 760px) 100vw, 58vw' : '(max-width: 760px) 100vw, 40vw'}
                  eager={i < 2}
                />
              );
            })}
          </div>
        ) : (
          <p class="empty">The portfolio is being prepared. Check back soon.</p>
        )
      }
      <p class="empty" hidden data-filter-empty>No projects in this category yet.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="wl__cta theme-lime">
        <SplitHeading class="mega mega--s" lines={['Your project', 'could be next.']} />
        <div data-reveal><Button href="/contact/">Start a project</Button></div>
        <Sticker name="rocket" class="wl__cta-stk" />
      </div>
    </div>
  </section>
</Base>

<style>
  .wl__intro .wrap {
    position: relative;
  }
  .wl__mega .mega {
    display: block;
    font-size: 40vw;
    line-height: 0.8;
  }
  .wl__intro :global(.page-intro__foot > .wl__stack) {
    grid-column: 1 / span 7;
  }
  .wl__intro :global(.page-intro__foot > .lede) {
    grid-column: 9 / span 4;
  }
  @media (max-width: 900px) {
    .wl__intro :global(.page-intro__foot > .wl__stack),
    .wl__intro :global(.page-intro__foot > .lede) {
      grid-column: 1 / -1;
    }
  }
  .wl__intro :global(.wl__stk) {
    position: absolute;
    right: 8%;
    top: 22%;
    width: clamp(70px, 10vw, 150px);
    --r: 14deg;
  }
  .wl__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: clamp(28px, 3vw, 44px);
  }
  .wl__filter {
    min-height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 14px;
    font-weight: 700;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .wl__filter sup {
    font-size: 10px;
    margin-left: 2px;
    opacity: 0.6;
  }
  .wl__filter:hover {
    border-color: var(--ink);
  }
  .wl__filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--lime);
    border-color: var(--ink);
  }
  .wl__grid {
    row-gap: clamp(44px, 5vw, 84px);
    align-items: start;
  }
  .wl__grid :global(.wl--wide) {
    grid-column: span 7;
  }
  .wl__grid :global(.wl--narrow) {
    grid-column: span 5;
  }
  .wl__grid :global(.wl__item:nth-child(4n + 2)),
  .wl__grid :global(.wl__item:nth-child(4n + 3)) {
    margin-top: clamp(0px, 5vw, 88px);
  }
  .wl__grid[data-filtered='true'] :global(.wl__item) {
    grid-column: span 6;
    margin-top: 0;
  }
  /* A lone result fills the row instead of leaving half the page empty. */
  .wl__grid[data-filtered='true'][data-count='1'] :global(.wl__item) {
    grid-column: 1 / -1;
  }
  .wl__grid[data-filtered='true'][data-count='1'] :global(.pc__media) {
    aspect-ratio: 21 / 9 !important;
  }
  .wl__cta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(32px, 5vw, 80px);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  .wl__cta :global(.wl__cta-stk) {
    position: absolute;
    right: 28%;
    top: -10px;
    width: clamp(70px, 9vw, 130px);
    --r: 24deg;
    animation: bob 4s ease-in-out infinite;
  }
  @media (max-width: 760px) {
    .wl__grid[data-filtered='true'][data-count='1'] :global(.pc__media) {
      aspect-ratio: 4 / 3 !important;
    }
    .wl__grid :global(.wl__item),
    .wl__grid[data-filtered='true'] :global(.wl__item) {
      grid-column: 1 / -1;
      margin-top: 0 !important;
    }
    .wl__cta :global(.wl__cta-stk) {
      right: 6%;
    }
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const statusEl = document.querySelector<HTMLElement>('[data-filter-status]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  if (group && grid) {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-category]'));

    const apply = (filter: string) => {
      let shown = 0;
      items.forEach((item) => {
        const match = filter === 'all' || item.dataset.category === filter;
        item.hidden = !match;
        if (match) {
          shown++;
          item.querySelectorAll('[data-reveal-img]').forEach((el) => el.classList.add('is-in'));
        }
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      grid.dataset.filtered = String(filter !== 'all');
      grid.dataset.count = String(shown);
      if (empty) empty.hidden = shown > 0;
      if (statusEl) statusEl.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}${filter === 'all' ? '' : ` in ${filter}`}.`;

      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', filter);
      history.replaceState(null, '', url);
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));

    const initial = new URLSearchParams(location.search).get('category');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
  }
</script>
