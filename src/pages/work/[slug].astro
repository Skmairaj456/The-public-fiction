---
import { Picture, getImage } from 'astro:assets';
import { getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Button from '@/components/Button.astro';
import Arrow from '@/components/Arrow.astro';
import Asterisk from '@/components/Asterisk.astro';
import { site } from '@/config/site';
import { breadcrumbs } from '@/lib/seo';
import { getProjects, type Project } from '@/lib/content';
import { caseStudies, filled, isTodo } from '@/data/real-content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], all: projects },
  }));
}

interface Props {
  project: Project;
  next: Project;
  all: Project[];
}

const { project, next, all } = Astro.props;
const { data } = project;

let related: Project[] = data.related ? await getEntries(data.related) : [];
related = related.filter(Boolean);
if (related.length < 2) {
  const extra = all.filter((p) => p.id !== project.id && !related.some((r) => r.id === p.id) && p.data.category !== data.category);
  related = [...related, ...extra];
}
related = related.slice(0, 2);

const og = await getImage({ src: data.cover, width: 1200, height: 630, format: 'jpg', fit: 'cover' });

const chapters = [
  { n: '01', label: 'The challenge', text: data.challenge },
  { n: '02', label: 'Creative direction', text: data.direction },
  { n: '03', label: 'Execution', text: data.execution },
];

// Case-study facts from src/data/real-content.ts (hidden on the live site until filled in).
const facts = caseStudies[project.id];
const client = filled(facts?.client) ?? data.client;
const glance = [
  { label: 'The brief', value: filled(facts?.brief) },
  { label: 'What we did', value: filled(facts?.whatWeDid) },
  { label: 'The result', value: filled(facts?.result), result: true },
].filter((g) => g.value);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: data.title,
    about: data.summary,
    genre: data.category,
    creator: { '@type': 'Organization', name: site.name },
    ...(data.year ? { dateCreated: String(data.year) } : {}),
  },
  breadcrumbs([
    { name: 'Work', path: '/work/' },
    { name: data.title, path: Astro.url.pathname },
  ]),
];
---

<Base title={`${data.title}: ${data.category} Project`} description={data.summary} image={og.src} imageAlt={data.coverAlt} type="article" schema={schema}>
  <article class="cs" style={`--tone:${data.tone}`}>
    <header class="page-intro cs__intro">
      <div class="wrap">
        <div class="page-intro__meta">
          <a class="arrow-link cs__back" href="/work/"><span class="btn__icon" aria-hidden="true"><Arrow class="cs__back-arrow" /></span>All work</a>
          <span class="chip">{data.category}</span>
        </div>
        <h1 class="cs__title" data-split aria-label={data.title}>
          <span class="lm" aria-hidden="true"><span class="mega mega--m" style="--i:0">{data.title}</span></span>
        </h1>
        <p class="lede cs__summary" data-reveal>{data.summary}</p>
        <dl class="cs__facts" data-reveal style="--d:150">
          {
            client && (
              <div class:list={['card', isTodo(client) && 'is-todo']}>
                <dt class="label label--caps label--muted">Client</dt>
                <dd>{client}</dd>
              </div>
            )
          }
          <div class="card">
            <dt class="label label--caps label--muted">Category</dt>
            <dd><a class="ulink" href={`/work/?category=${encodeURIComponent(data.category)}`}>{data.category}</a></dd>
          </div>
          {
            data.year && (
              <div class="card">
                <dt class="label label--caps label--muted">Year</dt>
                <dd>{data.year}</dd>
              </div>
            )
          }
          {
            data.disciplines.length > 0 && (
              <div class="card cs__facts-wide">
                <dt class="label label--caps label--muted">Disciplines</dt>
                <dd>{data.disciplines.join(' · ')}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <figure class="wrap cs__cover">
      <div class="cs__cover-media media" data-reveal-img>
        {
          data.coverVideo ? (
            <video src={data.coverVideo} poster={og.src} autoplay muted loop playsinline preload="metadata" aria-label={data.coverAlt} />
          ) : (
            <div class="cs__cover-inner" data-parallax="-0.08">
              <Picture src={data.cover} alt={data.coverAlt} widths={[800, 1280, 1920, 2400]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
            </div>
          )
        }
      </div>
    </figure>

    <section class="section cs__overview" aria-label="Overview">
      <div class="wrap cs__overview-in">
        <p class="label"><Asterisk />Overview</p>
        <p class="cs__lede" data-reveal>{data.intro}</p>
      </div>
    </section>

    {
      glance.length > 0 && (
        <section class="wrap cs__glance" aria-labelledby="cs-glance">
          <h2 id="cs-glance" class="label label--caps">
            <Asterisk />
            At a glance
          </h2>
          <dl class="cs__glance-list">
            {glance.map((g) => (
              <div class:list={['card', g.result && 'cs__glance-result', isTodo(g.value) && 'is-todo']}>
                <dt class="label label--caps label--muted">{g.label}</dt>
                <dd>{g.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section class="wrap cs__chapters" aria-label="Project story">
      {
        chapters.map((c, i) => (
          <div class="cs__chapter card" data-reveal style={`--d:${i * 90}`}>
            <span class="cs__chapter-n">/{c.n}</span>
            <h2 class="h-s cs__chapter-label">{c.label}</h2>
            <p class="muted">{c.text}</p>
          </div>
        ))
      }
    </section>

    {
      data.gallery.length > 0 && (
        <section class="section cs__gallery" aria-label="Gallery">
          <div class="wrap">
            <div class="cs__grid grid">
              {data.gallery.map((g, i) => (
                <figure class={`cs__g cs__g--${g.size}`}>
                  <div class="media" data-reveal-img style={`--d:${(i % 2) * 120}`}>
                    <Picture
                      src={g.src}
                      alt={g.alt}
                      widths={g.size === 'full' ? [800, 1400, 2000] : [500, 900, 1300]}
                      sizes={g.size === 'full' ? '100vw' : g.size === 'tall' ? '(max-width: 760px) 100vw, 33vw' : '(max-width: 760px) 100vw, 60vw'}
                      formats={['avif', 'webp']}
                    />
                  </div>
                  {g.caption && (
                    <figcaption class="caption">
                      <span>{g.caption}</span>
                      <span>{String(i + 1).padStart(2, '0')}</span>
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      data.deliverables.length > 0 && (
        <section class="wrap" aria-labelledby="deliver-title">
          <div class="cs__deliver">
            <h2 id="deliver-title" class="mega mega--s">
              What we <span class="lime">delivered</span>
            </h2>
            <ul class="cs__deliver-list">
              {data.deliverables.map((d, i) => (
                <li data-reveal style={`--d:${i * 50}`}>
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  {d}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      next && next.id !== project.id && (
        <a class="wrap cs__next" href={`/work/${next.id}/`} data-cursor="Next">
          <span class="label label--caps label--muted">Next project</span>
          <span class="mega mega--m cs__next-title">
            {next.data.title}
            <span class="btn__icon cs__next-icon" aria-hidden="true">
              <Arrow class="" />
            </span>
          </span>
          <span class="cs__next-media media" aria-hidden="true">
            <Picture src={next.data.cover} alt="" widths={[400, 700]} sizes="28vw" formats={['avif', 'webp']} />
          </span>
        </a>
      )
    }

    {
      related.length > 0 && (
        <section class="section cs__related" aria-labelledby="related-title">
          <div class="wrap">
            <div class="cs__related-head">
              <h2 id="related-title" class="h-l">
                Related <span class="mark">work</span>
              </h2>
              <Button href="/work/" variant="ghost">
                All projects
              </Button>
            </div>
            <div class="cs__related-grid">
              {related.map((p) => (
                <ProjectCard project={p} ratio="4 / 3" sizes="(max-width: 760px) 100vw, 50vw" />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .cs__back :global(.cs__back-arrow) {
    transform: rotate(180deg);
  }
  .cs__back:hover .btn__icon {
    transform: none;
  }
  .cs__title .mega {
    display: block;
    white-space: normal;
  }
  .cs__summary {
    margin-top: 18px;
    max-width: 40ch;
  }
  .cs__glance {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .cs__glance-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .cs__glance-list > div {
    padding: 18px 20px;
  }
  .cs__glance-list dd {
    margin-top: 8px;
    font-weight: 600;
    line-height: 1.4;
  }
  .cs__glance-result {
    background: var(--lime);
    color: var(--ink);
    border-color: transparent;
  }
  .cs__glance-result dt {
    color: var(--ink) !important;
  }
  .cs__glance-result dd {
    font-size: 1.15rem;
    font-weight: 800;
  }
  .is-todo {
    outline: 1px dashed var(--line-strong);
  }
  @media (max-width: 900px) {
    .cs__glance-list {
      grid-template-columns: 1fr;
    }
  }
  .cs__facts {
    margin-top: clamp(28px, 3vw, 44px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .cs__facts > div {
    padding: 16px 18px;
  }
  .cs__facts dd {
    margin-top: 6px;
    font-weight: 700;
  }
  .cs__facts .cs__facts-wide {
    grid-column: span 2;
  }
  .cs__cover-media {
    height: clamp(380px, 82vh, 1000px);
    background: var(--tone);
  }
  .cs__cover-inner {
    position: absolute;
    inset: -8% 0;
  }
  .cs__cover-inner :global(img),
  .cs__cover-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs__overview-in {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: 16px var(--gutter);
  }
  .cs__lede {
    font-weight: 700;
    font-size: clamp(1.45rem, 2.7vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }
  .cs__chapters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .cs__chapter {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(22px, 2.4vw, 34px);
  }
  .cs__chapter-n {
    font-family: var(--f-mega);
    font-size: 3.2rem;
    line-height: 0.8;
    color: var(--tone);
  }
  .cs__grid {
    row-gap: var(--gutter);
    grid-auto-flow: dense;
    align-items: start;
  }
  .cs__g--full {
    grid-column: 1 / -1;
  }
  .cs__g--full .media {
    aspect-ratio: 16 / 9;
  }
  .cs__g--wide {
    grid-column: span 8;
  }
  .cs__g--wide .media {
    aspect-ratio: 3 / 2;
  }
  .cs__g--half {
    grid-column: span 6;
  }
  .cs__g--half .media {
    aspect-ratio: 4 / 5;
  }
  .cs__g--tall {
    grid-column: span 4;
  }
  .cs__g--tall .media {
    aspect-ratio: 3 / 4;
  }
  .cs__deliver {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 32px var(--gutter);
    padding: clamp(28px, 4vw, 64px);
    border-radius: var(--radius-l);
    background: var(--tone);
    color: var(--white);
  }
  .cs__deliver .lime {
    color: var(--lime);
  }
  .cs__deliver-list li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.4vw, 1.4rem);
    letter-spacing: -0.02em;
  }
  .cs__deliver-list span {
    font-size: 12px;
    color: var(--lime);
  }
  .cs__next {
    position: relative;
    display: grid;
    gap: 12px;
    padding-block: clamp(56px, 7vw, 110px);
  }
  .cs__next-title {
    display: flex;
    align-items: center;
    gap: 0.15em;
    white-space: normal;
    transition: color 0.3s;
  }
  .cs__next-icon {
    width: 0.6em;
    height: 0.6em;
    flex: none;
  }
  .cs__next-icon :global(svg) {
    width: 40%;
    height: 40%;
  }
  .cs__next:hover .cs__next-icon {
    transform: rotate(-45deg);
  }
  .cs__next-media {
    position: absolute !important;
    right: var(--gutter);
    top: 50%;
    width: min(26vw, 360px);
    aspect-ratio: 4 / 5;
    transform: translateY(-50%) scale(0.88) rotate(4deg);
    opacity: 0;
    transition:
      opacity 0.4s,
      transform 0.7s var(--spring);
  }
  .cs__next:hover .cs__next-media {
    opacity: 1;
    transform: translateY(-50%) scale(1) rotate(-3deg);
  }
  .cs__next-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs__related {
    padding-top: 0;
  }
  .cs__related-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(28px, 3vw, 48px);
  }
  .cs__related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px var(--gutter);
  }

  @media (max-width: 900px) {
    .cs__facts {
      grid-template-columns: 1fr 1fr;
    }
    .cs__overview-in,
    .cs__chapters,
    .cs__deliver {
      grid-template-columns: 1fr;
    }
    .cs__g--wide,
    .cs__g--half {
      grid-column: 1 / -1;
    }
    .cs__g--tall {
      grid-column: span 6;
    }
    .cs__next-media {
      display: none !important;
    }
  }
  @media (max-width: 600px) {
    .cs__facts,
    .cs__related-grid {
      grid-template-columns: 1fr;
    }
    .cs__facts .cs__facts-wide {
      grid-column: auto;
    }
    .cs__g--tall {
      grid-column: 1 / -1;
    }
    .cs__g--full .media {
      aspect-ratio: 4 / 5;
    }
  }
</style>
