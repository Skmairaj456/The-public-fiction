---
/**
 * A screen-filling word with an ink circle rising behind it. The word uses
 * mix-blend-mode: difference, so it reads dark on paper and light on ink.
 * Hands off seamlessly to a dark section below.
 */
import Sticker from './Sticker.astro';

interface Props {
  word: string;
  note?: string;
}
const { word, note } = Astro.props;
---

<section class="bw" aria-label={word} data-blob>
  <div class="bw__sticky">
    <div class="bw__circle" data-blob-circle aria-hidden="true"></div>
    <p class="bw__word mega" aria-hidden="true">{word}</p>
    {note && <p class="bw__note label label--caps" aria-hidden="true">{note}</p>}
    <Sticker name="sparkle" class="bw__stk" />
  </div>
</section>

<style>
  .bw {
    position: relative;
    background: var(--paper);
  }
  .bw__sticky {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 70vh;
    overflow: hidden;
    isolation: isolate;
    /* The blend group needs its own backdrop for the difference effect. */
    background: var(--paper);
  }
  .bw__circle {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 160vmax;
    height: 160vmax;
    margin-left: -80vmax;
    margin-top: -80vmax;
    border-radius: 50%;
    background: var(--ink);
    transform: translateY(var(--y, 72%)) scale(var(--sc, 0.18));
    z-index: 0;
  }
  .bw__word {
    position: relative;
    z-index: 1;
    color: #fff;
    mix-blend-mode: difference;
    font-size: clamp(5rem, 24vw, 27rem);
  }
  .bw__note {
    position: absolute;
    bottom: 32px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    text-align: center;
    z-index: 1;
    color: #fff;
    mix-blend-mode: difference;
  }
  .bw :global(.bw__stk) {
    position: absolute;
    z-index: 2;
    right: 12%;
    top: 16%;
    width: clamp(60px, 8vw, 120px);
    --r: 0deg;
    animation: bob 4s ease-in-out infinite;
  }

  :global(html.js:not(.reduce-motion)) .bw {
    height: 210vh;
  }
  :global(html.js:not(.reduce-motion)) .bw__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  :global(html.reduce-motion) .bw__circle,
  :global(html.no-js) .bw__circle {
    display: none;
  }
</style>

<script>
  if (!document.documentElement.classList.contains('reduce-motion')) {
    document.querySelectorAll<HTMLElement>('[data-blob]').forEach((section) => {
      const circle = section.querySelector<HTMLElement>('[data-blob-circle]')!;
      let ticking = false;
      const render = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const total = section.offsetHeight - innerHeight;
        const p = Math.min(1, Math.max(0, -rect.top / total));
        const t = 1 - Math.pow(1 - p, 2);
        // Rise from below, then swell until it covers the screen.
        circle.style.setProperty('--y', `${72 - t * 72}%`);
        circle.style.setProperty('--sc', String(0.18 + t * 1.35));
      };
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(render);
          }
        },
        { passive: true },
      );
      addEventListener('resize', render);
      render();
    });
  }
</script>
