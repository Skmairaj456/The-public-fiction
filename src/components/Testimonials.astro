---
/**
 * Client testimonials: 2–3 cards (quote, name, role, company, optional photo)
 * from src/data/real-content.ts → testimonials. Placeholder entries show in
 * local previews only; on the live site the section appears once at least one
 * real, approved quote is added.
 */
import { Image } from 'astro:assets';
import { testimonials, realOnly, isTodo } from '@/data/real-content';
import SectionHead from './SectionHead.astro';
import SplitHeading from './SplitHeading.astro';

const items = realOnly(testimonials, (t) => t.quote).slice(0, 3);
---

{
  items.length > 0 && (
    <section class="section tst theme-dark" aria-labelledby="tst-title">
      <div class="wrap">
        <SectionHead label="Client stories" aside={items.length > 1 ? `${items.length} voices` : undefined} />
        <SplitHeading id="tst-title" class="stack tst__title" lines={['~Words from', '>the other side.']} />
        <ul class="tst__grid">
          {items.map((t, i) => (
            <li class:list={['tst__item', isTodo(t.quote) && 'is-todo']} data-reveal style={`--d:${i * 90}`}>
              <figure>
                <span class="tst__mark" aria-hidden="true">
                  “
                </span>
                <blockquote class="tst__quote">
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption class="tst__who">
                  {t.photo && <Image src={t.photo} alt="" class="tst__photo" width={96} height={96} />}
                  <span>
                    <strong>{t.name}</strong>
                    <span class="muted">
                      {t.role}, {t.company}
                    </span>
                  </span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .tst__title {
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .tst__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 10px;
  }
  .tst__item figure {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
    padding: clamp(24px, 2.6vw, 40px);
    border-radius: var(--radius);
    background: var(--card);
  }
  .tst__item.is-todo figure {
    outline: 1px dashed var(--line-strong);
  }
  .tst__mark {
    font-family: var(--f-mega);
    font-size: 6rem;
    line-height: 0.5;
    height: 0.4em;
    color: var(--lime);
  }
  .tst__quote {
    font-weight: 600;
    font-size: clamp(1.15rem, 1.5vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .tst__who {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
  }
  .tst__who > span {
    display: grid;
    gap: 2px;
  }
  .tst__who :global(.tst__photo) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
</style>
