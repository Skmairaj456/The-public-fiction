---
/**
 * Testimonials from src/data/studio.ts. Only genuine, approved feedback belongs there.
 * The section is omitted from the live site until at least one entry exists.
 */
import { testimonials } from '@/data/studio';
import SectionHead from './SectionHead.astro';
import SplitHeading from './SplitHeading.astro';

interface Props {
  number?: string;
}
const show = testimonials.length > 0 || import.meta.env.DEV;
---

{
  show && (
    <section class="section tst theme-dark" aria-labelledby="tst-title">
      <div class="wrap">
        <SectionHead label="Client stories" aside={testimonials.length > 1 ? `${testimonials.length} voices` : undefined} />
        <SplitHeading id="tst-title" class="stack tst__title" lines={['~Words from', '>the other side.']} />

        {testimonials.length > 0 ? (
          <div class="tst__track">
            {testimonials.map((t, i) => (
              <figure class="tst__item" data-reveal style={`--d:${i * 90}`}>
                <span class="tst__mark" aria-hidden="true">
                  “
                </span>
                <blockquote class="tst__quote">
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption class="tst__who">
                  <strong>{t.name}</strong>
                  <span class="muted">
                    {t.role}
                    {t.company && `, ${t.company}`}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <p class="dev-note">
            <strong>Editor note (dev only):</strong> this section is hidden on the live site until real testimonials are
            added to <code>src/data/studio.ts → testimonials</code> (quote, name, role, company).
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .tst__title {
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .tst__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(300px, 46%);
    gap: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 16px;
  }
  .tst__item {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(24px, 2.6vw, 40px);
    border-radius: var(--radius);
    background: var(--card);
  }
  .tst__mark {
    font-family: var(--f-mega);
    font-size: 7rem;
    line-height: 0.5;
    height: 0.4em;
    color: var(--lime);
  }
  .tst__quote {
    font-weight: 600;
    font-size: clamp(1.25rem, 1.9vw, 1.85rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .tst__who {
    display: grid;
    gap: 2px;
    margin-top: auto;
  }
  @media (max-width: 700px) {
    .tst__track {
      grid-auto-columns: 88%;
    }
  }
</style>
