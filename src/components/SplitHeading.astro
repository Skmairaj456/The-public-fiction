---
/**
 * A heading revealed line by line.
 *
 * Inline markup in each line:
 *   *word*  → lime highlighter
 *   ^word^  → lime text (use on dark backgrounds)
 * Line prefixes (for the stacked "stack" style):
 *   ~       → dimmed (grey) line
 *   >       → indent one step (repeat for more)
 */
interface Props {
  lines: string[];
  as?: 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  /** Extra delay in ms before the first line moves. */
  delay?: number;
  id?: string;
  [key: string]: unknown;
}

const { lines, as: Tag = 'h2', class: className = 'h-l', delay = 0, id, ...rest } = Astro.props;

const escape = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const parse = (raw: string) => {
  let s = raw;
  let indent = 0;
  let dim = false;
  while (s.startsWith('>') || s.startsWith('~')) {
    if (s[0] === '>') indent++;
    else dim = true;
    s = s.slice(1);
  }
  const html = escape(s)
    .replace(/\*(.+?)\*/g, '<span class="mark">$1</span>')
    .replace(/\^(.+?)\^/g, '<span class="lime">$1</span>');
  return { html, indent, dim, text: s.replace(/[*^]/g, '') };
};

const parsed = lines.map(parse);
const label = parsed.map((p) => p.text).join(' ');
---

<Tag class={className} data-split style={`--d:${delay}`} aria-label={label} id={id} {...rest}>
  {
    parsed.map((line, i) => (
      <span class="lm" aria-hidden="true">
        <span class:list={[line.dim && 'is-dim']} style={`--i:${i};--indent:${line.indent * 1.2}`} set:html={line.html} />
      </span>
    ))
  }
</Tag>
