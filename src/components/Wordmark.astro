---
/**
 * The wordmark sets "THE PUBLIC" in grotesk and "fiction" in the serif italic:
 * the plain-spoken public voice next to the story it tells.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['wm', className]}>
  <span class="wm__a">The Public</span>
  <span class="wm__b">fiction</span>
</span>

<style>
  .wm {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .wm__b {
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    font-size: 1.22em;
    letter-spacing: -0.01em;
  }
</style>
