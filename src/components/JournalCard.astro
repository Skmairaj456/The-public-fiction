---
import { Picture } from 'astro:assets';
import { formatDate, type Post } from '@/lib/content';

interface Props {
  post: Post;
  variant?: 'large' | 'row';
  sizes?: string;
}
const { post, variant = 'row', sizes = '(max-width: 760px) 100vw, 33vw' } = Astro.props;
const { data } = post;
---

<article class:list={['jc', `jc--${variant}`]} data-reveal>
  <a href={`/journal/${post.id}/`} class="jc__link" data-cursor="Read">
    <div class="jc__media media" data-reveal-img>
      <Picture src={data.cover} alt={data.coverAlt} widths={[480, 800, 1200]} sizes={sizes} formats={['avif', 'webp']} />
    </div>
    <div class="jc__body">
      <p class="jc__meta label label--muted">
        <span>{data.topic}</span>
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      </p>
      <h3 class="jc__title">{data.title}</h3>
      {variant === 'large' && <p class="jc__excerpt muted">{data.excerpt}</p>}
    </div>
  </a>
</article>

<style>
  .jc__link {
    display: grid;
    gap: 18px;
  }
  .jc--large .jc__media {
    aspect-ratio: 4 / 3;
  }
  .jc--row .jc__link {
    grid-template-columns: minmax(120px, 34%) 1fr;
    gap: clamp(16px, 2vw, 28px);
    align-items: start;
  }
  .jc--row .jc__media {
    aspect-ratio: 4 / 3;
  }
  .jc__media :global(img) {
    transition: transform 1.2s var(--ease) !important;
  }
  .jc__link:hover .jc__media :global(img) {
    transform: scale(1.05) !important;
  }
  .jc__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 10px;
  }
  .jc__title {
    font-family: var(--f-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
    font-size: clamp(1.25rem, 1.7vw, 1.7rem);
    transition: color 0.3s;
  }
  .jc--large .jc__title {
    font-size: clamp(1.6rem, 2.6vw, 2.7rem);
    line-height: 1.02;
  }
  .jc__link:hover .jc__title {
    color: var(--signal);
  }
  .jc__excerpt {
    margin-top: 12px;
    max-width: 56ch;
  }
  @media (max-width: 520px) {
    .jc--row .jc__link {
      grid-template-columns: 1fr;
    }
  }
</style>
