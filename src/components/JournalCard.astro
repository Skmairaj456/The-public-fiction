---
import { Picture } from 'astro:assets';
import { formatDate, type Post } from '@/lib/content';

interface Props {
  post: Post;
  variant?: 'large' | 'row';
  sizes?: string;
}
const { post, variant = 'large', sizes = '(max-width: 760px) 100vw, 33vw' } = Astro.props;
const { data } = post;
---

<article class:list={['jc', `jc--${variant}`]} data-reveal>
  <a href={`/journal/${post.id}/`} class="jc__link" data-cursor="Read">
    <div class="jc__media media">
      <Picture src={data.cover} alt={data.coverAlt} widths={[480, 800, 1200]} sizes={sizes} formats={['avif', 'webp']} />
      <span class="chip jc__topic">{data.topic}</span>
    </div>
    <div class="jc__body">
      <time class="label label--muted" datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      <h3 class="jc__title">{data.title}</h3>
      {variant === 'large' && <p class="jc__excerpt muted">{data.excerpt}</p>}
    </div>
  </a>
</article>

<style>
  .jc__link {
    display: grid;
    gap: 16px;
    height: 100%;
  }
  .jc__media {
    aspect-ratio: 4 / 3;
  }
  .jc__media :global(img) {
    transition: transform 1.1s var(--ease);
  }
  .jc__link:hover .jc__media :global(img) {
    transform: scale(1.05);
  }
  .jc__topic {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--white);
    border: 0;
    color: var(--ink);
  }
  .jc--row .jc__link {
    grid-template-columns: minmax(120px, 36%) 1fr;
    align-items: center;
  }
  .jc--row .jc__topic {
    display: none;
  }
  .jc__body {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .jc__title {
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-size: clamp(1.2rem, 1.6vw, 1.6rem);
  }
  .jc__title {
    background: linear-gradient(var(--lime), var(--lime)) 0 88% / 0% 0.38em no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .jc__link:hover .jc__title {
    background-size: 100% 0.38em;
  }
  .jc__excerpt {
    max-width: 52ch;
  }
  @media (max-width: 520px) {
    .jc--row .jc__link {
      grid-template-columns: 1fr;
    }
  }
</style>
