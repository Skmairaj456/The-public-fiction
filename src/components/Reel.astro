---
/**
 * PLAY [frame] REEL — the frame between the two words grows to fill the
 * screen as the section scrolls past, cycling through a sequence of stills.
 * A small corner button pauses the slideshow (anything that moves by itself
 * needs one). A "Play reel" button opening the showreel in a modal appears
 * only when src/data/real-content.ts → showreel.showReel is true and a video
 * is set; otherwise there is no dead control.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { showreel } from '@/data/real-content';

interface Props {
  frames: { src: ImageMetadata; alt: string }[];
  caption?: string;
}
const { frames, caption = 'Strategy · Story · Production' } = Astro.props;
const hasReel = showreel.showReel && Boolean(showreel.src);
---

<section class="reel theme-dark" aria-label="Reel" data-reel>
  <div class="reel__sticky">
    <div class="reel__words" aria-hidden="true">
      <span class="mega lime reel__w reel__w--l" data-reel-l>Play</span>
      <span class="mega lime reel__w reel__w--r" data-reel-r>Reel</span>
    </div>

    <div class="reel__frame" data-reel-frame>
      {
        frames.map((f, i) => (
          <div class:list={['reel__slide', i === 0 && 'is-on']} data-reel-slide>
            <Picture src={f.src} alt={f.alt} widths={[640, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        ))
      }
      {
        hasReel && (
          <button class="pill reel__btn" type="button" aria-haspopup="dialog" aria-controls="showreel-dialog" data-reel-open>
            <span class="reel__play" aria-hidden="true" />
            Play reel
          </button>
        )
      }
      <p class="reel__cap label label--caps">{caption}</p>
      <div class="reel__count label">
        <button class="reel__toggle" type="button" aria-label="Pause slideshow" data-reel-toggle>
          <span class="reel__icon" aria-hidden="true" data-reel-icon />
          <span data-reel-label>Pause</span>
        </button>
        <span aria-hidden="true"><span data-reel-n>01</span> / {String(frames.length).padStart(2, '0')}</span>
      </div>
    </div>

    <p class="reel__hint label label--caps label--muted" aria-hidden="true">[ Scroll ]</p>
  </div>
  {
    hasReel && (
      <dialog class="reel__dialog" id="showreel-dialog" aria-labelledby="showreel-title" data-reel-dialog>
        <div class="reel__dialog-in">
          <div class="reel__dialog-bar">
            <h2 id="showreel-title" class="label label--caps">
              {showreel.title}
            </h2>
            <button type="button" class="reel__close" aria-label="Close showreel" data-reel-close>
              <span aria-hidden="true">×</span>
            </button>
          </div>
          <video src={showreel.src} poster={showreel.poster || undefined} controls playsinline preload="none" data-reel-video>
            <a href={showreel.src}>Download the showreel</a>
          </video>
        </div>
      </dialog>
    )
  }
</section>

<style>
  .reel {
    position: relative;
  }
  .reel__sticky {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--section) var(--gutter);
    gap: 24px;
    overflow: hidden;
  }
  .reel__words {
    display: flex;
    justify-content: center;
    gap: 0.25em;
  }
  .reel__w {
    font-size: clamp(5rem, 17vw, 19rem);
  }
  .reel__frame {
    position: relative;
    width: min(100%, 1400px);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--char);
  }
  .reel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }
  .reel__slide.is-on {
    opacity: 1;
  }
  .reel__slide :global(picture),
  .reel__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel__slide.is-on :global(img) {
    animation: kenburns 7s linear both;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  .reel__btn {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.4s var(--spring);
  }
  .reel__btn:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .reel__play {
    width: 0;
    height: 0;
    border-left: 11px solid currentColor;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    margin-right: 4px;
  }
  .reel__count {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .reel__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(14, 15, 17, 0.55);
    color: var(--white);
    font: inherit;
    font-weight: 700;
    text-shadow: none;
    backdrop-filter: blur(6px);
    transition: background 0.3s;
  }
  .reel__toggle:hover {
    background: rgba(14, 15, 17, 0.8);
  }
  .reel__toggle:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }
  .reel__icon {
    position: relative;
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .reel__toggle[data-state='paused'] .reel__icon {
    width: 0;
    border-right: 0;
    border-left: 10px solid currentColor;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
  .reel__dialog {
    width: min(92vw, 1280px);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
  }
  .reel__dialog::backdrop {
    background: rgba(14, 15, 17, 0.85);
  }
  .reel__dialog-in {
    display: grid;
  }
  .reel__dialog-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 10px 10px 20px;
  }
  .reel__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    font-size: 26px;
    line-height: 1;
  }
  .reel__close:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }
  .reel__dialog video {
    display: block;
    width: 100%;
    max-height: calc(92vh - 64px);
    background: #000;
  }
  .reel__cap,
  .reel__count {
    position: absolute;
    bottom: 18px;
    z-index: 2;
    color: var(--white);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }
  .reel__cap {
    left: 20px;
  }
  .reel__count {
    right: 20px;
  }
  .reel__hint {
    display: none;
  }

  /* Scroll-driven version.
     The section tucks one screen up under the end of the word tunnel, so its
     stage pins at the exact moment the tunnel lets go. Nothing is moved
     against the scroll in JS (that lags a frame behind native scrolling on
     phones and shakes). Until it pins, the stage is see-through. */
  :global(html.js:not(.reduce-motion)) .reel {
    height: 360vh;
    margin-top: -100vh;
    margin-top: -100svh;
    background: transparent;
  }
  :global(html.js:not(.reduce-motion)) .reel__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding: 0;
    display: block;
    background: transparent;
  }
  :global(html.js:not(.reduce-motion)) .reel__sticky > * {
    visibility: hidden;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-pinned .reel__sticky {
    background: var(--ink);
  }
  :global(html.js:not(.reduce-motion)) .reel.is-pinned .reel__sticky > * {
    visibility: visible;
  }
  :global(html.js:not(.reduce-motion)) .reel__words {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(150px, 22vw, 360px);
  }
  /* The frame is always full screen; a clip mask reveals it. Growing a mask
     is far cheaper than resizing the frame and its photo every frame. */
  :global(html.js:not(.reduce-motion)) .reel__frame {
    position: absolute;
    inset: 0;
    width: auto;
    height: auto;
    aspect-ratio: auto;
    border-radius: 0;
    clip-path: inset(var(--iy, 50vh) var(--ix, 50vw) round var(--fr, 16px));
    will-change: clip-path;
  }
  :global(html.js:not(.reduce-motion)) .reel__cap {
    translate: var(--ix, 0px) calc(-1 * var(--iy, 0px));
  }
  :global(html.js:not(.reduce-motion)) .reel__count {
    translate: calc(-1 * var(--ix, 0px)) calc(-1 * var(--iy, 0px));
  }
  :global(html.js:not(.reduce-motion)) .reel__hint {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26px;
    text-align: center;
    z-index: 3;
  }
  @media (max-width: 700px) {
    :global(html.js:not(.reduce-motion)) .reel__words {
      flex-direction: column;
      gap: 54vh;
    }
  }
</style>

<script>
  const reduce = document.documentElement.classList.contains('reduce-motion');

  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((section) => {
    const slides = Array.from(section.querySelectorAll<HTMLElement>('[data-reel-slide]'));
    const toggle = section.querySelector<HTMLButtonElement>('[data-reel-toggle]')!;
    const label = section.querySelector<HTMLElement>('[data-reel-label]')!;
    const count = section.querySelector<HTMLElement>('[data-reel-n]')!;
    const frame = section.querySelector<HTMLElement>('[data-reel-frame]')!;
    const wl = section.querySelector<HTMLElement>('[data-reel-l]')!;
    const wr = section.querySelector<HTMLElement>('[data-reel-r]')!;
    const words = section.querySelector<HTMLElement>('.reel__words')!;
    const hint = section.querySelector<HTMLElement>('.reel__hint')!;

    // Slideshow
    let i = 0;
    let timer = 0;
    let playing = !reduce;
    const show = (n: number) => {
      slides[i].classList.remove('is-on');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-on');
      count.textContent = String(i + 1).padStart(2, '0');
    };
    const start = () => {
      clearInterval(timer);
      timer = window.setInterval(() => show(i + 1), 2800);
    };
    const set = (on: boolean) => {
      playing = on;
      label.textContent = on ? 'Pause' : 'Play';
      toggle.setAttribute('aria-label', on ? 'Pause slideshow' : 'Play slideshow');
      toggle.dataset.state = on ? 'playing' : 'paused';
      on ? start() : clearInterval(timer);
    };
    toggle.addEventListener('click', () => set(!playing));
    set(playing);

    // Showreel modal: a native <dialog> opened as modal keeps focus inside it
    // and closes on Esc; the video pauses and focus returns to the button.
    const opener = section.querySelector<HTMLButtonElement>('[data-reel-open]');
    const dialog = section.querySelector<HTMLDialogElement>('[data-reel-dialog]');
    if (opener && dialog) {
      const video = dialog.querySelector<HTMLVideoElement>('[data-reel-video]');
      const close = dialog.querySelector<HTMLButtonElement>('[data-reel-close]')!;
      let wasPlaying = false;
      opener.addEventListener('click', () => {
        wasPlaying = playing;
        set(false);
        dialog.showModal();
        close.focus();
        video?.play().catch(() => {});
      });
      close.addEventListener('click', () => dialog.close());
      // Click on the dark backdrop closes too.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        video?.pause();
        opener.focus();
        if (wasPlaying && !reduce) set(true);
      });
      // Keep Tab inside the dialog (browsers that let focus escape to the page).
      dialog.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        // Only what can actually take focus (the link inside <video> is a no-video fallback).
        const els = Array.from(dialog.querySelectorAll<HTMLElement>('button, video[controls]'));
        const first = els[0];
        const last = els[els.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }

    if (reduce) return;

    // Grow the frame with scroll.
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    let ticking = false;
    let pinned = false;
    const render = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const W = innerWidth;
      const H = innerHeight;
      // Pinned once the stage reaches the top (the tunnel has just let go).
      const isPinned = rect.top <= 0.5 && rect.bottom > H * 0.5;
      if (isPinned !== pinned) {
        pinned = isPinned;
        section.classList.toggle('is-pinned', pinned);
      }
      const total = section.offsetHeight - H;
      const p = Math.min(1, Math.max(0, -rect.top / total));
      // 0 → 0.16: grow out of the centre where the tunnel vanished.
      const e = ease(Math.min(1, p / 0.16));
      // 0.16 → 0.85: the frame opens to full screen, the words part.
      const t = ease(Math.min(1, Math.max(0, (p - 0.16) / 0.69)));
      const small = W < 700;
      const w0 = small ? 0.58 : 0.18;
      const h0 = small ? 0.34 : 0.56;
      const sc = 0.02 + 0.98 * e;
      const w = lerp(w0 * W, W, t) * sc;
      const h = lerp(h0 * H, H, t) * sc;
      frame.style.setProperty('--ix', `${((W - w) / 2).toFixed(1)}px`);
      frame.style.setProperty('--iy', `${((H - h) / 2).toFixed(1)}px`);
      frame.style.setProperty('--fr', `${lerp(16, 0, t).toFixed(1)}px`);
      const push = t * (small ? H * 0.4 : W * 0.32);
      wl.style.transform = small ? `translate3d(0, ${(-push).toFixed(1)}px, 0)` : `translate3d(${(-push).toFixed(1)}px, 0, 0)`;
      wr.style.transform = small ? `translate3d(0, ${push.toFixed(1)}px, 0)` : `translate3d(${push.toFixed(1)}px, 0, 0)`;
      wl.style.opacity = wr.style.opacity = String(1 - t);
      words.style.opacity = hint.style.opacity = e.toFixed(3);
      words.style.transform = e < 1 ? `scale(${(0.4 + 0.6 * e).toFixed(4)})` : '';
    };
    const req = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };
    // Only measure while on screen, so it never forces a layout in the
    // middle of the word tunnel's animation frame.
    let visible = false;
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        req();
      },
      { rootMargin: '100px' },
    ).observe(section);
    addEventListener('scroll', () => visible && req(), { passive: true });
    addEventListener('resize', req);
    render();
  });
</script>
