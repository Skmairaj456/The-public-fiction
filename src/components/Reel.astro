---
/**
 * PLAY [frame] REEL — the frame between the two words grows to fill the
 * screen as the section scrolls past, cycling through a sequence of stills.
 * A small corner button pauses the slideshow (anything that moves by itself
 * needs one). A "Play reel" button opening the showreel in a modal appears
 * only when src/data/real-content.ts → showreel.showReel is true and a video
 * is set; otherwise there is no dead control.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { showreel } from '@/data/real-content';

interface Props {
  frames: { src: ImageMetadata; alt: string }[];
  caption?: string;
}
const { frames, caption = 'Strategy · Story · Production' } = Astro.props;
const hasReel = showreel.showReel && Boolean(showreel.src);
---

<section class="reel theme-dark" aria-label="Reel" data-reel>
  <div class="reel__sticky">
    <div class="reel__bg" aria-hidden="true" data-reel-bg></div>
    <div class="reel__words" aria-hidden="true">
      <span class="mega lime reel__w reel__w--l" data-reel-l>Play</span>
      <span class="mega lime reel__w reel__w--r" data-reel-r>Reel</span>
    </div>

    <div class="reel__frame" data-reel-frame>
      <div class="reel__inner" data-reel-inner>
      {
        frames.map((f, i) => (
          <div class:list={['reel__slide', i === 0 && 'is-on']} data-reel-slide>
            <Picture src={f.src} alt={f.alt} widths={[640, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        ))
      }
      {
        hasReel && (
          <button class="pill reel__btn" type="button" aria-haspopup="dialog" aria-controls="showreel-dialog" data-reel-open>
            <span class="reel__play" aria-hidden="true" />
            Play reel
          </button>
        )
      }
      <p class="reel__cap label label--caps">{caption}</p>
      <div class="reel__count label">
        <button class="reel__toggle" type="button" aria-label="Pause slideshow" data-reel-toggle>
          <span class="reel__icon" aria-hidden="true" data-reel-icon />
          <span data-reel-label>Pause</span>
        </button>
        <span aria-hidden="true"><span data-reel-n>01</span> / {String(frames.length).padStart(2, '0')}</span>
      </div>
      </div>
    </div>
    <span class="reel__corner" aria-hidden="true" data-corner="tl"></span>
    <span class="reel__corner" aria-hidden="true" data-corner="tr"></span>
    <span class="reel__corner" aria-hidden="true" data-corner="bl"></span>
    <span class="reel__corner" aria-hidden="true" data-corner="br"></span>

    <p class="reel__hint label label--caps label--muted" aria-hidden="true">[ Scroll ]</p>
  </div>
  {
    hasReel && (
      <dialog class="reel__dialog" id="showreel-dialog" aria-labelledby="showreel-title" data-reel-dialog>
        <div class="reel__dialog-in">
          <div class="reel__dialog-bar">
            <h2 id="showreel-title" class="label label--caps">
              {showreel.title}
            </h2>
            <button type="button" class="reel__close" aria-label="Close showreel" data-reel-close>
              <span aria-hidden="true">×</span>
            </button>
          </div>
          <video src={showreel.src} poster={showreel.poster || undefined} controls playsinline preload="none" data-reel-video>
            <a href={showreel.src}>Download the showreel</a>
          </video>
        </div>
      </dialog>
    )
  }
</section>

<style>
  .reel {
    position: relative;
  }
  .reel__sticky {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--section) var(--gutter);
    gap: 24px;
    overflow: hidden;
  }
  .reel__words {
    display: flex;
    justify-content: center;
    gap: 0.25em;
  }
  .reel__w {
    font-size: clamp(5rem, 17vw, 19rem);
  }
  .reel__frame {
    position: relative;
    width: min(100%, 1400px);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--char);
  }
  .reel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }
  .reel__slide.is-on {
    opacity: 1;
  }
  .reel__slide :global(picture),
  .reel__slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel__slide.is-on :global(img) {
    animation: kenburns 7s linear both;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  .reel__btn {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.4s var(--spring);
  }
  .reel__btn:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .reel__play {
    width: 0;
    height: 0;
    border-left: 11px solid currentColor;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    margin-right: 4px;
  }
  .reel__count {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .reel__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(14, 15, 17, 0.55);
    color: var(--white);
    font: inherit;
    font-weight: 700;
    text-shadow: none;
    backdrop-filter: blur(6px);
    transition: background 0.3s;
  }
  .reel__toggle:hover {
    background: rgba(14, 15, 17, 0.8);
  }
  .reel__toggle:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }
  .reel__icon {
    position: relative;
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .reel__toggle[data-state='paused'] .reel__icon {
    width: 0;
    border-right: 0;
    border-left: 10px solid currentColor;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
  .reel__dialog {
    width: min(92vw, 1280px);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
  }
  .reel__dialog::backdrop {
    background: rgba(14, 15, 17, 0.85);
  }
  .reel__dialog-in {
    display: grid;
  }
  .reel__dialog-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 10px 10px 20px;
  }
  .reel__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    font-size: 26px;
    line-height: 1;
  }
  .reel__close:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }
  .reel__dialog video {
    display: block;
    width: 100%;
    max-height: calc(92vh - 64px);
    background: #000;
  }
  .reel__cap,
  .reel__count {
    position: absolute;
    bottom: 18px;
    z-index: 2;
    color: var(--white);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }
  .reel__cap {
    left: 20px;
  }
  .reel__count {
    right: 20px;
  }
  .reel__hint {
    display: none;
  }
  /* Only the scroll-driven version below uses these. */
  .reel__inner {
    display: contents;
  }
  .reel__bg,
  .reel__corner {
    display: none;
  }

  /* Scroll-driven version.
     The section tucks one screen up under the end of the word tunnel, so its
     stage pins at the exact moment the tunnel lets go. Nothing is moved
     against the scroll in JS (that lags a frame behind native scrolling on
     phones and shakes). Until it pins, the stage is see-through. */
  :global(html.js:not(.reduce-motion)) .reel {
    height: 360vh;
    margin-top: -100vh;
    margin-top: -100svh;
    background: transparent;
  }
  :global(html.js:not(.reduce-motion)) .reel__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding: 0;
    display: block;
    background: transparent;
  }
  :global(html.js:not(.reduce-motion)) .reel__sticky > * {
    visibility: hidden;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-pinned .reel__sticky {
    background: var(--ink);
  }
  :global(html.js:not(.reduce-motion)) .reel.is-pinned .reel__sticky > * {
    visibility: visible;
  }
  :global(html.js:not(.reduce-motion)) .reel__words {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(150px, 22vw, 360px);
  }
  /* The frame is always full screen; a clip mask reveals it. Growing a mask
     is far cheaper than resizing the frame and its photo every frame. */
  :global(html.js:not(.reduce-motion)) .reel__frame {
    position: absolute;
    inset: 0;
    width: auto;
    height: auto;
    aspect-ratio: auto;
    border-radius: 0;
    clip-path: inset(var(--iy, 50vh) var(--ix, 50vw) round var(--fr, 16px));
    will-change: clip-path;
  }
  :global(html.js:not(.reduce-motion)) .reel__cap {
    translate: var(--ix, 0px) calc(-1 * var(--iy, 0px));
  }
  :global(html.js:not(.reduce-motion)) .reel__count {
    translate: calc(-1 * var(--ix, 0px)) calc(-1 * var(--iy, 0px));
  }
  /* Scroll-driven version (.is-sd, set by the script where the browser can
     play animations off the scroll position). Everything here moves by
     transform and opacity only, which the GPU animates in step with the
     scroll: the frame grows by scaling (its contents scaled back so the photo
     stays true), rounded corners are four ink corner pieces that ride its
     edges, and the stage fades in an ink backdrop instead of switching its
     background. */
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__sticky > * {
    visibility: visible;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__bg {
    display: block;
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__frame {
    clip-path: none;
    overflow: hidden;
    transform-origin: 50% 50%;
    opacity: 0;
    will-change: transform, opacity;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__inner {
    display: block;
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__cap,
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__count {
    translate: none;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__words,
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__hint {
    opacity: 0;
  }
  :global(html.js:not(.reduce-motion)) .reel.is-sd .reel__corner {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 16px;
    height: 16px;
    transform-origin: 0 0;
    opacity: 0;
    will-change: transform, opacity;
    pointer-events: none;
  }
  .reel__corner[data-corner='tl'] {
    background: radial-gradient(circle at 100% 100%, transparent 15.5px, var(--ink) 16px);
  }
  .reel__corner[data-corner='tr'] {
    background: radial-gradient(circle at 0% 100%, transparent 15.5px, var(--ink) 16px);
  }
  .reel__corner[data-corner='bl'] {
    background: radial-gradient(circle at 100% 0%, transparent 15.5px, var(--ink) 16px);
  }
  .reel__corner[data-corner='br'] {
    background: radial-gradient(circle at 0% 0%, transparent 15.5px, var(--ink) 16px);
  }
  :global(html.js:not(.reduce-motion)) .reel__hint {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26px;
    text-align: center;
    z-index: 3;
  }
  @media (max-width: 700px) {
    :global(html.js:not(.reduce-motion)) .reel__words {
      flex-direction: column;
      gap: 54vh;
    }
  }
</style>

<script>
  import { scrollDriven, bake, bakeStep, docTop, onLayout, whileNear } from '../scripts/scrollDriven';

  const reduce = document.documentElement.classList.contains('reduce-motion');

  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((section) => {
    const slides = Array.from(section.querySelectorAll<HTMLElement>('[data-reel-slide]'));
    const toggle = section.querySelector<HTMLButtonElement>('[data-reel-toggle]')!;
    const label = section.querySelector<HTMLElement>('[data-reel-label]')!;
    const count = section.querySelector<HTMLElement>('[data-reel-n]')!;
    const frame = section.querySelector<HTMLElement>('[data-reel-frame]')!;
    const wl = section.querySelector<HTMLElement>('[data-reel-l]')!;
    const wr = section.querySelector<HTMLElement>('[data-reel-r]')!;
    const words = section.querySelector<HTMLElement>('.reel__words')!;
    const hint = section.querySelector<HTMLElement>('.reel__hint')!;

    // Slideshow
    let i = 0;
    let timer = 0;
    let playing = !reduce;
    const show = (n: number) => {
      slides[i].classList.remove('is-on');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-on');
      count.textContent = String(i + 1).padStart(2, '0');
    };
    const start = () => {
      clearInterval(timer);
      timer = window.setInterval(() => show(i + 1), 2800);
    };
    const set = (on: boolean) => {
      playing = on;
      label.textContent = on ? 'Pause' : 'Play';
      toggle.setAttribute('aria-label', on ? 'Pause slideshow' : 'Play slideshow');
      toggle.dataset.state = on ? 'playing' : 'paused';
      on ? start() : clearInterval(timer);
    };
    toggle.addEventListener('click', () => set(!playing));
    set(playing);

    // Showreel modal: a native <dialog> opened as modal keeps focus inside it
    // and closes on Esc; the video pauses and focus returns to the button.
    const opener = section.querySelector<HTMLButtonElement>('[data-reel-open]');
    const dialog = section.querySelector<HTMLDialogElement>('[data-reel-dialog]');
    if (opener && dialog) {
      const video = dialog.querySelector<HTMLVideoElement>('[data-reel-video]');
      const close = dialog.querySelector<HTMLButtonElement>('[data-reel-close]')!;
      let wasPlaying = false;
      opener.addEventListener('click', () => {
        wasPlaying = playing;
        set(false);
        dialog.showModal();
        close.focus();
        video?.play().catch(() => {});
      });
      close.addEventListener('click', () => dialog.close());
      // Click on the dark backdrop closes too.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        video?.pause();
        opener.focus();
        if (wasPlaying && !reduce) set(true);
      });
      // Keep Tab inside the dialog (browsers that let focus escape to the page).
      dialog.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        // Only what can actually take focus (the link inside <video> is a no-video fallback).
        const els = Array.from(dialog.querySelectorAll<HTMLElement>('button, video[controls]'));
        const first = els[0];
        const last = els[els.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }

    if (reduce) return;

    // Grow the frame with scroll. The scene is a pure function of scrollY,
    // from layout numbers cached here.
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    let top = 0;
    let height = 1;
    let W = innerWidth;
    let H = innerHeight;
    const measure = () => {
      W = innerWidth;
      H = innerHeight;
      top = docTop(section);
      height = section.offsetHeight;
    };
    const scene = (y: number) => {
      const rectTop = top - y;
      const p = Math.min(1, Math.max(0, -rectTop / Math.max(1, height - H)));
      // 0 → 0.16: grow out of the centre where the tunnel vanished.
      const e = ease(Math.min(1, p / 0.16));
      // 0.16 → 0.85: the frame opens to full screen, the words part.
      const t = ease(Math.min(1, Math.max(0, (p - 0.16) / 0.69)));
      const small = W < 700;
      const w0 = small ? 0.58 : 0.18;
      const h0 = small ? 0.34 : 0.56;
      const sc = 0.02 + 0.98 * e;
      const w = Math.max(1, lerp(w0 * W, W, t) * sc);
      const h = Math.max(1, lerp(h0 * H, H, t) * sc);
      const push = t * (small ? H * 0.4 : W * 0.32);
      return {
        ix: (W - w) / 2,
        iy: (H - h) / 2,
        w,
        h,
        r: Math.min(lerp(16, 0, t), w / 2, h / 2),
        wl: small ? `translate3d(0, ${(-push).toFixed(1)}px, 0)` : `translate3d(${(-push).toFixed(1)}px, 0, 0)`,
        wr: small ? `translate3d(0, ${push.toFixed(1)}px, 0)` : `translate3d(${push.toFixed(1)}px, 0, 0)`,
        wo: 1 - t,
        e,
        ws: `scale(${(0.4 + 0.6 * e).toFixed(4)})`,
        // Pinned once the stage reaches the top (the tunnel has just let go).
        pinned: rectTop <= 0.5 && rectTop + height > H * 0.5,
      };
    };

    if (scrollDriven) {
      // The browser plays the scene straight off the scroll position, using
      // transform and opacity only (see the .is-sd styles).
      section.classList.add('is-sd');
      const bg = section.querySelector<HTMLElement>('[data-reel-bg]')!;
      const inner = section.querySelector<HTMLElement>('[data-reel-inner]')!;
      const cap = section.querySelector<HTMLElement>('.reel__cap')!;
      const counter = section.querySelector<HTMLElement>('.reel__count')!;
      const corners = Array.from(section.querySelectorAll<HTMLElement>('[data-corner]'));
      const f = (n: number) => n.toFixed(2);
      const gated = (y: number, v: number) => (scene(y).pinned ? v : 0).toFixed(3);
      let a: Record<string, Animation | null> = {};
      const gate = whileNear(section, () => Object.values(a));
      onLayout(() => {
        measure();
        // From just before the pin to just after it lets go.
        const y0 = top - 2;
        const y1 = top + height - H * 0.5 + 2;
        const N = 160;
        a = {
          bg: bakeStep(bg, a.bg ?? null, top - 0.5, top + height - H * 0.5, { opacity: '0' }, { opacity: '1' }),
          frame: bake(frame, a.frame ?? null, y0, y1, (y) => {
            const s = scene(y);
            return { transform: `scale(${(s.w / W).toFixed(5)}, ${(s.h / H).toFixed(5)})`, opacity: s.pinned ? '1' : '0' };
          }, N),
          inner: bake(inner, a.inner ?? null, y0, y1, (y) => {
            const s = scene(y);
            return { transform: `scale(${(W / s.w).toFixed(5)}, ${(H / s.h).toFixed(5)})` };
          }, N),
          cap: bake(cap, a.cap ?? null, y0, y1, (y) => {
            const s = scene(y);
            return { transform: `translate(${f(s.ix)}px, ${f(-s.iy)}px)` };
          }, N),
          counter: bake(counter, a.counter ?? null, y0, y1, (y) => {
            const s = scene(y);
            return { transform: `translate(${f(-s.ix)}px, ${f(-s.iy)}px)` };
          }, N),
          words: bake(words, a.words ?? null, y0, y1, (y) => ({ opacity: gated(y, scene(y).e), transform: scene(y).ws }), N),
          wl: bake(wl, a.wl ?? null, y0, y1, (y) => ({ transform: scene(y).wl, opacity: scene(y).wo.toFixed(3) }), N),
          wr: bake(wr, a.wr ?? null, y0, y1, (y) => ({ transform: scene(y).wr, opacity: scene(y).wo.toFixed(3) }), N),
          hint: bake(hint, a.hint ?? null, y0, y1, (y) => ({ opacity: gated(y, scene(y).e) }), N),
        };
        // Rounded corners: an ink corner piece rides each corner of the frame.
        corners.forEach((c) => {
          const k = c.dataset.corner!;
          a[k] = bake(c, a[k] ?? null, y0, y1, (y) => {
            const s = scene(y);
            const x = k.endsWith('l') ? s.ix : W - s.ix - s.r;
            const yy = k.startsWith('t') ? s.iy : H - s.iy - s.r;
            return { transform: `translate(${f(x)}px, ${f(yy)}px) scale(${(s.r / 16).toFixed(4)})`, opacity: s.pinned ? '1' : '0' };
          }, N);
        });
        gate();
      });
      return;
    }

    // Fallback: drive the same scene from scroll events while on screen.
    let ticking = false;
    let pinned = false;
    const render = () => {
      ticking = false;
      const s = scene(scrollY);
      if (s.pinned !== pinned) {
        pinned = s.pinned;
        section.classList.toggle('is-pinned', pinned);
      }
      // The clip mask and the caption/counter (which ride its corners) read these.
      frame.style.setProperty('--ix', `${s.ix.toFixed(1)}px`);
      frame.style.setProperty('--iy', `${s.iy.toFixed(1)}px`);
      frame.style.setProperty('--fr', `${s.r.toFixed(1)}px`);
      wl.style.transform = s.wl;
      wr.style.transform = s.wr;
      wl.style.opacity = wr.style.opacity = s.wo.toFixed(3);
      words.style.opacity = hint.style.opacity = s.e.toFixed(3);
      words.style.transform = s.ws;
    };
    const req = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };
    let visible = false;
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        req();
      },
      { rootMargin: '100px' },
    ).observe(section);
    addEventListener('scroll', () => visible && req(), { passive: true });
    onLayout(() => {
      measure();
      req();
    });
  });
</script>
