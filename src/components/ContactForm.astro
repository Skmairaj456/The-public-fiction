---
/**
 * Project enquiry form.
 *
 * Delivery is configured in src/config/site.ts → form. With JavaScript the form
 * validates inline and submits in the background; without it, the browser posts
 * the form natively to the same destination.
 *
 * There is no simulated success: the success panel only appears after the form
 * service confirms receipt. With provider 'none', the visitor's email app is
 * opened with the enquiry pre-written, and the page says exactly that.
 */
import { site, budgetRanges, timelines } from '@/config/site';
import { services } from '@/data/services';
import Arrow from './Arrow.astro';

interface Props {
  id?: string;
}
const { id = 'enquiry' } = Astro.props;
const { provider, endpoint, accessKey } = site.form;

// The destination used when JavaScript is unavailable.
let action = `mailto:${site.contact.email}`;
let enctype: string | undefined = 'text/plain';
if (provider === 'web3forms' && accessKey) {
  action = 'https://api.web3forms.com/submit';
  enctype = undefined;
} else if ((provider === 'formspree' || provider === 'custom') && endpoint) {
  action = endpoint;
  enctype = undefined;
}
const configuredProvider = action.startsWith('mailto:') ? 'none' : provider;

const serviceOptions = [...services.map((s) => ({ value: s.title, slug: s.slug })), { value: 'Something else', slug: 'other' }];
---

<div class="cf" data-cf>
  <form
    id={id}
    class="cf__form"
    method="post"
    action={action}
    enctype={enctype}
    data-provider={configuredProvider}
    data-endpoint={configuredProvider === 'web3forms' ? 'https://api.web3forms.com/submit' : endpoint}
    data-key={accessKey}
    data-email={site.contact.email}
    aria-describedby={`${id}-required-note`}
  >
    {configuredProvider === 'web3forms' && <input type="hidden" name="access_key" value={accessKey} />}
    <input type="hidden" name="subject" value={`New project enquiry — ${site.name}`} />

    <!-- Spam trap: real people never see or fill this -->
    <div class="cf__trap" aria-hidden="true">
      <label>Leave this empty <input type="text" name="botcheck" tabindex="-1" autocomplete="off" /></label>
    </div>

    <p class="label label--muted cf__req" id={`${id}-required-note`}>Fields marked * are required.</p>

    <div class="cf__row">
      <div class="cf__field">
        <label for={`${id}-name`} class="label">Name *</label>
        <input id={`${id}-name`} name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby={`${id}-name-err`} />
        <p class="cf__err" id={`${id}-name-err`} data-err-for="name"></p>
      </div>
      <div class="cf__field">
        <label for={`${id}-email`} class="label">Email *</label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby={`${id}-email-err`} />
        <p class="cf__err" id={`${id}-email-err`} data-err-for="email"></p>
      </div>
    </div>

    <div class="cf__row">
      <div class="cf__field">
        <label for={`${id}-company`} class="label">Company / Brand *</label>
        <input id={`${id}-company`} name="company" type="text" autocomplete="organization" required maxlength="160" aria-describedby={`${id}-company-err`} />
        <p class="cf__err" id={`${id}-company-err`} data-err-for="company"></p>
      </div>
      <div class="cf__field">
        <label for={`${id}-phone`} class="label">Phone <span class="label--muted">(optional)</span></label>
        <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby={`${id}-phone-err`} />
        <p class="cf__err" id={`${id}-phone-err`} data-err-for="phone"></p>
      </div>
    </div>

    <fieldset class="cf__field cf__set" aria-describedby={`${id}-service-err`}>
      <legend class="label">What can we help with? * <span class="label--muted">(choose any)</span></legend>
      <div class="cf__chips">
        {
          serviceOptions.map((opt) => (
            <label class="cf__chip">
              <input type="checkbox" name="service" value={opt.value} data-slug={opt.slug} />
              <span>{opt.value}</span>
            </label>
          ))
        }
      </div>
      <p class="cf__err" id={`${id}-service-err`} data-err-for="service"></p>
    </fieldset>

    <div class="cf__field">
      <label for={`${id}-message`} class="label">Tell us about the project *</label>
      <textarea
        id={`${id}-message`}
        name="message"
        rows="5"
        required
        minlength="20"
        maxlength="4000"
        placeholder="What are you making, who is it for and what does success look like?"
        aria-describedby={`${id}-message-err`}></textarea>
      <p class="cf__err" id={`${id}-message-err`} data-err-for="message"></p>
    </div>

    <div class="cf__row">
      <div class="cf__field">
        <label for={`${id}-budget`} class="label">Budget range <span class="label--muted">(optional)</span></label>
        <div class="cf__select">
          <select id={`${id}-budget`} name="budget">
            <option value="">Select a range</option>
            {budgetRanges.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
      </div>
      <div class="cf__field">
        <label for={`${id}-timeline`} class="label">Timeline <span class="label--muted">(optional)</span></label>
        <div class="cf__select">
          <select id={`${id}-timeline`} name="timeline">
            <option value="">Select a timeline</option>
            {timelines.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
      </div>
    </div>

    <div class="cf__foot">
      <p class="cf__note muted">
        We use your details only to reply to this enquiry. See our <a class="ulink" href="/privacy/">privacy policy</a>.
        {configuredProvider === 'none' && <> Sending opens your email app with your enquiry ready to go.</>}
      </p>
      <button type="submit" class="btn cf__submit" data-submit>
        <span data-submit-label>{configuredProvider === 'none' ? 'Send via email' : 'Send enquiry'}</span>
        <span class="cf__spinner" aria-hidden="true"></span>
        <Arrow />
      </button>
    </div>

    <div class="cf__status" role="status" aria-live="polite" data-status></div>
  </form>

  <div class="cf__done" hidden data-done tabindex="-1">
    <p class="label cf__done-label"><span class="cf__tick" aria-hidden="true"></span>Enquiry received</p>
    <p class="display-m">Thank you. <span class="serif">Now we think.</span></p>
    <p class="lede muted">
      Your message is with us. We read every enquiry properly and will reply to <strong data-done-email></strong> as
      soon as we can.
    </p>
    <button type="button" class="btn btn--line" data-reset>Send another enquiry</button>
  </div>
</div>

<style>
  .cf__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf__form {
    display: grid;
    gap: clamp(22px, 2.6vw, 36px);
  }
  .cf__req {
    margin-bottom: -8px;
  }
  .cf__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(22px, 2.6vw, 36px) var(--gutter);
  }
  .cf__field {
    display: grid;
    gap: 6px;
    align-content: start;
    min-width: 0;
  }
  .cf__set {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .cf__set legend {
    padding: 0;
    margin-bottom: 14px;
  }
  .cf input[type='text'],
  .cf input[type='email'],
  .cf input[type='tel'],
  .cf textarea,
  .cf select {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    padding: 10px 0 12px;
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    line-height: 1.3;
    transition: border-color 0.3s;
    appearance: none;
  }
  .cf textarea {
    resize: vertical;
    min-height: 140px;
  }
  .cf textarea::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }
  .cf input:focus,
  .cf textarea:focus,
  .cf select:focus {
    outline: none;
    border-bottom-color: var(--fg);
    box-shadow: 0 1px 0 0 var(--fg);
  }
  .cf [aria-invalid='true'] {
    border-bottom-color: var(--signal) !important;
    box-shadow: 0 1px 0 0 var(--signal) !important;
  }
  .cf__select {
    position: relative;
  }
  .cf__select::after {
    content: '';
    position: absolute;
    right: 4px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-75%) rotate(45deg);
    pointer-events: none;
  }
  .cf select {
    padding-right: 28px;
    cursor: pointer;
  }
  .cf select option {
    color: var(--ink);
    background: var(--paper);
  }

  .cf__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cf__chip {
    position: relative;
    cursor: pointer;
  }
  .cf__chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .cf__chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.95rem;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .cf__chip:hover span {
    border-color: var(--fg);
  }
  .cf__chip input:checked + span {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .cf__chip input:focus-visible + span {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }
  .cf__set[aria-invalid='true'] .cf__chip span {
    border-color: var(--signal);
  }

  .cf__err {
    min-height: 0;
    color: var(--signal);
    font-size: 0.88rem;
    font-weight: 500;
  }
  .cf__err:empty {
    display: none;
  }

  .cf__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: 8px;
  }
  .cf__note {
    max-width: 46ch;
    font-size: 0.92rem;
  }
  .cf__submit {
    min-height: 60px;
    padding: 0 32px;
  }
  .cf__spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: cf-spin 0.8s linear infinite;
  }
  .cf__submit[aria-busy='true'] .cf__spinner {
    display: inline-block;
  }
  .cf__submit[aria-busy='true'] :global(.btn__arrow) {
    display: none;
  }
  @keyframes cf-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .cf__status:empty {
    display: none;
  }
  .cf__status {
    padding: 16px 18px;
    border-left: 2px solid var(--signal);
    background: color-mix(in srgb, var(--signal) 9%, transparent);
  }
  .cf__status[data-tone='info'] {
    border-left-color: var(--fg);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }
  .cf__status a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .cf__done {
    display: grid;
    gap: 24px;
    justify-items: start;
    padding-block: 24px;
    outline: none;
  }
  .cf__done-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--signal);
  }
  .cf__tick {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--signal);
  }

  @media (max-width: 680px) {
    .cf__row {
      grid-template-columns: 1fr;
    }
    .cf__submit {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  interface Fields {
    name: string;
    email: string;
    company: string;
    phone: string;
    message: string;
    budget: string;
    timeline: string;
    botcheck: string;
    services: string[];
  }

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const TIMEOUT_MS = 15000;

  document.querySelectorAll<HTMLElement>('[data-cf]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    const provider = form.dataset.provider as 'web3forms' | 'formspree' | 'custom' | 'none';
    const endpoint = form.dataset.endpoint || '';
    const accessKey = form.dataset.key || '';
    const inbox = form.dataset.email || '';
    const idleLabel = submitLabel.textContent || 'Send enquiry';

    form.noValidate = true;

    // Pre-select a service from ?service=<slug> (used by "Start a project like this" links).
    const wanted = new URLSearchParams(location.search).get('service');
    if (wanted) {
      const box = form.querySelector<HTMLInputElement>(`input[name="service"][data-slug="${CSS.escape(wanted)}"]`);
      if (box) box.checked = true;
    }

    const control = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    const errorEl = (name: string) => form.querySelector<HTMLElement>(`[data-err-for="${name}"]`);

    function setError(name: string, message: string) {
      const el = errorEl(name);
      if (el) el.textContent = message;
      const target = name === 'service' ? form.querySelector('fieldset') : control(name);
      if (target) {
        if (message) target.setAttribute('aria-invalid', 'true');
        else target.removeAttribute('aria-invalid');
      }
    }

    function readFields(): Fields {
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      return {
        name: get('name'),
        email: get('email'),
        company: get('company'),
        phone: get('phone'),
        message: get('message'),
        budget: get('budget'),
        timeline: get('timeline'),
        botcheck: get('botcheck'),
        services: data.getAll('service').map(String),
      };
    }

    function validate(only?: string): boolean {
      const f = readFields();
      const errors: Record<string, string> = {
        name: f.name.length < 2 ? 'Please tell us your name.' : '',
        email: !f.email ? 'We need an email address to reply to.' : !EMAIL_RE.test(f.email) ? 'That email address doesn’t look quite right.' : '',
        company: !f.company ? 'Which company or brand is this for? “Personal project” is fine too.' : '',
        phone: f.phone && !/^[+()\d\s.-]{6,}$/.test(f.phone) ? 'Please use digits, spaces and + only.' : '',
        service: f.services.length === 0 ? 'Choose at least one option — “Something else” counts.' : '',
        message: f.message.length < 20 ? 'A couple of sentences helps us reply properly (20 characters minimum).' : '',
      };
      if (only) {
        setError(only, errors[only] ?? '');
        return !errors[only];
      }
      let firstInvalid: string | null = null;
      for (const [name, msg] of Object.entries(errors)) {
        setError(name, msg);
        if (msg && !firstInvalid) firstInvalid = name;
      }
      if (firstInvalid) {
        const el = firstInvalid === 'service' ? form.querySelector<HTMLInputElement>('input[name="service"]') : control(firstInvalid);
        el?.focus();
        return false;
      }
      return true;
    }

    // Re-validate a field once the visitor has interacted with it.
    form.addEventListener('focusout', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name && t.name !== 'service' && t.value && errorEl(t.name)) validate(t.name);
    });
    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      const name = t.name === 'service' ? 'service' : t.name;
      if (errorEl(name)?.textContent) validate(name);
    });

    function setBusy(busy: boolean) {
      submit.setAttribute('aria-busy', String(busy));
      submit.disabled = busy;
      submitLabel.textContent = busy ? 'Sending…' : idleLabel;
    }

    function showStatus(html: string, tone: 'error' | 'info' = 'error') {
      status.dataset.tone = tone;
      status.innerHTML = html;
    }

    const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    function mailtoHref(f: Fields) {
      const details = [
        `Name: ${f.name}`,
        `Email: ${f.email}`,
        `Company / Brand: ${f.company}`,
        f.phone && `Phone: ${f.phone}`,
        `Services: ${f.services.join(', ')}`,
        f.budget && `Budget: ${f.budget}`,
        f.timeline && `Timeline: ${f.timeline}`,
      ].filter(Boolean);
      const lines = [...details, '', f.message];
      const subject = `Project enquiry — ${f.company}`;
      return `mailto:${inbox}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    }

    function fallbackHtml(f: Fields) {
      return `You can also <a href="${escapeHtml(mailtoHref(f))}">send it by email</a> or write to <a href="mailto:${escapeHtml(inbox)}">${escapeHtml(inbox)}</a>.`;
    }

    async function send(f: Fields): Promise<void> {
      const payload = {
        name: f.name,
        email: f.email,
        company: f.company,
        phone: f.phone,
        services: f.services.join(', '),
        message: f.message,
        budget: f.budget,
        timeline: f.timeline,
        page: location.href,
      };

      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
      try {
        let body: Record<string, unknown> = payload;
        if (provider === 'web3forms') {
          body = {
            ...payload,
            access_key: accessKey,
            subject: `New project enquiry — ${f.company}`,
            from_name: f.name,
            replyto: f.email,
            botcheck: '',
          };
        } else if (provider === 'formspree') {
          body = { ...payload, _replyto: f.email, _subject: `New project enquiry — ${f.company}` };
        }

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body),
          signal: ctrl.signal,
        });

        let json: any = null;
        try {
          json = await res.json();
        } catch {
          /* some endpoints return no body */
        }

        if (!res.ok || (provider === 'web3forms' && json && json.success === false)) {
          const reason =
            (json && (json.message || (Array.isArray(json.errors) && json.errors.map((e: any) => e.message).join(' ')))) ||
            `The form service responded with status ${res.status}.`;
          throw new Error(reason);
        }
      } finally {
        clearTimeout(timer);
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.innerHTML = '';
      if (!validate()) {
        showStatus('Please check the highlighted fields.');
        return;
      }
      const f = readFields();
      if (f.botcheck) return; // Spam trap was filled — silently stop.

      if (provider === 'none' || !endpoint) {
        window.location.href = mailtoHref(f);
        showStatus(
          `Your email app should now be open with the enquiry written out — press send there and it’s on its way. Nothing opened? Email us at <a href="mailto:${escapeHtml(inbox)}">${escapeHtml(inbox)}</a>.`,
          'info',
        );
        return;
      }

      setBusy(true);
      try {
        await send(f);
        form.hidden = true;
        done.hidden = false;
        const out = done.querySelector('[data-done-email]');
        if (out) out.textContent = f.email;
        done.focus();
      } catch (err) {
        const aborted = err instanceof DOMException && err.name === 'AbortError';
        const offline = !navigator.onLine;
        const reason = offline
          ? 'You appear to be offline.'
          : aborted
            ? 'The form service took too long to respond.'
            : `We couldn’t send your enquiry${err instanceof Error && err.message ? ` (${escapeHtml(err.message)})` : ''}.`;
        showStatus(`${reason} Your answers are still here, so you can try again. ${fallbackHtml(f)}`);
      } finally {
        setBusy(false);
      }
    });

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      status.innerHTML = '';
      done.hidden = true;
      form.hidden = false;
      control('name')?.focus();
    });
  });
</script>
