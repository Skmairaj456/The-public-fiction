---
import { Picture } from 'astro:assets';
import type { Project } from '@/lib/content';
import Arrow from './Arrow.astro';
import { caseStudies, filled } from '@/data/real-content';

interface Props {
  project: Project;
  index?: number;
  /** CSS aspect-ratio for the cover, e.g. "4 / 5". */
  ratio?: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  /** "overlay" puts the title on the image (big cards); "below" sets it underneath. */
  layout?: 'overlay' | 'below';
}

const {
  project,
  index,
  ratio = '4 / 3',
  sizes = '(max-width: 760px) 100vw, 50vw',
  class: className = '',
  eager = false,
  layout = 'below',
} = Astro.props;
const { data } = project;
const href = `/work/${project.id}/`;
const num = index !== undefined ? String(index + 1).padStart(2, '0') : undefined;
// Client name and key result from src/data/real-content.ts (hidden until filled in).
const facts = caseStudies[project.id];
const client = filled(facts?.client) ?? data.client;
const result = filled(facts?.result);
---

<article class:list={['pc', `pc--${layout}`, className]} data-category={data.category}>
  <a href={href} class="pc__link" data-cursor="View" aria-label={`${data.title} — ${data.category}`}>
    <div class="pc__media media" style={`aspect-ratio:${ratio}`} data-reveal-img>
      <Picture src={data.cover} alt={data.coverAlt} widths={[480, 800, 1200, 1800]} sizes={sizes} formats={['avif', 'webp']} loading={eager ? 'eager' : 'lazy'} />
      <span class="pc__go" aria-hidden="true"><Arrow class="" /></span>
      {
        layout === 'overlay' && (
          <div class="pc__over">
            <span class="chip pc__cat">{data.category}</span>
            <h3 class="pc__big mega">{data.title}</h3>
            {(client || result) && (
              <p class="pc__facts">
                {client && <span>{client}</span>}
                {result && <span class="pc__result">{result}</span>}
              </p>
            )}
          </div>
        )
      }
    </div>
    {
      layout === 'below' && (
        <div class="pc__meta">
          <h3 class="pc__title t-title">
            {num && <span class="pc__num">{num}</span>}
            {data.title}
          </h3>
          <span class="chip">{data.category}</span>
        </div>
      )
    }
    {
      layout === 'below' && (client || result) && (
        <p class="pc__facts pc__facts--below">
          {client && <span>{client}</span>}
          {result && <span class="pc__result">{result}</span>}
        </p>
      )
    }
    {layout === 'below' && <p class="pc__summary muted">{data.summary}</p>}
  </a>
</article>

<style>
  .pc__link {
    display: block;
  }
  .pc__media :global(img) {
    transition: transform 1.1s var(--ease) !important;
  }
  .pc__link:hover .pc__media :global(img) {
    transform: scale(1.05) !important;
  }
  .pc__go {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--white);
    color: var(--ink);
    transition:
      transform 0.5s var(--spring),
      background 0.3s;
  }
  .pc__go :global(svg) {
    width: 15px;
    height: 15px;
    transform: rotate(-45deg);
  }
  .pc__link:hover .pc__go {
    background: var(--lime);
    transform: scale(1.1);
  }
  .pc__over {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: clamp(18px, 2.4vw, 36px);
    color: var(--white);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  }
  .pc__big {
    font-size: clamp(3rem, 8.5vw, 9rem);
    line-height: 0.85;
    white-space: normal;
  }
  .pc__cat {
    background: var(--white);
    color: var(--ink);
    border: 0;
  }
  .pc__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
  }
  .pc__title {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .pc__num {
    font-size: 12px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--lime);
    color: var(--ink);
    transform: translateY(-0.3em);
  }
  /* Client and key result */
  .pc__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .pc__result {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    font-weight: 700;
  }
  .pc__facts--below {
    margin-top: 10px;
  }
  .pc__summary {
    margin-top: 8px;
    max-width: 52ch;
  }
  @media (max-width: 600px) {
    .pc__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
