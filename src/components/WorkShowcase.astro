---
/**
 * Stacked project cards: each card sticks near the top of the screen and the
 * next one slides over it. Cards that are covered shrink back slightly.
 */
import ProjectCard from './ProjectCard.astro';
import type { Project } from '@/lib/content';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<div class="ws" data-stack>
  {
    projects.map((project, i) => (
      <div class="ws__item" style={`--i:${i}`} data-stack-item>
        <ProjectCard project={project} index={i} layout="overlay" ratio="auto" sizes="(max-width: 760px) 100vw, 92vw" class="ws__card" />
      </div>
    ))
  }
</div>

<style>
  .ws {
    display: grid;
    gap: clamp(20px, 4vh, 48px);
  }
  .ws__item {
    position: sticky;
    top: calc(var(--header-h) + 8px + var(--i) * 10px);
  }
  .ws__item :global(.ws__card) {
    transform: scale(var(--s, 1));
    transform-origin: 50% 0;
    will-change: transform;
  }
  .ws__item :global(.pc__media) {
    height: clamp(360px, 74vh, 860px);
    aspect-ratio: auto !important;
  }
  @media (max-width: 700px) {
    .ws__item :global(.pc__media) {
      height: clamp(340px, 62vh, 600px);
    }
  }
</style>

<script>
  import { docTop, onLayout } from '../scripts/scrollDriven';

  if (!document.documentElement.classList.contains('reduce-motion')) {
    document.querySelectorAll<HTMLElement>('[data-stack]').forEach((stack) => {
      const items = Array.from(stack.querySelectorAll<HTMLElement>('[data-stack-item]'));
      const cards = items.map((item) => item.firstElementChild as HTMLElement);

      // Layout, cached. Each card sticks at its own top; where it would sit
      // unstuck is worked out from the stack's position, heights and gap, so
      // the scene is a pure function of scrollY.
      let natural: number[] = [];
      let stuck: number[] = [];
      let heights: number[] = [];
      const measure = () => {
        const gap = parseFloat(getComputedStyle(stack).rowGap) || 0;
        let y = docTop(stack);
        natural = [];
        heights = items.map((it) => it.offsetHeight);
        stuck = items.map((it) => parseFloat(getComputedStyle(it).top) || 0);
        items.forEach((_, i) => {
          natural.push(y);
          y += heights[i] + gap;
        });
      };
      // How far card i+1 has slid over card i (0 → 1) at a scroll position.
      const covered = (i: number, y: number) => {
        if (i >= items.length - 1) return 0;
        const aTop = Math.max(stuck[i], natural[i] - y);
        const bTop = Math.max(stuck[i + 1], natural[i + 1] - y);
        return Math.min(1, Math.max(0, (aTop + heights[i] - bTop) / heights[i]));
      };
      const scale = (i: number, y: number) => `scale(${(1 - covered(i, y) * 0.07).toFixed(4)})`;

      // Driven from scroll events on purpose: the shrink is subtle enough that a
      // frame of lag is invisible, and in phone emulation this measured cheaper than
      // keeping five scroll-driven animations live on stuck cards.
      let ticking = false;
      const last: string[] = [];
      const render = () => {
        ticking = false;
        cards.forEach((card, i) => {
          const tf = scale(i, scrollY);
          if (tf !== last[i]) card.style.transform = last[i] = tf;
        });
      };
      const req = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(render);
        }
      };
      let visible = false;
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          req();
        },
        { rootMargin: '100px' },
      ).observe(stack);
      addEventListener('scroll', () => visible && req(), { passive: true });
      onLayout(() => {
        measure();
        req();
      });
    });
  }
</script>
