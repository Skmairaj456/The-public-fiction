---
/**
 * Clients & collaborators. Renders the names/logos listed in src/data/studio.ts.
 * With no clients listed it shows the positioning statement only.
 */
import { Image } from 'astro:assets';
import { clients } from '@/data/studio';
import SectionHead from './SectionHead.astro';
import Button from './Button.astro';
import Sticker from './Sticker.astro';
---

<section class="section clients" aria-labelledby="clients-title">
  <div class="wrap">
    <SectionHead label="Clients & collaborators" aside="Who we work with" />
    <h2 id="clients-title" class="clients__title" data-split aria-label="Good people. Ambitious ideas.">
      <span class="lm" aria-hidden="true"><span class="mega mega--m" style="--i:0">Good people.</span></span>
      <span class="lm" aria-hidden="true"><span class="mega mega--m clients__outline" style="--i:1">Ambitious ideas.</span></span>
    </h2>
    <div class="clients__row">
      <p class="lede" data-reveal>
        We work best with founders, marketers and makers who would rather be remembered than merely seen — and who are
        happy to be asked a difficult question or two.
      </p>
      {clients.length === 0 && <div data-reveal style="--d:120"><Button href="/contact/">Become one of them</Button></div>}
    </div>
    <Sticker name="heart" class="clients__stk" data-pop />

    {
      clients.length > 0 && (
        <ul class="clients__grid" aria-label="Selected clients and collaborators">
          {clients.map((c, i) => {
            const inner = c.logo ? <Image src={c.logo} alt={c.name} class="clients__logo" width={240} /> : <span class="h-s">{c.name}</span>;
            return (
              <li class="clients__cell" data-reveal style={`--d:${(i % 4) * 70}`}>
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener noreferrer">
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </li>
            );
          })}
        </ul>
      )
    }

    {
      clients.length === 0 && import.meta.env.DEV && (
        <p class="dev-note">
          <strong>Editor note (dev only):</strong> no clients listed yet. Add approved clients and logos to
          <code>src/data/studio.ts → clients</code> and a logo wall appears here automatically.
        </p>
      )
    }
  </div>
</section>

<style>
  .clients {
    overflow: hidden;
  }
  .clients .wrap {
    position: relative;
  }
  .clients__title .mega {
    display: block;
    white-space: normal;
  }
  .clients__outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--fg);
  }
  .clients__row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-top: clamp(28px, 3vw, 48px);
  }
  .clients__row .lede {
    max-width: 44ch;
  }
  .clients :global(.clients__stk) {
    position: absolute;
    right: 6%;
    top: 12%;
    width: clamp(80px, 11vw, 160px);
    --r: 12deg;
  }
  :global(html.js:not(.reduce-motion)) .clients :global(.clients__stk.is-in) {
    animation: bob 4.6s ease-in-out infinite;
  }
  .clients__grid {
    margin-top: clamp(36px, 4vw, 64px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .clients__cell {
    display: grid;
    place-items: center;
    min-height: clamp(110px, 11vw, 170px);
    padding: 20px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    text-align: center;
  }
  .clients__cell :global(.clients__logo) {
    max-height: 52px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.4s, opacity 0.4s;
  }
  .clients__cell:hover :global(.clients__logo) {
    filter: none;
    opacity: 1;
  }
  @media (max-width: 760px) {
    .clients__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .clients :global(.clients__stk) {
      top: auto;
      bottom: -10px;
      right: 4%;
    }
  }
</style>
