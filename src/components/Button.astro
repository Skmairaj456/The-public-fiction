---
import Arrow from './Arrow.astro';

interface Props {
  href: string;
  variant?: 'solid' | 'lime' | 'ghost';
  class?: string;
  arrow?: boolean;
  [key: string]: unknown;
}
const { href, variant = 'solid', class: className = '', arrow = true, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={['btn', variant === 'lime' && 'btn--lime', variant === 'ghost' && 'btn--ghost', !arrow && 'btn--plain', className]}
  {...rest}
>
  <span><slot /></span>
  {
    arrow && (
      <span class="btn__icon" aria-hidden="true">
        <Arrow class="" />
      </span>
    )
  }
</a>
