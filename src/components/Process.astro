---
import { process } from '@/data/studio';
import Sticker from './Sticker.astro';
import type { StickerName } from '@/lib/stickers';
import Arrow from './Arrow.astro';

const icons: StickerName[] = ['eye', 'bulb', 'pencil', 'rocket', 'bolt'];
---

<div class="proc" data-proc>
  <ol class="proc__track" data-proc-track>
    {
      process.map((step, i) => (
        <li class="proc__card" data-reveal style={`--d:${i * 90}`}>
          <div class="proc__top">
            <h3 class="proc__title h-m">{step.title}</h3>
            <span class="proc__num" aria-hidden="true">
              /{step.number}
            </span>
          </div>
          <p class="proc__text">{step.text}</p>
          <p class="proc__detail muted">{step.detail}</p>
          <Sticker name={icons[i % icons.length]} class="proc__stk" />
        </li>
      ))
    }
  </ol>
  <div class="proc__nav">
    <button type="button" class="proc__btn" aria-label="Previous step" data-proc-prev>
      <Arrow class="proc__prev" />
    </button>
    <button type="button" class="proc__btn" aria-label="Next step" data-proc-next>
      <Arrow class="" />
    </button>
  </div>
</div>

<style>
  .proc__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, calc((100% - 2 * var(--gutter)) / 3));
    gap: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .proc__track::-webkit-scrollbar {
    display: none;
  }
  .proc__card {
    position: relative;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: clamp(340px, 30vw, 440px);
    padding: clamp(22px, 2.2vw, 32px);
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .proc__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .proc__title {
    text-transform: none;
    letter-spacing: -0.04em;
  }
  .proc__num {
    font-weight: 800;
    font-size: 14px;
    padding: 3px 8px;
    border-radius: 8px;
    background: var(--lime);
    color: var(--ink);
  }
  .proc__text {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .proc__detail {
    max-width: 34ch;
  }
  .proc__card :global(.proc__stk) {
    width: clamp(84px, 8vw, 120px);
    margin-top: auto;
    align-self: flex-end;
    transform: rotate(-8deg);
    transition: transform 0.6s var(--spring);
  }
  .proc__card:hover :global(.proc__stk) {
    transform: rotate(6deg) scale(1.08);
  }
  .proc__nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
  .proc__btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--fg);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .proc__btn:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .proc__btn[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }
  .proc__btn :global(svg) {
    width: 16px;
    height: 16px;
  }
  .proc__btn :global(.proc__prev) {
    transform: rotate(180deg);
  }
  @media (max-width: 760px) {
    .proc__track {
      grid-auto-columns: 84%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-proc]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-proc-track]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-proc-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-proc-next]')!;
    const step = () => (track.firstElementChild as HTMLElement).offsetWidth + 20;
    const update = () => {
      prev.disabled = track.scrollLeft < 8;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  });
</script>
