---
/**
 * Scrolling marquee of short labels (disciplines, stages).
 *  - One real list is read by screen readers; the repeated copies that make
 *    the seamless loop are aria-hidden.
 *  - With prefers-reduced-motion it becomes a static, wrapped list.
 *  - Pure CSS: works the same with JavaScript off.
 */
import Asterisk from './Asterisk.astro';

interface Props {
  items: readonly string[];
  speed?: number;
  variant?: 'lime' | 'ink' | 'white';
  reverse?: boolean;
  tilt?: number;
  /** What the list is, for screen readers, e.g. "What we do". */
  label?: string;
  class?: string;
}
const { items, speed = 32, variant = 'lime', reverse = false, tilt = 0, label, class: className = '' } = Astro.props;
// Four identical groups: the track scrolls by half its width for a seamless loop.
const copies = [0, 1, 2, 3];
---

<div class="tk-wrap">
  <div
    class:list={['marquee', 'tk', `tk--${variant}`, reverse && 'marquee--reverse', className]}
    style={`--marquee-speed:${speed}s;--tilt:${tilt}deg`}
  >
    <div class="marquee__track">
      {
        copies.map((n) => (
          <ul class:list={['tk__group', n > 0 && 'tk__dup']} aria-hidden={n > 0 ? 'true' : undefined} aria-label={n === 0 ? label : undefined}>
            {items.map((item) => (
              <li class="tk__item">
                {item}
                <Asterisk class="tk__ast" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  .tk-wrap {
    overflow: hidden;
    padding-block: clamp(14px, 2vw, 34px);
    margin-block: calc(clamp(14px, 2vw, 34px) * -1);
    position: relative;
    z-index: 2;
  }
  .tk {
    position: relative;
    z-index: 2;
    padding-block: clamp(10px, 1.2vw, 16px);
    transform: rotate(var(--tilt));
    margin-inline: -3vw;
  }
  .tk__group {
    display: inline-flex;
    flex: none;
  }
  .tk--lime {
    background: var(--lime);
    color: var(--ink);
  }
  .tk--white {
    background: var(--paper);
    color: var(--ink);
    border-block: 1px solid var(--ink);
  }
  .tk--white .tk__item {
    font-weight: 600;
  }
  .tk--ink {
    background: var(--ink);
    color: var(--paper);
  }
  .tk__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    padding-right: clamp(14px, 2vw, 28px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(1rem, 1.7vw, 1.6rem);
    line-height: 1;
  }
  .tk :global(.tk__ast) {
    width: 0.8em;
    height: 0.8em;
  }
  .tk--ink :global(.tk__ast) {
    color: var(--lime);
  }

  /* Reduced motion: no scrolling, just the list once, wrapped and centred. */
  @media (prefers-reduced-motion: reduce) {
    .tk {
      transform: none;
      margin-inline: 0;
      padding-inline: var(--gutter);
      white-space: normal;
    }
    .tk .marquee__track {
      display: block;
      animation: none !important;
      transform: none !important;
    }
    .tk__group {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 10px;
      width: 100%;
    }
    .tk__dup {
      display: none;
    }
  }
</style>
