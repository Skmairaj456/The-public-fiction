---
/**
 * A ribbon of words on a rolling drum that bends into a 3D tunnel and flies
 * toward the viewer as the page scrolls.
 * Words are placed on the inner wall of a cylinder (CSS 3D); a small script
 * moves them along the tunnel. Without JS or with reduced motion, the same
 * words render as a static, readable list.
 */
interface Props {
  words: string[];
  caption?: string;
}
const { words, caption = 'Seven disciplines. One team.' } = Astro.props;
---

<section class="tun theme-dark" aria-label="What we do, in a word" data-tunnel>
  <div class="tun__sticky">
    <div class="tun__scene" aria-hidden="true">
      <div class="tun__tube" data-tube></div>
      <span class="tun__probe" data-tun-probe></span>
    </div>
    <p class="tun__center" data-tun-center>
      <span class="mega mega--s lime">{caption}</span>
    </p>
    <p class="tun__hint label label--caps label--muted" aria-hidden="true">[ Keep scrolling ]</p>
    <ul class="tun__fallback" data-tun-fallback>
      {words.map((w) => <li>{w}</li>)}
    </ul>
  </div>
  <template data-tun-words>{JSON.stringify(words)}</template>
</section>

<style>
  .tun {
    position: relative;
  }
  .tun__sticky {
    position: relative;
    overflow: hidden;
  }
  .tun__scene,
  .tun__center,
  .tun__hint {
    display: none;
  }
  .tun__fallback {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1em 0.5em;
    padding: var(--section) var(--gutter);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    font-size: clamp(1.8rem, 5vw, 4.4rem);
    line-height: 1;
    text-align: center;
  }
  .tun__fallback li:nth-child(3n + 2) {
    color: var(--lime);
  }
  .tun__fallback li:nth-child(3n) {
    color: var(--dim);
  }

  /* The real tunnel (JS + motion allowed) */
  :global(html.js:not(.reduce-motion)) .tun {
    height: 520vh;
  }
  :global(html.js:not(.reduce-motion)) .tun__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  :global(html.js:not(.reduce-motion)) .tun__fallback {
    display: none;
  }
  :global(html.js:not(.reduce-motion)) .tun__scene {
    display: block;
    position: absolute;
    inset: 0;
  }
  :global(html.js:not(.reduce-motion)) .tun__center,
  :global(html.js:not(.reduce-motion)) .tun__hint {
    display: block;
  }
  /* Each word is a pre-rendered image moved by a CSS transform. Images are
     handed straight to the GPU (Safari composites them directly), so moving,
     scaling and fading them never re-draws anything: no text re-rasterising
     as words scale, and no full-screen canvas repaint (which iOS does on the
     CPU). Copies of the same word share one image. */
  .tun__tube {
    position: absolute;
    inset: 0;
  }
  .tun__tube :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    max-width: none;
    transform-origin: 0 0;
    will-change: transform, opacity;
    pointer-events: none;
    user-select: none;
  }
  /* Invisible measuring stick: gives the canvas the real font, size, spacing
     and colours from CSS, so the words match the rest of the site. */
  .tun__probe {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    white-space: nowrap;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1;
    font-size: var(--tun-size, 64px);
    color: var(--paper);
  }
  .tun__probe.is-dim {
    color: #4a4d51;
  }
  .tun__probe.is-lime {
    color: var(--lime);
  }
  .tun__center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(90vw, 900px);
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  .tun__center .mega--s {
    font-size: clamp(2.4rem, 6vw, 6rem);
  }
  .tun__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    text-align: center;
  }
</style>



<script>
  const reduce = document.documentElement.classList.contains('reduce-motion');

  document.querySelectorAll<HTMLElement>('[data-tunnel]').forEach((section) => {
    if (reduce) return;
    const tube = section.querySelector<HTMLElement>('[data-tube]')!;
    const probe = section.querySelector<HTMLElement>('[data-tun-probe]')!;
    const center = section.querySelector<HTMLElement>('[data-tun-center]')!;
    const hint = section.querySelector<HTMLElement>('.tun__hint')!;
    const words: string[] = JSON.parse(section.querySelector('template')!.innerHTML);

    // Each word is rendered once into a bitmap and shown as an <img>; every
    // frame then only changes transforms and opacity, which the GPU applies
    // without redrawing anything.
    type Sprite = { url: string; w: number; dw: number; dh: number };
    type Item = { word: string; tone: string; el: HTMLImageElement; sprite: Sprite | null; angle: number; z: number; tf: string; op: string; shown: boolean };
    let items: Item[] = [];
    let sprites = new Map<string, Promise<Sprite>>();
    let urls: string[] = [];
    let generation = 0;
    let R = 0;
    let L = 0;
    const P = 520; // perspective distance, px

    // Everything a frame needs from the layout is cached, so a frame only
    // writes styles and never forces the browser to re-measure the page.
    let vw = innerWidth;
    let vh = innerHeight;
    let cw = 1; // stage size, CSS px
    let ch = 1;
    let secTop = 0;
    let secTotal = 1;
    let F = 1; // a word's unscaled line height
    // Bitmaps at the screen's pixel density, capped at 2x: sharper is
    // invisible in motion and would quadruple the memory.
    const dpr = Math.min(2, devicePixelRatio || 1);

    const layout = () => {
      vw = innerWidth;
      vh = innerHeight;
      secTop = section.getBoundingClientRect().top + scrollY;
      secTotal = Math.max(1, section.offsetHeight - vh);
      cw = tube.clientWidth || vw;
      ch = tube.clientHeight || vh;
    };

    const scratch = document.createElement('canvas').getContext('2d')!;
    const sprite = (word: string, tone: string): Promise<Sprite> => {
      const key = `${tone}|${word}`;
      const hit = sprites.get(key);
      if (hit) return hit;
      // Measure synchronously while the probe holds this word and tone.
      probe.className = `tun__probe ${tone}`;
      probe.textContent = word;
      const cs = getComputedStyle(probe);
      const size = parseFloat(cs.fontSize) || 64;
      const w = probe.offsetWidth;
      const text = word.toUpperCase();
      const font = `${cs.fontWeight} ${size * dpr}px ${cs.fontFamily}`;
      const spacing = `${(-0.04 * size * dpr).toFixed(2)}px`;
      const color = cs.color;
      const setup = (g: CanvasRenderingContext2D) => {
        g.font = font;
        if ('letterSpacing' in g) (g as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = spacing;
        g.textAlign = 'center';
        g.textBaseline = 'middle';
      };
      setup(scratch);
      const pad = Math.ceil(size * dpr * 0.15);
      const img = document.createElement('canvas');
      img.width = Math.ceil(Math.max(w * dpr, scratch.measureText(text).width)) + pad * 2;
      img.height = Math.ceil(F * dpr) + pad * 2;
      const g = img.getContext('2d')!;
      setup(g);
      g.fillStyle = color;
      // 'middle' sits slightly high for capitals; nudge to the cap-height centre.
      g.fillText(text, img.width / 2, img.height / 2 + size * dpr * 0.04);
      const p = new Promise<Sprite>((resolve) =>
        img.toBlob((blob) => {
          const url = blob ? URL.createObjectURL(blob) : img.toDataURL();
          if (blob) urls.push(url);
          resolve({ url, w, dw: img.width / dpr, dh: img.height / dpr });
        }),
      );
      sprites.set(key, p);
      return p;
    };

    // (Re)measure the font and render every word's bitmap.
    const prepare = () => {
      const gen = ++generation;
      const oldUrls = urls;
      urls = [];
      sprites = new Map();
      probe.className = 'tun__probe';
      probe.textContent = 'M';
      F = probe.offsetHeight || 1;
      const jobs = items.map((it) =>
        sprite(it.word, it.tone).then((s) => {
          if (gen !== generation) return;
          it.sprite = s;
          it.el.style.width = `${s.dw}px`;
          it.el.style.height = `${s.dh}px`;
          it.el.src = s.url;
          it.tf = it.op = '';
        }),
      );
      Promise.all(jobs).then(() => {
        if (gen !== generation) return;
        oldUrls.forEach((u) => URL.revokeObjectURL(u));
        drawn = -1;
        measure();
      });
    };

    const build = () => {
      tube.innerHTML = '';
      items = [];
      const small = innerWidth < 760;
      const sides = small ? 8 : 10;
      const rings = small ? 6 : 7;
      const gap = small ? 360 : 460;
      R = Math.min(innerWidth, innerHeight) * (small ? 0.62 : 0.5);
      L = rings * gap;
      section.style.setProperty('--tun-size', `${Math.round(R * (small ? 0.2 : 0.17))}px`);
      let w = 0;
      for (let r = 0; r < rings; r++) {
        for (let s = 0; s < sides; s++) {
          const pick = (r * sides + s) % 7;
          const tone = pick === 2 || pick === 5 ? 'is-dim' : pick === 4 ? 'is-lime' : '';
          const el = document.createElement('img');
          el.alt = '';
          el.decoding = 'async';
          el.draggable = false;
          el.style.visibility = 'hidden';
          tube.appendChild(el);
          // Stagger alternate sides so words never line up in rows.
          items.push({ word: words[w++ % words.length], tone, el, sprite: null, angle: (360 / sides) * s + (r % 2) * (180 / sides), z: r * gap + (s % 2) * gap * 0.5, tf: '', op: '', shown: false });
        }
      }
    };

    let progress = 0;
    let drawn = -1;
    let visible = false;
    let ticking = false;
    let lastHint = '';
    let lastCenter = '';

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (t: number) => t * t * (3 - 2 * t);

    const render = () => {
      ticking = false;
      if (progress === drawn) return;
      drawn = progress;
      // Three acts over the scroll:
      //  1. a flat ribbon of words wrapped around a horizontal drum, rolling up;
      //  2. the ribbon bends into the tunnel (each word glides from its line
      //     on the drum to its place on the tunnel wall);
      //  3. the tunnel flies, spins and drains.
      const mRaw = clamp01((progress - 0.06) / 0.26);
      const q = clamp01((progress - 0.22) / 0.78);
      const travel = q * L * 1.55;
      const spin = q * 70;
      // The tunnel drains at the end: the far words go first and the near
      // ones last, so the walls empty out toward the viewer.
      const x = clamp01((q - 0.48) / 0.18);
      const hv = (1 - x).toFixed(3);
      if (hv !== lastHint) hint.style.opacity = lastHint = hv;

      // The drum: lines of words stacked down the middle of the screen.
      const lh = Math.min(vh * 0.085, vw * 0.11);
      const k = (lh * 1.02) / F;
      const drumR = vh * 0.46;
      const rows = items.length;
      const roll = progress * lh * 9;
      const ox = cw / 2;
      const oy = ch / 2;

      for (let i = 0; i < rows; i++) {
        const it = items[i];
        const sp = it.sprite;
        if (!sp) continue;
        const iw = sp.w;
        // --- Act 3 pose: on the tunnel wall --------------------------------
        // Perspective is projected here: each word lies along the tunnel wall,
        // its far and near ends projected separately and the word stretched
        // between them. A near end that reaches the camera is pushed
        // off-screen, so nothing ever streaks across the centre.
        const d = L - ((it.z + travel) % L);
        const z = -d + 260;
        const depth = P - z;
        let tx = 0;
        let ty = 0;
        let ta = 0;
        let tsx = k;
        let tsy = k;
        let top = 0;
        if (depth >= 40) {
          const fadeIn = Math.min(1, (L - d) / (L * 0.35));
          const fadeOut = clamp01((d - 60) / 340);
          const exit = clamp01(1 - x * (1 + 1.6 * (d / L)));
          top = Math.max(0, fadeIn * fadeOut * exit);
          const half = iw / 2;
          const rFar = (R * P) / (depth + half);
          const rNear = (R * P) / Math.max(30, depth - half);
          const rc = (rFar + rNear) / 2;
          tsx = iw ? (rNear - rFar) / iw : 1;
          tsy = P / depth;
          const a = ((it.angle + spin) * Math.PI) / 180;
          tx = rc * Math.cos(a);
          ty = rc * Math.sin(a);
          ta = Math.atan2(Math.sin(a), Math.cos(a));
        }

        // --- Act 1 pose: a line on the drum --------------------------------
        let fy = (i - rows / 2) * lh - roll;
        const span = rows * lh;
        fy = ((((fy + span / 2) % span) + span) % span) - span / 2;
        const th = fy / drumR;
        const onFront = Math.abs(th) < Math.PI / 2;
        const c = onFront ? Math.cos(th) : 0;
        const fop = onFront ? Math.pow(c, 0.6) : 0;

        // --- Blend between the two ----------------------------------------
        // The ribbon peels into the tunnel from the top line down, so it
        // unwraps as one surface instead of every word moving at once.
        const band = clamp01((Math.max(-1.57, Math.min(1.57, th)) + 1.57) / 3.14);
        const m = smooth(clamp01(mRaw * 1.7 - band * 0.7));
        const op = fop * (1 - m) + top * m;
        // Invisible words leave the compositor and get no updates at all.
        const show = op >= 0.002;
        if (show !== it.shown) {
          it.shown = show;
          it.el.style.visibility = show ? '' : 'hidden';
        }
        if (!show) continue;
        // Long words shrink to fit narrow screens while they sit on the drum.
        const kf = Math.min(k, iw ? (vw * 0.92) / iw : k);
        const px = tx * m;
        const py = drumR * Math.sin(Math.max(-1.57, Math.min(1.57, th))) * (1 - m) + ty * m;
        const pa = ta * m;
        const psx = kf * (1 - m) + tsx * m;
        const psy = Math.max(0.001, kf * c * (1 - m) + tsy * m);
        // Move to the word's spot, rotate, stretch, centred on the word:
        // folded into one matrix.
        const cos = Math.cos(pa);
        const sin = Math.sin(pa);
        const ma = cos * psx;
        const mb = sin * psx;
        const mc = -sin * psy;
        const md = cos * psy;
        const hw = sp.dw / 2;
        const hh = sp.dh / 2;
        const me = ox + px - ma * hw - mc * hh;
        const mf = oy + py - mb * hw - md * hh;
        const tf = `matrix(${ma.toFixed(4)},${mb.toFixed(4)},${mc.toFixed(4)},${md.toFixed(4)},${me.toFixed(1)},${mf.toFixed(1)})`;
        if (tf !== it.tf) it.el.style.transform = it.tf = tf;
        const ops = Math.min(1, op).toFixed(3);
        if (ops !== it.op) it.el.style.opacity = it.op = ops;
      }

      // Once the tunnel is empty, the caption travels down the same passage:
      // it emerges from the vanishing point, settles, then flies past the
      // viewer, leaving the centre clear for the next section.
      const cin = clamp01((q - 0.67) / 0.16);
      const cout = clamp01((q - 0.9) / 0.1);
      const grow = 1 - Math.pow(1 - cin, 3);
      const scale = (0.03 + 0.97 * grow) * (1 + cout * cout * 2.2);
      const cop = (Math.min(1, cin * 3) * (1 - cout)).toFixed(3);
      const cv = `${cop}|${scale.toFixed(4)}`;
      if (cv !== lastCenter) {
        lastCenter = cv;
        center.style.opacity = cop;
        center.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(4)})`;
      }
    };

    // Scroll position → progress from cached numbers: no layout reads.
    const measure = () => {
      progress = Math.min(1, Math.max(0, (scrollY - secTop) / secTotal));
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };

    build();
    layout();
    prepare();
    measure();
    document.fonts?.ready.then(prepare);
    // Content above (hero, fonts, images) can change the section's position.
    new ResizeObserver(() => {
      layout();
      drawn = -1;
      measure();
    }).observe(document.body);

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        // Coming into view after a jump: draw the right frame straight away.
        if (visible) measure();
      },
      { rootMargin: '100px' },
    ).observe(section);
    addEventListener('scroll', () => visible && measure(), { passive: true });
    let rt = 0;
    let builtW = innerWidth;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        layout();
        // Phones fire resize whenever the toolbar shows or hides; only redo
        // the words when the width really changes.
        if (innerWidth !== builtW) {
          builtW = innerWidth;
          build();
          prepare();
        }
        drawn = -1;
        measure();
      }, 200);
    });
  });
</script>
