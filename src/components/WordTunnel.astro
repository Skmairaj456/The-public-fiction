---
/**
 * A ribbon of words on a rolling drum that bends into a 3D tunnel and flies
 * toward the viewer as the page scrolls.
 * Words are placed on the inner wall of a cylinder (CSS 3D); a small script
 * moves them along the tunnel. Without JS or with reduced motion, the same
 * words render as a static, readable list.
 */
interface Props {
  words: string[];
  caption?: string;
}
const { words, caption = 'Seven disciplines. One team.' } = Astro.props;
---

<section class="tun theme-dark" aria-label="What we do, in a word" data-tunnel>
  <div class="tun__sticky">
    <div class="tun__scene" aria-hidden="true">
      <div class="tun__tube" data-tube></div>
      <span class="tun__probe" data-tun-probe></span>
    </div>
    <p class="tun__center" data-tun-center>
      <span class="mega mega--s lime">{caption}</span>
    </p>
    <p class="tun__hint label label--caps label--muted" aria-hidden="true">[ Keep scrolling ]</p>
    <ul class="tun__fallback" data-tun-fallback>
      {words.map((w) => <li>{w}</li>)}
    </ul>
  </div>
  <template data-tun-words>{JSON.stringify(words)}</template>
</section>

<style>
  .tun {
    position: relative;
  }
  .tun__sticky {
    position: relative;
    overflow: hidden;
  }
  .tun__scene,
  .tun__center,
  .tun__hint {
    display: none;
  }
  .tun__fallback {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1em 0.5em;
    padding: var(--section) var(--gutter);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    font-size: clamp(1.8rem, 5vw, 4.4rem);
    line-height: 1;
    text-align: center;
  }
  .tun__fallback li:nth-child(3n + 2) {
    color: var(--lime);
  }
  .tun__fallback li:nth-child(3n) {
    color: var(--dim);
  }

  /* The real tunnel (JS + motion allowed) */
  :global(html.js:not(.reduce-motion)) .tun {
    height: 520vh;
  }
  :global(html.js:not(.reduce-motion)) .tun__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  :global(html.js:not(.reduce-motion)) .tun__fallback {
    display: none;
  }
  :global(html.js:not(.reduce-motion)) .tun__scene {
    display: block;
    position: absolute;
    inset: 0;
  }
  :global(html.js:not(.reduce-motion)) .tun__center,
  :global(html.js:not(.reduce-motion)) .tun__hint {
    display: block;
  }
  /* Each word is a pre-rendered image moved by a CSS transform. Images are
     handed straight to the GPU (Safari composites them directly), so moving,
     scaling and fading them never re-draws anything: no text re-rasterising
     as words scale, and no full-screen canvas repaint (which iOS does on the
     CPU). Copies of the same word share one image. */
  .tun__tube {
    position: absolute;
    inset: 0;
  }
  .tun__tube :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    max-width: none;
    transform-origin: 0 0;
    will-change: transform, opacity;
    pointer-events: none;
    user-select: none;
  }
  /* Invisible measuring stick: gives the canvas the real font, size, spacing
     and colours from CSS, so the words match the rest of the site. */
  .tun__probe {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    white-space: nowrap;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1;
    font-size: var(--tun-size, 64px);
    color: var(--paper);
  }
  .tun__probe.is-dim {
    color: #4a4d51;
  }
  .tun__probe.is-lime {
    color: var(--lime);
  }
  .tun__center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(90vw, 900px);
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  .tun__center .mega--s {
    font-size: clamp(2.4rem, 6vw, 6rem);
  }
  .tun__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    text-align: center;
  }
</style>




<script>
  const reduce = document.documentElement.classList.contains('reduce-motion');

  document.querySelectorAll<HTMLElement>('[data-tunnel]').forEach((section) => {
    if (reduce) return;
    const tube = section.querySelector<HTMLElement>('[data-tube]')!;
    const probe = section.querySelector<HTMLElement>('[data-tun-probe]')!;
    const center = section.querySelector<HTMLElement>('[data-tun-center]')!;
    const hint = section.querySelector<HTMLElement>('.tun__hint')!;
    const words: string[] = JSON.parse(section.querySelector('template')!.innerHTML);

    // Each word is rendered once into a bitmap and shown as an <img>, so the
    // GPU can move, scale and fade it without redrawing anything.
    type Sprite = { url: string; w: number; dw: number; dh: number };
    type Item = { word: string; tone: string; el: HTMLImageElement; sprite: Sprite | null; angle: number; z: number; anim: Animation | null; tf: string; op: string; shown: boolean };
    // cyc counts how many times the word has looped (round the drum, down the
    // tunnel): when it changes, the word jumps back to the start of its loop.
    type Pose = { x: number; y: number; a: number; sx: number; sy: number; op: number; cyc: number };
    let items: Item[] = [];
    let sprites = new Map<string, Promise<Sprite>>();
    let urls: string[] = [];
    let generation = 0;
    let ready = false;
    let R = 0;
    let L = 0;
    const P = 520; // perspective distance, px

    // Layout numbers, cached so the per-frame path never re-measures the page.
    let vw = innerWidth;
    let cw = 1; // stage size, CSS px (the stage is 100svh, so it ignores
    let ch = 1; // the iOS toolbar showing and hiding)
    let secTop = 0;
    let secTotal = 1;
    let F = 1; // a word's unscaled line height
    const dpr = Math.min(2, devicePixelRatio || 1);

    const layout = () => {
      vw = innerWidth;
      cw = tube.clientWidth || vw;
      ch = tube.clientHeight || innerHeight;
      secTop = section.getBoundingClientRect().top + scrollY;
      secTotal = Math.max(1, section.offsetHeight - innerHeight);
    };

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (t: number) => t * t * (3 - 2 * t);

    /* -----------------------------------------------------------------------
       The choreography: every word's pose at a given scroll progress (0 → 1).
       Three acts:
        1. a flat ribbon of words wrapped around a horizontal drum, rolling up;
        2. the ribbon bends into the tunnel (each word glides from its line on
           the drum to its place on the tunnel wall);
        3. the tunnel flies, spins and drains.
       ----------------------------------------------------------------------- */
    const stage = (progress: number) => {
      const q = clamp01((progress - 0.22) / 0.78);
      const lh = Math.min(ch * 0.085, vw * 0.11);
      return {
        mRaw: clamp01((progress - 0.06) / 0.26),
        travel: q * L * 1.55,
        spin: q * 70,
        // The tunnel drains at the end: the far words go first and the near
        // ones last, so the walls empty out toward the viewer.
        x: clamp01((q - 0.48) / 0.18),
        lh,
        k: (lh * 1.02) / F,
        drumR: ch * 0.46,
        roll: progress * lh * 9,
      };
    };
    const poses = (progress: number): Pose[] => {
      const st = stage(progress);
      return items.map((_, i) => poseOf(i, st));
    };
    const poseAt = (i: number, progress: number) => poseOf(i, stage(progress));
    const poseOf = (i: number, st: ReturnType<typeof stage>): Pose => {
      const { mRaw, travel, spin, x, lh, k, drumR, roll } = st;
      const rows = items.length;
      {
        const it = items[i];
        const iw = it.sprite?.w ?? 0;
        // Act 3 pose, on the tunnel wall. Each word lies along the wall: its
        // far and near ends are projected separately and the word stretched
        // between them. A near end that reaches the camera is pushed
        // off-screen, so nothing ever streaks across the centre.
        const d = L - ((it.z + travel) % L);
        const z = -d + 260;
        const depth = P - z;
        let tx = 0;
        let ty = 0;
        let ta = 0;
        let tsx = k;
        let tsy = k;
        let top = 0;
        if (depth >= 40) {
          const fadeIn = Math.min(1, (L - d) / (L * 0.35));
          const fadeOut = clamp01((d - 60) / 340);
          const exit = clamp01(1 - x * (1 + 1.6 * (d / L)));
          top = Math.max(0, fadeIn * fadeOut * exit);
          const half = iw / 2;
          const rFar = (R * P) / (depth + half);
          const rNear = (R * P) / Math.max(30, depth - half);
          const rc = (rFar + rNear) / 2;
          tsx = iw ? (rNear - rFar) / iw : 1;
          tsy = P / depth;
          const a = ((it.angle + spin) * Math.PI) / 180;
          tx = rc * Math.cos(a);
          ty = rc * Math.sin(a);
          ta = Math.atan2(Math.sin(a), Math.cos(a));
        }
        // Act 1 pose, a line on the drum.
        const fy0 = (i - rows / 2) * lh - roll;
        const span = rows * lh;
        const fy = ((((fy0 + span / 2) % span) + span) % span) - span / 2;
        const cyc = Math.floor((it.z + travel) / L) * 1000 + Math.floor((fy0 + span / 2) / span);
        const th = fy / drumR;
        const onFront = Math.abs(th) < Math.PI / 2;
        const c = onFront ? Math.cos(th) : 0;
        const fop = onFront ? Math.pow(c, 0.6) : 0;
        // Blend: the ribbon peels into the tunnel from the top line down.
        const band = clamp01((Math.max(-1.57, Math.min(1.57, th)) + 1.57) / 3.14);
        const m = smooth(clamp01(mRaw * 1.7 - band * 0.7));
        // Long words shrink to fit narrow screens while they sit on the drum.
        const kf = Math.min(k, iw ? (vw * 0.92) / iw : k);
        return {
          x: cw / 2 + tx * m,
          y: ch / 2 + drumR * Math.sin(Math.max(-1.57, Math.min(1.57, th))) * (1 - m) + ty * m,
          a: ta * m,
          sx: kf * (1 - m) + tsx * m,
          sy: Math.max(0.001, kf * c * (1 - m) + tsy * m),
          op: Math.min(1, fop * (1 - m) + top * m),
          cyc,
        };
      }
    };

    // The caption and hint, at a given progress.
    const extras = (progress: number) => {
      const q = clamp01((progress - 0.22) / 0.78);
      const x = clamp01((q - 0.48) / 0.18);
      // Once the tunnel is empty, the caption travels down the same passage:
      // it emerges from the vanishing point, settles, then flies past.
      const cin = clamp01((q - 0.67) / 0.16);
      const cout = clamp01((q - 0.9) / 0.1);
      const grow = 1 - Math.pow(1 - cin, 3);
      return {
        hint: 1 - x,
        cop: Math.min(1, cin * 3) * (1 - cout),
        cs: (0.03 + 0.97 * grow) * (1 + cout * cout * 2.2),
      };
    };

    const wordTf = (p: Pose) =>
      `translate(${p.x.toFixed(1)}px, ${p.y.toFixed(1)}px) rotate(${p.a.toFixed(4)}rad) scale(${p.sx.toFixed(4)}, ${p.sy.toFixed(4)}) translate(-50%, -50%)`;
    const centerTf = (s: number) => `translate(-50%, -50%) scale(${s.toFixed(4)})`;

    /* -----------------------------------------------------------------------
       Scroll-driven mode (Safari 26+, Chrome 115+): the whole choreography is
       sampled once into keyframes on the page's scroll timeline. The browser
       then plays it straight off the scroll position, in step with the finger
       at the display's full refresh rate, with no script running per frame.
       ----------------------------------------------------------------------- */
    // (Not in TypeScript's DOM types yet.)
    const ScrollTL = (window as unknown as { ScrollTimeline?: new (o: { source: Element; axis: string }) => AnimationTimeline }).ScrollTimeline;
    const timeline = ScrollTL ? new ScrollTL({ source: document.documentElement, axis: 'block' }) : null;
    const SAMPLES = 300;
    let extraAnims: Animation[] = [];

    const bake = () => {
      if (!timeline || !ready) return;
      const max = document.documentElement.scrollHeight - innerHeight;
      if (max <= 0) return;
      // Section progress p maps to this fraction of the page's scroll.
      const at = (p: number) => clamp01((secTop + p * secTotal) / max);
      const ps: number[] = [];
      for (let s = 0; s <= SAMPLES; s++) ps.push(s / SAMPLES);
      const frames = ps.map(poses);

      items.forEach((it, i) => {
        // Sample the path; where the word loops back to the start (a jump),
        // find the exact moment and put two keyframes there, so it jumps
        // instantly instead of being dragged across the screen in between.
        const seq: Pose[] = [];
        const at_: number[] = [];
        for (let s = 0; s < ps.length; s++) {
          const cur = frames[s][i];
          if (s > 0 && cur.cyc !== frames[s - 1][i].cyc) {
            let lo = ps[s - 1];
            let hi = ps[s];
            const c0 = frames[s - 1][i].cyc;
            for (let n = 0; n < 24; n++) {
              const mid = (lo + hi) / 2;
              if (poseAt(i, mid).cyc === c0) lo = mid;
              else hi = mid;
            }
            const o = at(hi);
            seq.push(poseAt(i, lo), poseAt(i, hi));
            at_.push(o, o);
          }
          seq.push(cur);
          at_.push(at(ps[s]));
        }
        // Keep the rotation continuous so interpolation never spins the long way.
        for (let s = 1; s < seq.length; s++) {
          let da = seq[s].a - seq[s - 1].a;
          while (da > Math.PI) {
            seq[s].a -= 2 * Math.PI;
            da -= 2 * Math.PI;
          }
          while (da < -Math.PI) {
            seq[s].a += 2 * Math.PI;
            da += 2 * Math.PI;
          }
        }
        const kf: Keyframe[] = [{ offset: 0, transform: wordTf(seq[0]), opacity: seq[0].op.toFixed(3) }];
        let lastOff = 0;
        for (let s = 0; s < seq.length; s++) {
          // Long stretches where the word is invisible need no keyframes.
          const hidden = (j: number) => !seq[j] || seq[j].op < 0.002;
          if (s > 0 && s < seq.length - 1 && hidden(s - 1) && hidden(s) && hidden(s + 1)) continue;
          const off = at_[s];
          if (off < lastOff) continue;
          lastOff = off;
          kf.push({ offset: off, transform: wordTf(seq[s]), opacity: seq[s].op.toFixed(3) });
        }
        const end = seq[seq.length - 1];
        kf.push({ offset: 1, transform: wordTf(end), opacity: end.op.toFixed(3) });
        it.el.style.visibility = '';
        it.el.style.transform = it.el.style.opacity = '';
        if (it.anim) (it.anim.effect as KeyframeEffect).setKeyframes(kf);
        else it.anim = it.el.animate(kf, { timeline, fill: 'both', duration: 'auto', easing: 'linear' } as KeyframeAnimationOptions);
      });

      // Caption and hint on the same timeline.
      const ex = ps.map(extras);
      const hintKf: Keyframe[] = [{ offset: 0, opacity: ex[0].hint.toFixed(3) }];
      const centerKf: Keyframe[] = [{ offset: 0, opacity: ex[0].cop.toFixed(3), transform: centerTf(ex[0].cs) }];
      let lastOff = 0;
      ps.forEach((p, s) => {
        const off = at(p);
        if (off < lastOff) return;
        lastOff = off;
        hintKf.push({ offset: off, opacity: ex[s].hint.toFixed(3) });
        centerKf.push({ offset: off, opacity: ex[s].cop.toFixed(3), transform: centerTf(ex[s].cs) });
      });
      const e1 = ex[ex.length - 1];
      hintKf.push({ offset: 1, opacity: e1.hint.toFixed(3) });
      centerKf.push({ offset: 1, opacity: e1.cop.toFixed(3), transform: centerTf(e1.cs) });
      extraAnims.forEach((a) => a.cancel());
      const opts = { timeline, fill: 'both', duration: 'auto', easing: 'linear' } as KeyframeAnimationOptions;
      extraAnims = [hint.animate(hintKf, opts), center.animate(centerKf, opts)];
    };

    let bt = 0;
    const rebake = () => {
      clearTimeout(bt);
      bt = window.setTimeout(bake, 120);
    };

    /* -----------------------------------------------------------------------
       Fallback for older browsers: drive the same poses from scroll events.
       ----------------------------------------------------------------------- */
    let progress = 0;
    let drawn = -1;
    let visible = false;
    let ticking = false;
    let lastHint = '';
    let lastCenter = '';

    const render = () => {
      ticking = false;
      if (!ready || progress === drawn) return;
      drawn = progress;
      const ps = poses(progress);
      items.forEach((it, i) => {
        const p = ps[i];
        const show = p.op >= 0.002;
        if (show !== it.shown) {
          it.shown = show;
          it.el.style.visibility = show ? '' : 'hidden';
        }
        if (!show) return;
        const tf = wordTf(p);
        if (tf !== it.tf) it.el.style.transform = it.tf = tf;
        const op = p.op.toFixed(3);
        if (op !== it.op) it.el.style.opacity = it.op = op;
      });
      const ex = extras(progress);
      const hv = ex.hint.toFixed(3);
      if (hv !== lastHint) hint.style.opacity = lastHint = hv;
      const cv = `${ex.cop.toFixed(3)}|${ex.cs.toFixed(4)}`;
      if (cv !== lastCenter) {
        lastCenter = cv;
        center.style.opacity = ex.cop.toFixed(3);
        center.style.transform = centerTf(ex.cs);
      }
    };

    const measure = () => {
      if (timeline) return;
      progress = Math.min(1, Math.max(0, (scrollY - secTop) / secTotal));
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };

    // After any change to the words or the layout.
    const refresh = () => {
      if (timeline) rebake();
      else {
        drawn = -1;
        measure();
      }
    };

    /* -----------------------------------------------------------------------
       Word bitmaps
       ----------------------------------------------------------------------- */
    const scratch = document.createElement('canvas').getContext('2d')!;
    const sprite = (word: string, tone: string): Promise<Sprite> => {
      const key = `${tone}|${word}`;
      const hit = sprites.get(key);
      if (hit) return hit;
      // Measure synchronously while the probe holds this word and tone.
      probe.className = `tun__probe ${tone}`;
      probe.textContent = word;
      const cs = getComputedStyle(probe);
      const size = parseFloat(cs.fontSize) || 64;
      const w = probe.offsetWidth;
      const text = word.toUpperCase();
      const font = `${cs.fontWeight} ${size * dpr}px ${cs.fontFamily}`;
      const spacing = `${(-0.04 * size * dpr).toFixed(2)}px`;
      const color = cs.color;
      const setup = (g: CanvasRenderingContext2D) => {
        g.font = font;
        if ('letterSpacing' in g) (g as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = spacing;
        g.textAlign = 'center';
        g.textBaseline = 'middle';
      };
      setup(scratch);
      const pad = Math.ceil(size * dpr * 0.15);
      const img = document.createElement('canvas');
      img.width = Math.ceil(Math.max(w * dpr, scratch.measureText(text).width)) + pad * 2;
      img.height = Math.ceil(F * dpr) + pad * 2;
      const g = img.getContext('2d')!;
      setup(g);
      g.fillStyle = color;
      // 'middle' sits slightly high for capitals; nudge to the cap-height centre.
      g.fillText(text, img.width / 2, img.height / 2 + size * dpr * 0.04);
      const p = new Promise<Sprite>((resolve) =>
        img.toBlob((blob) => {
          const url = blob ? URL.createObjectURL(blob) : img.toDataURL();
          if (blob) urls.push(url);
          resolve({ url, w, dw: img.width / dpr, dh: img.height / dpr });
        }),
      );
      sprites.set(key, p);
      return p;
    };

    // (Re)measure the font and render every word's bitmap.
    const prepare = () => {
      const gen = ++generation;
      const oldUrls = urls;
      urls = [];
      sprites = new Map();
      probe.className = 'tun__probe';
      probe.textContent = 'M';
      F = probe.offsetHeight || 1;
      const jobs = items.map((it) =>
        sprite(it.word, it.tone).then((s) => {
          if (gen !== generation) return;
          it.sprite = s;
          it.el.style.width = `${s.dw}px`;
          it.el.style.height = `${s.dh}px`;
          it.el.src = s.url;
          it.tf = it.op = '';
        }),
      );
      Promise.all(jobs).then(() => {
        if (gen !== generation) return;
        oldUrls.forEach((u) => URL.revokeObjectURL(u));
        ready = true;
        refresh();
      });
    };

    const build = () => {
      items.forEach((it) => it.anim?.cancel());
      tube.innerHTML = '';
      items = [];
      ready = false;
      const small = innerWidth < 760;
      const sides = small ? 8 : 10;
      const rings = small ? 6 : 7;
      const gap = small ? 360 : 460;
      R = Math.min(innerWidth, innerHeight) * (small ? 0.62 : 0.5);
      L = rings * gap;
      section.style.setProperty('--tun-size', `${Math.round(R * (small ? 0.2 : 0.17))}px`);
      let w = 0;
      for (let r = 0; r < rings; r++) {
        for (let s = 0; s < sides; s++) {
          const pick = (r * sides + s) % 7;
          const tone = pick === 2 || pick === 5 ? 'is-dim' : pick === 4 ? 'is-lime' : '';
          const el = document.createElement('img');
          el.alt = '';
          el.decoding = 'async';
          el.draggable = false;
          el.style.visibility = 'hidden';
          tube.appendChild(el);
          // Stagger alternate sides so words never line up in rows.
          items.push({ word: words[w++ % words.length], tone, el, sprite: null, angle: (360 / sides) * s + (r % 2) * (180 / sides), z: r * gap + (s % 2) * gap * 0.5, anim: null, tf: '', op: '', shown: false });
        }
      }
    };

    build();
    layout();
    prepare();
    document.fonts?.ready.then(prepare);

    // Content above (hero, fonts, images) or below can move the section or
    // change the page's scroll length: re-sync either way.
    new ResizeObserver(() => {
      layout();
      refresh();
    }).observe(document.body);

    if (!timeline) {
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          if (visible) measure();
        },
        { rootMargin: '100px' },
      ).observe(section);
      addEventListener('scroll', () => visible && measure(), { passive: true });
    }

    let rt = 0;
    let builtW = innerWidth;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        // Phones fire resize whenever the toolbar shows or hides; the stage is
        // sized in svh, so only a real width change needs the words redone.
        if (innerWidth === builtW) return;
        builtW = innerWidth;
        build();
        layout();
        prepare();
      }, 200);
    });
  });
</script>
