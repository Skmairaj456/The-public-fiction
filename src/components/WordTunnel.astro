---
/**
 * A ribbon of words on a rolling drum that bends into a 3D tunnel and flies
 * toward the viewer as the page scrolls.
 * Words are placed on the inner wall of a cylinder (CSS 3D); a small script
 * moves them along the tunnel. Without JS or with reduced motion, the same
 * words render as a static, readable list.
 */
interface Props {
  words: string[];
  caption?: string;
}
const { words, caption = 'Six disciplines. One team.' } = Astro.props;
---

<section class="tun theme-dark" aria-label="What we do, in a word" data-tunnel>
  <div class="tun__sticky">
    <div class="tun__scene" aria-hidden="true">
      <div class="tun__tube" data-tube></div>
    </div>
    <p class="tun__center" data-tun-center>
      <span class="mega mega--s lime">{caption}</span>
    </p>
    <p class="tun__hint label label--caps label--muted" aria-hidden="true">[ Keep scrolling ]</p>
    <ul class="tun__fallback" data-tun-fallback>
      {words.map((w) => <li>{w}</li>)}
    </ul>
  </div>
  <template data-tun-words>{JSON.stringify(words)}</template>
</section>

<style>
  .tun {
    position: relative;
  }
  .tun__sticky {
    position: relative;
    overflow: hidden;
  }
  .tun__scene,
  .tun__center,
  .tun__hint {
    display: none;
  }
  .tun__fallback {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1em 0.5em;
    padding: var(--section) var(--gutter);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    font-size: clamp(1.8rem, 5vw, 4.4rem);
    line-height: 1;
    text-align: center;
  }
  .tun__fallback li:nth-child(3n + 2) {
    color: var(--lime);
  }
  .tun__fallback li:nth-child(3n) {
    color: var(--dim);
  }

  /* The real tunnel (JS + motion allowed) */
  :global(html.js:not(.reduce-motion)) .tun {
    height: 520vh;
  }
  :global(html.js:not(.reduce-motion)) .tun__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  :global(html.js:not(.reduce-motion)) .tun__fallback {
    display: none;
  }
  :global(html.js:not(.reduce-motion)) .tun__scene {
    display: block;
    position: absolute;
    inset: 0;
  }
  :global(html.js:not(.reduce-motion)) .tun__center,
  :global(html.js:not(.reduce-motion)) .tun__hint {
    display: block;
  }
  .tun__tube {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
  }
  .tun__tube :global(span) {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1;
    font-size: var(--tun-size, 64px);
    color: var(--paper);
    /* Pivot on the tunnel's axis, not each word's own centre, so long words
       don't drag the vanishing point off-centre. */
    transform-origin: 0 0;
    will-change: transform, opacity;
  }
  .tun__tube :global(span.is-dim) {
    color: #4a4d51;
  }
  .tun__tube :global(span.is-lime) {
    color: var(--lime);
  }
  .tun__center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(90vw, 900px);
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  .tun__center .mega--s {
    font-size: clamp(2.4rem, 6vw, 6rem);
  }
  .tun__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    text-align: center;
  }
</style>

<script>
  const reduce = document.documentElement.classList.contains('reduce-motion');

  document.querySelectorAll<HTMLElement>('[data-tunnel]').forEach((section) => {
    if (reduce) return;
    const tube = section.querySelector<HTMLElement>('[data-tube]')!;
    const center = section.querySelector<HTMLElement>('[data-tun-center]')!;
    const hint = section.querySelector<HTMLElement>('.tun__hint')!;
    const words: string[] = JSON.parse(section.querySelector('template')!.innerHTML);

    let items: { el: HTMLElement; angle: number; z: number; w: number }[] = [];
    let R = 0;
    let L = 0;
    const P = 520; // perspective distance, px

    const build = () => {
      tube.innerHTML = '';
      items = [];
      const small = innerWidth < 760;
      const sides = small ? 8 : 10;
      const rings = small ? 6 : 7;
      const gap = small ? 360 : 460;
      R = Math.min(innerWidth, innerHeight) * (small ? 0.62 : 0.5);
      L = rings * gap;
      section.style.setProperty('--tun-size', `${Math.round(R * (small ? 0.2 : 0.17))}px`);
      let w = 0;
      for (let r = 0; r < rings; r++) {
        for (let s = 0; s < sides; s++) {
          const el = document.createElement('span');
          el.textContent = words[w++ % words.length];
          const pick = (r * sides + s) % 7;
          if (pick === 2 || pick === 5) el.className = 'is-dim';
          else if (pick === 4) el.className = 'is-lime';
          tube.appendChild(el);
          // Stagger alternate sides so words never line up in rows.
          items.push({ el, angle: (360 / sides) * s + (r % 2) * (180 / sides), z: r * gap + (s % 2) * gap * 0.5, w: 0 });
        }
      }
      sizeWords();
    };
    // Each word's unscaled length, used to project both of its ends.
    const sizeWords = () => items.forEach((it) => (it.w = it.el.offsetWidth));

    let progress = 0;
    let visible = false;
    let ticking = false;

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (t: number) => t * t * (3 - 2 * t);

    const render = () => {
      ticking = false;
      // Three acts over the scroll:
      //  1. a flat ribbon of words wrapped around a horizontal drum, rolling up;
      //  2. the ribbon bends into the tunnel (each word glides from its line
      //     on the drum to its place on the tunnel wall);
      //  3. the tunnel flies, spins and drains, as before.
      const mRaw = clamp01((progress - 0.06) / 0.26);
      const q = clamp01((progress - 0.22) / 0.78);
      const travel = q * L * 1.55;
      const spin = q * 70;
      // The tunnel drains at the end: the far words go first and the near
      // ones last, so the walls empty out toward the viewer.
      const x = clamp01((q - 0.48) / 0.18);
      hint.style.opacity = String(1 - x);

      // The drum: lines of words stacked down the middle of the screen.
      const vh = innerHeight;
      const F = items[0]?.el.offsetHeight || 1;
      const lh = Math.min(vh * 0.085, innerWidth * 0.11);
      const k = (lh * 1.02) / F;
      const drumR = vh * 0.46;
      const rows = items.length;
      const roll = progress * lh * 9;

      items.forEach((it, i) => {
        // --- Act 3 pose: on the tunnel wall --------------------------------
        // Perspective is projected here rather than with CSS 3D, so the
        // tunnel renders the same in every browser (Safari drops words that
        // reach the camera plane). Each word lies along the tunnel wall: its
        // far end and near end are projected separately and the word is
        // stretched between them. A near end that reaches the camera is
        // pushed off-screen, so nothing ever streaks across the centre.
        const d = L - ((it.z + travel) % L);
        const z = -d + 260;
        const depth = P - z;
        let tx = 0;
        let ty = 0;
        let ta = 0;
        let tsx = k;
        let tsy = k;
        let top = 0;
        if (depth >= 40) {
          const fadeIn = Math.min(1, (L - d) / (L * 0.35));
          const fadeOut = clamp01((d - 60) / 340);
          const exit = clamp01(1 - x * (1 + 1.6 * (d / L)));
          top = Math.max(0, fadeIn * fadeOut * exit);
          const half = it.w / 2;
          const rFar = (R * P) / (depth + half);
          const rNear = (R * P) / Math.max(30, depth - half);
          const rc = (rFar + rNear) / 2;
          tsx = it.w ? (rNear - rFar) / it.w : 1;
          tsy = P / depth;
          const a = ((it.angle + spin) * Math.PI) / 180;
          tx = rc * Math.cos(a);
          ty = rc * Math.sin(a);
          ta = Math.atan2(Math.sin(a), Math.cos(a));
        }

        // --- Act 1 pose: a line on the drum --------------------------------
        let fy = (i - rows / 2) * lh - roll;
        const span = rows * lh;
        fy = ((((fy + span / 2) % span) + span) % span) - span / 2;
        const th = fy / drumR;
        const onFront = Math.abs(th) < Math.PI / 2;
        const c = onFront ? Math.cos(th) : 0;
        const fop = onFront ? Math.pow(c, 0.6) : 0;

        // --- Blend between the two ----------------------------------------
        // The ribbon peels into the tunnel from the top line down, so it
        // unwraps as one surface instead of every word moving at once.
        const band = clamp01((Math.max(-1.57, Math.min(1.57, th)) + 1.57) / 3.14);
        const m = smooth(clamp01(mRaw * 1.7 - band * 0.7));
        // Long words shrink to fit narrow screens while they sit on the drum.
        const kf = Math.min(k, it.w ? (innerWidth * 0.92) / it.w : k);
        const px = tx * m;
        const py = drumR * Math.sin(Math.max(-1.57, Math.min(1.57, th))) * (1 - m) + ty * m;
        const pa = ta * m;
        const psx = kf * (1 - m) + tsx * m;
        const psy = kf * c * (1 - m) + tsy * m;
        const op = fop * (1 - m) + top * m;
        it.el.style.opacity = op.toFixed(3);
        if (op < 0.002) return;
        it.el.style.transform = `translate3d(${px.toFixed(1)}px, ${py.toFixed(1)}px, 0) rotate(${pa.toFixed(4)}rad) scale(${psx.toFixed(3)}, ${Math.max(0.001, psy).toFixed(3)}) translate(-50%, -50%)`;
      });

      // Once the tunnel is empty, the caption travels down the same passage:
      // it emerges from the vanishing point, settles, then flies past the
      // viewer, leaving the centre clear for the next section.
      const cin = clamp01((q - 0.67) / 0.16);
      const cout = clamp01((q - 0.9) / 0.1);
      const grow = 1 - Math.pow(1 - cin, 3);
      const scale = (0.03 + 0.97 * grow) * (1 + cout * cout * 2.2);
      center.style.opacity = String(Math.min(1, cin * 3) * (1 - cout));
      center.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(4)})`;
    };

    const measure = () => {
      const rect = section.getBoundingClientRect();
      const total = section.offsetHeight - innerHeight;
      progress = Math.min(1, Math.max(0, -rect.top / total));
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };

    build();
    measure();
    document.fonts?.ready.then(() => {
      sizeWords();
      measure();
    });

    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { rootMargin: '100px' }).observe(section);
    addEventListener('scroll', () => visible && measure(), { passive: true });
    let rt = 0;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        build();
        measure();
      }, 200);
    });
  });
</script>
