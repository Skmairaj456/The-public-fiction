---
/**
 * Brand intro, shown once per browser session on the home page.
 * Skipped without JS, on repeat visits and for reduced-motion users.
 */
import Logo from './Logo.astro';
---

<script is:inline>
  (function () {
    try {
      var d = document.documentElement;
      if (d.classList.contains('reduce-motion') || sessionStorage.getItem('tpf-intro')) return;
      sessionStorage.setItem('tpf-intro', '1');
      d.classList.add('has-intro');
    } catch (e) {}
  })();
</script>

<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__logo"><Logo variant="ink" /></div>
</div>

<style>
  .intro {
    display: none;
  }
  :global(html.has-intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: grid;
    place-items: center;
    background: var(--lime);
    pointer-events: none;
    animation: intro-out 0.9s var(--ease-io) 1.3s forwards;
  }
  .intro__logo {
    --logo-size: clamp(40px, 7vw, 76px);
    animation: intro-pop 1s var(--spring) both;
  }
  @keyframes intro-pop {
    from {
      transform: scale(0.3) rotate(-14deg);
      opacity: 0;
    }
  }
  @keyframes intro-out {
    to {
      /* Slides up by transform (GPU) rather than a clip-path wipe, which
         repaints the whole screen every frame while the doodles start to
         fall. Hidden once it has lifted, so the full-screen layer doesn't
         stay composited over the page for the rest of the visit. */
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
</style>
