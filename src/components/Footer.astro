---
/**
 * Light footer: logo and short link columns, then a giant "Contact!" that
 * fills the width and leads to the contact page.
 */
import { nav, site, socialLinks } from '@/config/site';
import Logo from './Logo.astro';
import { services } from '@/data/services';

const socials = socialLinks();
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr__top">
    <a class="ftr__logo" href="/" aria-label={`${site.name} — home`}><Logo /></a>

    {
      socials.length > 0 && (
        <ul class="ftr__links" aria-label="Social">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <nav aria-label="Footer">
      <ul class="ftr__links">
        <li><a href="/">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="ftr__links" aria-label="Services">
      {
        services.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`}>{s.title}</a>
          </li>
        ))
      }
    </ul>

    <ul class="ftr__links" aria-label="Contact and legal">
      <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms</a></li>
    </ul>
  </div>

  <div class="wrap">
    <a class="ftr__big" href="/contact/" aria-label="Contact us">
      <span class="mega" data-fit aria-hidden="true">Contact!</span>
    </a>
  </div>

  <div class="wrap ftr__bottom">
    <span>© {year} {site.legal.entityName}</span>
    <a href="#top" data-scroll-top>Back to top ↑</a>
  </div>
</footer>

<style>
  .ftr {
    background: var(--paper-2);
    color: var(--ink);
    padding-top: clamp(40px, 5vw, 72px);
  }
  .ftr__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(24px, 4vw, 64px);
  }
  .ftr__logo {
    --logo-size: 23px;
    display: inline-flex;
    margin-right: clamp(0px, 2vw, 32px);
  }
  .ftr__links {
    display: grid;
    gap: 6px;
  }
  .ftr__links a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transition: color 0.25s;
  }
  .ftr__links a:hover {
    color: var(--stone);
  }
  .ftr__big {
    display: block;
    margin-top: clamp(40px, 7vw, 120px);
    transition: color 0.4s var(--ease);
  }
  .ftr__big .mega {
    display: block;
    line-height: 0.82;
    font-size: 20vw;
  }
  .ftr__big:hover {
    color: var(--stone);
  }
  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: clamp(18px, 2vw, 28px) clamp(22px, 2.6vw, 36px);
    font-size: 13px;
    font-weight: 500;
  }
  .ftr__bottom a:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .ftr__top {
      flex-direction: column;
      gap: 22px;
    }
    .ftr__links a {
      min-height: 32px;
    }
  }
</style>
