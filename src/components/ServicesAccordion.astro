---
import { Picture } from 'astro:assets';
import { services } from '@/data/services';
import Arrow from './Arrow.astro';
---

<div class="svc grid" data-svc>
  <ol class="svc__list">
    {
      services.map((s, i) => (
        <li class="svc__row" id={s.slug} data-reveal style={`--d:${i * 60}`}>
          <h3>
            <button
              class="svc__btn"
              type="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`svc-panel-${s.slug}`}
              id={`svc-btn-${s.slug}`}
              data-svc-btn
              data-index={i}
            >
              <span class="svc__num label">{s.number}</span>
              <span class="svc__title display-m">{s.title}</span>
              <span class="svc__icon" aria-hidden="true" />
            </button>
          </h3>
          <div class="svc__panel" id={`svc-panel-${s.slug}`} role="region" aria-labelledby={`svc-btn-${s.slug}`} data-open={i === 0 ? 'true' : 'false'}>
            <div class="svc__panel-in">
              <div class="svc__body">
                <p class="svc__line serif">{s.line}</p>
                <p class="svc__desc">{s.description}</p>
                <ul class="svc__items" aria-label={`${s.title} services`}>
                  {s.items.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
                <a class="arrow-link label svc__cta ulink" href={`/contact/?service=${s.slug}`}>
                  Start a project like this <Arrow class="" />
                </a>
              </div>
              <div class="svc__media-m media">
                <Picture src={s.image} alt={s.imageAlt} widths={[480, 800]} sizes="100vw" formats={['avif', 'webp']} />
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="svc__stage" aria-hidden="true">
    <div class="svc__frame">
      {
        services.map((s, i) => (
          <div class="svc__slide media" data-svc-slide data-active={i === 0 ? 'true' : 'false'}>
            <Picture src={s.image} alt="" widths={[600, 900, 1200]} sizes="38vw" formats={['avif', 'webp']} />
          </div>
        ))
      }
    </div>
    <p class="svc__caption label label--muted">
      {services.map((s, i) => <span data-svc-cap data-active={i === 0 ? 'true' : 'false'}>{s.number} / {s.title}</span>)}
    </p>
  </div>
</div>

<style>
  .svc {
    align-items: start;
  }
  .svc__list {
    grid-column: 1 / span 7;
    border-top: 1px solid var(--line);
  }
  .svc__row {
    border-bottom: 1px solid var(--line);
  }
  .svc__btn {
    width: 100%;
    display: grid;
    grid-template-columns: 56px 1fr 40px;
    align-items: center;
    gap: 12px;
    padding: clamp(18px, 2.2vw, 30px) 0;
    text-align: left;
    transition: color 0.3s;
  }
  .svc__btn:hover,
  .svc__btn[aria-expanded='true'] {
    color: var(--signal);
  }
  .svc__num {
    align-self: start;
    padding-top: 0.6em;
    color: var(--muted);
  }
  .svc__title {
    font-size: clamp(1.7rem, 3.6vw, 3.9rem);
  }
  .svc__icon {
    position: relative;
    width: 22px;
    height: 22px;
    justify-self: end;
  }
  .svc__icon::before,
  .svc__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  .svc__icon::after {
    transform: rotate(90deg);
  }
  .svc__btn[aria-expanded='true'] .svc__icon::after {
    transform: rotate(0deg);
  }

  .svc__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s var(--ease);
  }
  .svc__panel[data-open='true'],
  :global(html.no-js) .svc__panel {
    grid-template-rows: 1fr;
  }
  .svc__panel-in {
    overflow: hidden;
    min-height: 0;
  }
  .svc__body {
    padding: 0 0 clamp(28px, 3vw, 44px) 68px;
    max-width: 640px;
  }
  .svc__line {
    font-size: clamp(1.5rem, 2.3vw, 2.3rem);
    line-height: 1.1;
    margin-bottom: 14px;
  }
  .svc__desc {
    color: var(--muted);
    max-width: 52ch;
  }
  .svc__items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 26px;
  }
  .svc__cta {
    color: var(--fg);
  }
  .svc__media-m {
    display: none;
  }

  .svc__stage {
    grid-column: 9 / span 4;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .svc__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .svc__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 1s var(--ease-io),
      opacity 0s 1s;
  }
  .svc__slide[data-active='true'] {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    z-index: 1;
    transition:
      clip-path 1s var(--ease-io),
      opacity 0s;
  }
  .svc__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc__caption {
    position: relative;
    height: 1.4em;
    margin-top: 12px;
    overflow: hidden;
  }
  .svc__caption span {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
    transition: transform 0.6s var(--ease);
  }
  .svc__caption span[data-active='true'] {
    transform: none;
  }

  @media (max-width: 960px) {
    .svc__list {
      grid-column: 1 / -1;
    }
    .svc__stage {
      display: none;
    }
    .svc__btn {
      grid-template-columns: 40px 1fr 28px;
    }
    .svc__body {
      padding-left: 0;
    }
    .svc__media-m {
      display: block;
      aspect-ratio: 16 / 10;
      margin-bottom: 28px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-svc-btn]'));
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-slide]'));
    const caps = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-cap]'));

    const show = (index: number) => {
      slides.forEach((s, i) => (s.dataset.active = String(i === index)));
      caps.forEach((c, i) => (c.dataset.active = String(i === index)));
    };

    const toggle = (btn: HTMLButtonElement, open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(btn.getAttribute('aria-controls')!);
      if (panel) panel.dataset.open = String(open);
    };

    buttons.forEach((btn) => {
      const index = Number(btn.dataset.index);
      btn.addEventListener('click', () => {
        const willOpen = btn.getAttribute('aria-expanded') !== 'true';
        buttons.forEach((b) => b !== btn && toggle(b, false));
        toggle(btn, willOpen);
        if (willOpen) show(index);
      });
      btn.addEventListener('pointerenter', () => show(index));
      btn.addEventListener('focus', () => show(index));
    });

    // Deep links such as /services/#photography-film open the matching row.
    const target = location.hash && root.querySelector<HTMLElement>(location.hash);
    if (target) {
      const btn = target.querySelector<HTMLButtonElement>('[data-svc-btn]');
      if (btn) {
        buttons.forEach((b) => toggle(b, b === btn));
        show(Number(btn.dataset.index));
      }
    }
  });
</script>
