---
import { site, socialLinks } from '@/config/site';
import SectionHead from './SectionHead.astro';
import ContactForm from './ContactForm.astro';
import Sticker from './Sticker.astro';
import { realCity } from '@/data/real-content';

interface Props {
  number?: string;
  /** Use the h1 level when this is the page's main heading. */
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel: H = 'h2' } = Astro.props;
const city = realCity();
const socials = socialLinks();
---

<section class="section contact theme-dark" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <SectionHead label="Start a project" aside="Have an idea? Good." />
    <H id="contact-title" class="contact__title" data-split aria-label="Let's talk! Let's make something worth talking about.">
      <span class="lm" aria-hidden="true"><span class="mega" style="--i:0">Let’s <span class="lime">talk!</span></span></span>
      <span class="lm" aria-hidden="true"><span class="h-m contact__sub" style="--i:1">Let’s make something worth talking about.</span></span>
    </H>
    <Sticker name="megaphone" class="contact__stk" data-pop />

    <div class="contact__body">
      <aside class="contact__aside" data-reveal>
        <p class="lede">Have a brand to build, a campaign to launch or an idea that deserves to exist? Let’s talk.</p>

        <a class="contact__card contact__card--lime" href={`mailto:${site.contact.email}`}>
          <span class="label label--caps">Email us</span>
          <span class="contact__email">{site.contact.email}</span>
        </a>

        {
          (site.contact.phone || city || socials.length > 0) && (
            <dl class="contact__card">
              {site.contact.phone && (
                <div>
                  <dt class="label label--caps label--muted">Phone</dt>
                  <dd>
                    <a class="ulink" href={`tel:${site.contact.phone.replace(/\s+/g, '')}`}>{site.contact.phone}</a>
                  </dd>
                </div>
              )}
              {city && (
                <div>
                  <dt class="label label--caps label--muted">Studio</dt>
                  <dd>{city}</dd>
                </div>
              )}
              {socials.length > 0 && (
                <div>
                  <dt class="label label--caps label--muted">Elsewhere</dt>
                  <dd class="contact__social">
                    {socials.map((s) => (
                      <a class="ulink" href={s.href} target="_blank" rel="noopener noreferrer">
                        {s.label}
                      </a>
                    ))}
                  </dd>
                </div>
              )}
            </dl>
          )
        }

        <ol class="contact__next">
          <li><span>01</span> We read your brief and reply personally.</li>
          <li><span>02</span> A short call to understand the ambition.</li>
          <li><span>03</span> A clear proposal: approach, timeline, cost.</li>
        </ol>
      </aside>

      <div class="contact__form" data-reveal style="--d:120">
        <ContactForm />
      </div>
    </div>
  </div>
</section>

<style>
  .contact .wrap {
    position: relative;
  }
  .contact__title .mega {
    display: block;
    white-space: normal;
  }
  .contact__sub {
    display: block;
    margin-top: 0.4em;
    text-transform: none;
    letter-spacing: -0.04em;
  }
  .contact :global(.contact__stk) {
    position: absolute;
    right: calc(var(--gutter) + 2%);
    top: 90px;
    width: clamp(90px, 13vw, 190px);
    --r: -12deg;
  }
  :global(html.js:not(.reduce-motion)) .contact :global(.contact__stk.is-in) {
    animation: bob 4.8s ease-in-out infinite;
  }
  .contact__body {
    margin-top: clamp(40px, 5vw, 80px);
    display: grid;
    grid-template-columns: 4fr 7fr;
    gap: clamp(32px, 4vw, 72px);
    align-items: start;
  }
  .contact__aside {
    display: grid;
    gap: 18px;
  }
  .contact__card {
    display: grid;
    gap: 14px;
    padding: 22px 24px;
    border-radius: var(--radius);
    background: var(--card);
  }
  .contact__card dd {
    margin-top: 4px;
    font-weight: 600;
  }
  .contact__card--lime {
    background: var(--lime);
    color: var(--ink);
    gap: 6px;
    transition: transform 0.45s var(--spring);
  }
  .contact__card--lime:hover {
    transform: rotate(-1.5deg) scale(1.02);
  }
  .contact__email {
    font-weight: 800;
    font-size: clamp(1.15rem, 1.6vw, 1.6rem);
    letter-spacing: -0.03em;
    word-break: break-word;
  }
  .contact__social {
    display: flex;
    gap: 18px;
  }
  .contact__next {
    display: grid;
    gap: 12px;
    margin-top: 10px;
    color: var(--muted);
  }
  .contact__next li {
    display: flex;
    gap: 14px;
  }
  .contact__next span {
    color: var(--lime);
    font-weight: 800;
    font-size: 13px;
    padding-top: 0.2em;
  }
  .contact__form {
    padding: clamp(22px, 3vw, 44px);
    border-radius: var(--radius-l);
    background: var(--char);
  }
  @media (max-width: 1000px) {
    .contact__body {
      grid-template-columns: 1fr;
    }
    .contact :global(.contact__stk) {
      top: 40px;
    }
  }
  @media (max-width: 640px) {
    .contact :global(.contact__stk) {
      display: none;
    }
  }
</style>
